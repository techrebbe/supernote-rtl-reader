<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.techrebbe.supernote.layoutfencetrial"
    android:versionCode="1" android:versionName="0.1-synthetic-only">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="30" />
    <!-- Separate emulator-only process; no storage, network, pen or overlay permissions. -->
    <application android:allowBackup="false" android:usesCleartextTraffic="false"
        android:label="Disposable Layout Fence Trial"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".TrialActivity" android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".TrialProvider" android:exported="true"
            android:authorities="com.techrebbe.supernote.layoutfencetrial.probe" />
    </application>
</manifest>
