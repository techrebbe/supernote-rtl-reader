<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.techrebbe.supernote.nativepagehost"
    android:versionCode="2" android:versionName="0.0.2-native-page-visual-only">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="30" />
    <!-- No storage, network, root, input-injection, accessibility, or LSPosed permissions/hooks. -->
    <application android:allowBackup="false" android:usesCleartextTraffic="false"
        android:label="Native Page Host - Visual Only" android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".NativePageHostActivity" android:exported="true"
            android:launchMode="singleTask" android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
