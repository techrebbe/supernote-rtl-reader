package __PACKAGE__

import android.graphics.Bitmap
import android.graphics.Canvas
import android.graphics.Color
import android.graphics.Paint
import android.graphics.RectF
import android.graphics.pdf.PdfRenderer
import android.os.ParcelFileDescriptor
import android.os.SystemClock
import android.util.Log
import android.view.View
import com.facebook.react.bridge.Arguments
import com.facebook.react.uimanager.ThemedReactContext
import com.facebook.react.uimanager.events.RCTEventEmitter
import java.io.File
import java.util.LinkedHashMap
import java.util.concurrent.ConcurrentHashMap
import java.util.concurrent.Executors
import java.util.concurrent.TimeUnit
import java.util.concurrent.atomic.AtomicLong
import java.util.concurrent.locks.ReentrantLock
import kotlin.math.max
import kotlin.math.min
import kotlin.math.roundToInt

private data class RenderKey(
    val canonicalPath: String,
    val length: Long,
    val modified: Long,
    val pageIndex: Int,
    val requestedWidth: Int,
)

private data class CachedBitmap(
    val bitmap: Bitmap,
    val pageCount: Int,
)

private data class DirectRenderResult(
    val bitmap: Bitmap,
    val pageCount: Int,
    val reusedRenderer: Boolean,
    val cacheHit: Boolean,
    val openMs: Long,
    val renderMs: Long,
    val totalMs: Long,
)

private data class PendingRenderedEvent(
    val generation: Long,
    val filePath: String,
    val pageIndex: Int,
    val requestedWidth: Int,
    val prefetchPageIndexes: List<Int>,
    val requestStartedAtMs: Double,
    val result: DirectRenderResult,
)

private object PdfDirectRenderEngine {
    private const val LOG_TAG = "RTL_READER"
    private const val CACHE_LIMIT = 4

    private val rendererLock = ReentrantLock(true)
    private val cacheLock = Any()
    private val prefetchExecutor = Executors.newSingleThreadExecutor { runnable ->
        Thread(runnable, "rtl-reader-direct-prefetch").apply { isDaemon = true }
    }
    private val pendingPrefetch = ConcurrentHashMap.newKeySet<RenderKey>()
    private val bitmapCache = LinkedHashMap<RenderKey, CachedBitmap>(8, 0.75f, true)

    private var activePath: String? = null
    private var activeLength: Long = -1L
    private var activeModified: Long = -1L
    private var activeDescriptor: ParcelFileDescriptor? = null
    private var activeRenderer: PdfRenderer? = null

    private fun recycleCached(entry: CachedBitmap?) {
        val bitmap = entry?.bitmap ?: return
        if (!bitmap.isRecycled) bitmap.recycle()
    }

    private fun clearCache() {
        synchronized(cacheLock) {
            bitmapCache.values.forEach(::recycleCached)
            bitmapCache.clear()
        }
        pendingPrefetch.clear()
    }

    private fun takeCached(key: RenderKey): CachedBitmap? =
        synchronized(cacheLock) {
            bitmapCache.remove(key)
        }

    private fun hasCached(key: RenderKey): Boolean =
        synchronized(cacheLock) {
            bitmapCache.containsKey(key)
        }

    private fun putCached(key: RenderKey, entry: CachedBitmap) {
        synchronized(cacheLock) {
            recycleCached(bitmapCache.remove(key))
            bitmapCache[key] = entry
            while (bitmapCache.size > CACHE_LIMIT) {
                val eldestKey = bitmapCache.entries.iterator().next().key
                recycleCached(bitmapCache.remove(eldestKey))
            }
        }
    }

    private fun makeKey(filePath: String, pageIndex: Int, requestedWidth: Int): Pair<File, RenderKey> {
        val file = File(filePath)
        if (!file.exists() || !file.isFile) {
            throw IllegalArgumentException("PDF file is not accessible: $filePath")
        }
        if (pageIndex < 0) {
            throw IllegalArgumentException("Invalid PDF page index: $pageIndex")
        }
        val canonicalPath = file.canonicalPath
        return Pair(
            file,
            RenderKey(
                canonicalPath = canonicalPath,
                length = file.length(),
                modified = file.lastModified(),
                pageIndex = pageIndex,
                requestedWidth = requestedWidth.coerceIn(320, 2200),
            ),
        )
    }

    private fun closeRendererLocked() {
        try {
            activeRenderer?.close()
        } catch (_: Throwable) {
        }
        activeRenderer = null

        try {
            activeDescriptor?.close()
        } catch (_: Throwable) {
        }
        activeDescriptor = null

        activePath = null
        activeLength = -1L
        activeModified = -1L
    }

    private fun ensureRendererLocked(file: File, key: RenderKey): Pair<PdfRenderer, Boolean> {
        val existing = activeRenderer
        val canReuse =
            existing != null &&
                activePath == key.canonicalPath &&
                activeLength == key.length &&
                activeModified == key.modified

        if (canReuse) {
            return Pair(existing!!, true)
        }

        closeRendererLocked()
        clearCache()

        val descriptor = ParcelFileDescriptor.open(file, ParcelFileDescriptor.MODE_READ_ONLY)
        val renderer = try {
            PdfRenderer(descriptor)
        } catch (error: Throwable) {
            try {
                descriptor.close()
            } catch (_: Throwable) {
            }
            throw error
        }

        activePath = key.canonicalPath
        activeLength = key.length
        activeModified = key.modified
        activeDescriptor = descriptor
        activeRenderer = renderer

        Log.i(
            LOG_TAG,
            "RTL_READER_NATIVE_VIEW_RENDERER_OPEN path=${key.canonicalPath} pages=${renderer.pageCount}",
        )
        return Pair(renderer, false)
    }

    private fun renderLocked(
        file: File,
        key: RenderKey,
        totalStarted: Long,
    ): DirectRenderResult {
        val openStarted = SystemClock.elapsedRealtime()
        val (renderer, reusedRenderer) = ensureRendererLocked(file, key)
        val openMs = SystemClock.elapsedRealtime() - openStarted

        if (key.pageIndex >= renderer.pageCount) {
            throw IllegalArgumentException(
                "PDF page ${key.pageIndex + 1} is outside the document (${renderer.pageCount} pages).",
            )
        }

        var page: PdfRenderer.Page? = null
        var bitmap: Bitmap? = null
        try {
            page = renderer.openPage(key.pageIndex)
            val height = max(
                1,
                (key.requestedWidth.toDouble() * page.height.toDouble() / page.width.toDouble()).roundToInt(),
            )

            bitmap = Bitmap.createBitmap(key.requestedWidth, height, Bitmap.Config.ARGB_8888)
            bitmap.eraseColor(Color.WHITE)

            val renderStarted = SystemClock.elapsedRealtime()
            page.render(
                bitmap,
                null,
                null,
                PdfRenderer.Page.RENDER_MODE_FOR_DISPLAY,
            )
            val renderMs = SystemClock.elapsedRealtime() - renderStarted
            val totalMs = SystemClock.elapsedRealtime() - totalStarted

            val result = DirectRenderResult(
                bitmap = bitmap,
                pageCount = renderer.pageCount,
                reusedRenderer = reusedRenderer,
                cacheHit = false,
                openMs = openMs,
                renderMs = renderMs,
                totalMs = totalMs,
            )
            bitmap = null
            return result
        } finally {
            bitmap?.recycle()
            try {
                page?.close()
            } catch (_: Throwable) {
            }
        }
    }

    fun renderForeground(filePath: String, pageIndex: Int, requestedWidth: Int): DirectRenderResult {
        val totalStarted = SystemClock.elapsedRealtime()
        val (file, key) = makeKey(filePath, pageIndex, requestedWidth)

        takeCached(key)?.let { cached ->
            val totalMs = SystemClock.elapsedRealtime() - totalStarted
            Log.i(
                LOG_TAG,
                "RTL_READER_NATIVE_VIEW_RENDER page=${pageIndex + 1} reused=true cacheHit=true " +
                    "openMs=0 renderMs=0 pngMs=0 base64Ms=0 totalMs=$totalMs",
            )
            return DirectRenderResult(
                bitmap = cached.bitmap,
                pageCount = cached.pageCount,
                reusedRenderer = true,
                cacheHit = true,
                openMs = 0L,
                renderMs = 0L,
                totalMs = totalMs,
            )
        }

        rendererLock.lock()
        try {
            takeCached(key)?.let { cached ->
                val totalMs = SystemClock.elapsedRealtime() - totalStarted
                Log.i(
                    LOG_TAG,
                    "RTL_READER_NATIVE_VIEW_RENDER page=${pageIndex + 1} reused=true cacheHit=true " +
                        "openMs=0 renderMs=0 pngMs=0 base64Ms=0 totalMs=$totalMs",
                )
                return DirectRenderResult(
                    bitmap = cached.bitmap,
                    pageCount = cached.pageCount,
                    reusedRenderer = true,
                    cacheHit = true,
                    openMs = 0L,
                    renderMs = 0L,
                    totalMs = totalMs,
                )
            }

            val result = renderLocked(file, key, totalStarted)
            Log.i(
                LOG_TAG,
                "RTL_READER_NATIVE_VIEW_RENDER page=${pageIndex + 1} reused=${result.reusedRenderer} cacheHit=false " +
                    "openMs=${result.openMs} renderMs=${result.renderMs} pngMs=0 base64Ms=0 totalMs=${result.totalMs}",
            )
            return result
        } finally {
            rendererLock.unlock()
        }
    }

    fun schedulePrefetch(filePath: String, pageIndexes: List<Int>, requestedWidth: Int) {
        pageIndexes.distinct().filter { it >= 0 }.forEach { pageIndex ->
            val pair = try {
                makeKey(filePath, pageIndex, requestedWidth)
            } catch (_: Throwable) {
                return@forEach
            }
            val file = pair.first
            val key = pair.second
            if (hasCached(key) || !pendingPrefetch.add(key)) return@forEach

            prefetchExecutor.execute {
                try {
                    if (hasCached(key)) return@execute
                    val totalStarted = SystemClock.elapsedRealtime()
                    rendererLock.lock()
                    try {
                        if (hasCached(key)) return@execute
                        val result = renderLocked(file, key, totalStarted)
                        putCached(
                            key,
                            CachedBitmap(
                                bitmap = result.bitmap,
                                pageCount = result.pageCount,
                            ),
                        )
                        Log.i(
                            LOG_TAG,
                            "RTL_READER_NATIVE_VIEW_PREFETCH page=${pageIndex + 1} reused=${result.reusedRenderer} " +
                                "openMs=${result.openMs} renderMs=${result.renderMs} totalMs=${result.totalMs}",
                        )
                    } finally {
                        rendererLock.unlock()
                    }
                } catch (error: Throwable) {
                    Log.w(
                        LOG_TAG,
                        "RTL_READER_NATIVE_VIEW_PREFETCH_FAILED page=${pageIndex + 1}",
                        error,
                    )
                } finally {
                    pendingPrefetch.remove(key)
                }
            }
        }
    }
}

class PdfPageView(
    private val reactContext: ThemedReactContext,
) : View(reactContext) {

    companion object {
        private const val EVENT_RENDERED = "topPdfRendered"
        private const val EVENT_ERROR = "topPdfError"
        private const val PREFETCH_DELAY_MS = 50L

        private val foregroundExecutor = Executors.newSingleThreadExecutor { runnable ->
            Thread(runnable, "rtl-reader-direct-foreground").apply { isDaemon = true }
        }
        private val prefetchDelayExecutor = Executors.newSingleThreadScheduledExecutor { runnable ->
            Thread(runnable, "rtl-reader-prefetch-delay").apply { isDaemon = true }
        }
    }

    var pendingFilePath: String? = null
    var pendingPageIndex: Int = -1
    var pendingRequestedWidth: Int = 0
    var pendingPrefetchPageIndexes: List<Int> = emptyList()
    var pendingRequestStartedAtMs: Double = 0.0

    private val renderGeneration = AtomicLong(0L)
    private val bitmapPaint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.FILTER_BITMAP_FLAG)
    private var committedSignature: String? = null
    private var pageBitmap: Bitmap? = null
    private var pendingRenderedEvent: PendingRenderedEvent? = null

    init {
        setWillNotDraw(false)
        setBackgroundColor(Color.WHITE)
    }

    fun commitProps() {
        val filePath = pendingFilePath
        val pageIndex = pendingPageIndex
        val requestedWidth = pendingRequestedWidth
        val prefetchPages = pendingPrefetchPageIndexes.distinct()
        val requestStartedAtMs = pendingRequestStartedAtMs
        val signature = "$filePath|$pageIndex|$requestedWidth|${prefetchPages.joinToString(",")}" 
        if (signature == committedSignature) return
        committedSignature = signature

        val generation = renderGeneration.incrementAndGet()
        pendingRenderedEvent = null
        if (filePath.isNullOrBlank() || pageIndex < 0 || requestedWidth <= 0) {
            replaceBitmap(null)
            invalidate()
            return
        }

        foregroundExecutor.execute {
            if (generation != renderGeneration.get()) return@execute
            try {
                val result = PdfDirectRenderEngine.renderForeground(filePath, pageIndex, requestedWidth)
                post {
                    if (generation != renderGeneration.get()) {
                        result.bitmap.recycle()
                        return@post
                    }

                    replaceBitmap(result.bitmap)
                    pendingRenderedEvent = PendingRenderedEvent(
                        generation = generation,
                        filePath = filePath,
                        pageIndex = pageIndex,
                        requestedWidth = requestedWidth,
                        prefetchPageIndexes = prefetchPages,
                        requestStartedAtMs = requestStartedAtMs,
                        result = result,
                    )
                    invalidate()
                }
            } catch (error: Throwable) {
                Log.e(
                    "RTL_READER",
                    "RTL_READER_NATIVE_VIEW_FAILED page=${pageIndex + 1}",
                    error,
                )
                post {
                    if (generation != renderGeneration.get()) return@post
                    val event = Arguments.createMap().apply {
                        putInt("pageIndex", pageIndex)
                        putString("message", error.message ?: error.toString())
                    }
                    reactContext
                        .getJSModule(RCTEventEmitter::class.java)
                        .receiveEvent(id, EVENT_ERROR, event)
                }
            }
        }
    }

    fun dispose() {
        renderGeneration.incrementAndGet()
        committedSignature = null
        pendingRenderedEvent = null
        replaceBitmap(null)
    }

    private fun replaceBitmap(next: Bitmap?) {
        val previous = pageBitmap
        pageBitmap = next
        if (previous != null && previous !== next && !previous.isRecycled) {
            previous.recycle()
        }
    }

    private fun emitRenderedAfterDraw(pending: PendingRenderedEvent) {
        val interactionMs =
            if (pending.requestStartedAtMs > 0.0) {
                max(0L, System.currentTimeMillis() - pending.requestStartedAtMs.toLong())
            } else {
                -1L
            }

        Log.i(
            "RTL_READER",
            "RTL_READER_NATIVE_VIEW_DISPLAY page=${pending.pageIndex + 1} cacheHit=${pending.result.cacheHit} " +
                "interactionMs=${if (interactionMs >= 0L) interactionMs else "none"} nativeMs=${pending.result.totalMs}",
        )

        val event = Arguments.createMap().apply {
            putInt("pageIndex", pending.pageIndex)
            putInt("pageCount", pending.result.pageCount)
            putBoolean("reusedRenderer", pending.result.reusedRenderer)
            putBoolean("cacheHit", pending.result.cacheHit)
            putDouble("openMs", pending.result.openMs.toDouble())
            putDouble("renderMs", pending.result.renderMs.toDouble())
            putDouble("totalMs", pending.result.totalMs.toDouble())
            putDouble("interactionMs", interactionMs.toDouble())
        }
        reactContext
            .getJSModule(RCTEventEmitter::class.java)
            .receiveEvent(id, EVENT_RENDERED, event)

        if (pending.prefetchPageIndexes.isNotEmpty()) {
            prefetchDelayExecutor.schedule(
                {
                    if (pending.generation == renderGeneration.get()) {
                        PdfDirectRenderEngine.schedulePrefetch(
                            pending.filePath,
                            pending.prefetchPageIndexes,
                            pending.requestedWidth,
                        )
                    }
                },
                PREFETCH_DELAY_MS,
                TimeUnit.MILLISECONDS,
            )
        }
    }

    override fun onDraw(canvas: Canvas) {
        super.onDraw(canvas)
        val bitmap = pageBitmap ?: return
        if (bitmap.isRecycled || width <= 0 || height <= 0) return

        val scale = min(
            width.toFloat() / bitmap.width.toFloat(),
            height.toFloat() / bitmap.height.toFloat(),
        )
        val drawWidth = bitmap.width * scale
        val drawHeight = bitmap.height * scale
        val left = (width - drawWidth) / 2f
        val top = (height - drawHeight) / 2f
        val destination = RectF(left, top, left + drawWidth, top + drawHeight)
        canvas.drawBitmap(bitmap, null, destination, bitmapPaint)

        val pending = pendingRenderedEvent
        if (pending != null && pending.generation == renderGeneration.get()) {
            pendingRenderedEvent = null
            emitRenderedAfterDraw(pending)
        }
    }

    override fun onDetachedFromWindow() {
        dispose()
        super.onDetachedFromWindow()
    }
}
