private data class RenderKey(
    val canonicalPath: String,
    val length: Long,
    val modified: Long,
    val pageIndex: Int,
    val requestedWidth: Int,
)

private data class CachedBitmap(
    val bitmap: Bitmap,
    val pageCount: Int,
    val trimmingRect: RectF?,
)

private data class DirectRenderResult(
    val bitmap: Bitmap,
    val key: RenderKey,
    val pageCount: Int,
    val reusedRenderer: Boolean,
    val cacheHit: Boolean,
    val openMs: Long,
    val renderMs: Long,
    val totalMs: Long,
    val trimmingRect: RectF?,
)

private data class PendingRenderedEvent(
    val generation: Long,
    val filePath: String,
    val pageIndex: Int,
    val requestedWidth: Int,
    val prefetchPageIndexes: List<Int>,
    val requestStartedAtMs: Double,
    val result: DirectRenderResult,
)

private data class VisibleBitmapMetadata(
    val key: RenderKey,
    val pageCount: Int,
    val trimmingRect: RectF?,
)

private object NativeFillTrimming {
    private const val LOG_TAG = "RTL_READER"
    private const val PORTRAIT_REFERENCE_WIDTH = 1404f
    private const val PORTRAIT_REFERENCE_HEIGHT = 1872f
    private const val NATIVE_PADDING_PX = 7f
    private const val WHITE_THRESHOLD = 250

    private val methodLock = Any()

    @Volatile
    private var methodResolved = false

    @Volatile
    private var methodDisabled = false

    @Volatile
    private var getMatNone0Area: java.lang.reflect.Method? = null

    private fun resolveNativeMethod(): java.lang.reflect.Method? {
        if (methodResolved) return getMatNone0Area
        synchronized(methodLock) {
            if (!methodResolved) {
                getMatNone0Area = try {
                    Class.forName(
                        "com.example.libsupernote.SuperNoteNote",
                        true,
                        NativeFillTrimming::class.java.classLoader,
                    ).getMethod("getMatNone0Area", Bitmap::class.java)
                } catch (_: Throwable) {
                    null
                }
                methodResolved = true
                Log.i(
                    LOG_TAG,
                    "RTL_READER_NATIVE_FILL_TRIM_NATIVE available=${getMatNone0Area != null}",
                )
            }
        }
        return getMatNone0Area
    }

    private fun nativeContentBounds(bitmap: Bitmap): RectF? {
        if (methodDisabled) return null
        val method = resolveNativeMethod() ?: return null
        return try {
            val rect = method.invoke(null, bitmap) ?: return null
            val type = rect.javaClass
            val left = (type.getMethod("get_x").invoke(rect) as Number).toFloat()
            val top = (type.getMethod("get_y").invoke(rect) as Number).toFloat()
            val width = (type.getMethod("get_width").invoke(rect) as Number).toFloat()
            val height = (type.getMethod("get_height").invoke(rect) as Number).toFloat()
            RectF(left, top, left + width, top + height)
        } catch (error: Throwable) {
            methodDisabled = true
            Log.w(LOG_TAG, "RTL_READER_NATIVE_FILL_TRIM_NATIVE_FAILED", error)
            null
        }
    }

    private fun isContentPixel(pixel: Int): Boolean {
        val alpha = pixel ushr 24 and 0xff
        if (alpha == 0) return false
        val red = pixel ushr 16 and 0xff
        val green = pixel ushr 8 and 0xff
        val blue = pixel and 0xff
        return red < WHITE_THRESHOLD || green < WHITE_THRESHOLD || blue < WHITE_THRESHOLD
    }

    private fun fallbackContentBounds(bitmap: Bitmap): RectF {
        val bitmapWidth = bitmap.width
        val bitmapHeight = bitmap.height
        val row = IntArray(bitmapWidth)

        fun rowContainsContent(y: Int): Boolean {
            bitmap.getPixels(row, 0, bitmapWidth, 0, y, bitmapWidth, 1)
            return row.any(::isContentPixel)
        }

        var top = 0
        while (top < bitmapHeight && !rowContainsContent(top)) top++
        if (top >= bitmapHeight) {
            return RectF(0f, 0f, bitmapWidth.toFloat(), bitmapHeight.toFloat())
        }

        var bottom = bitmapHeight - 1
        while (bottom > top && !rowContainsContent(bottom)) bottom--

        val column = IntArray(bitmapHeight)
        fun columnContainsContent(x: Int): Boolean {
            bitmap.getPixels(column, 0, 1, x, 0, 1, bitmapHeight)
            return column.any(::isContentPixel)
        }

        var left = 0
        while (left < bitmapWidth && !columnContainsContent(left)) left++
        var right = bitmapWidth - 1
        while (right > left && !columnContainsContent(right)) right--

        return RectF(
            left.toFloat(),
            top.toFloat(),
            (right + 1).toFloat(),
            (bottom + 1).toFloat(),
        )
    }

    fun detect(bitmap: Bitmap): RectF? {
        if (bitmap.isRecycled || bitmap.width <= 1 || bitmap.height <= 1) return null
        val raw = nativeContentBounds(bitmap) ?: fallbackContentBounds(bitmap)
        if (raw.width() <= 1f || raw.height() <= 1f) return null

        val referenceWidth =
            if (bitmap.width > bitmap.height) PORTRAIT_REFERENCE_HEIGHT
            else PORTRAIT_REFERENCE_WIDTH
        val referenceHeight =
            if (bitmap.width > bitmap.height) PORTRAIT_REFERENCE_WIDTH
            else PORTRAIT_REFERENCE_HEIGHT
        val renderedScale = min(
            bitmap.width / referenceWidth,
            bitmap.height / referenceHeight,
        )
        val padding = max(1f, NATIVE_PADDING_PX * renderedScale)
        val padded = RectF(
            max(0f, raw.left - padding),
            max(0f, raw.top - padding),
            min(bitmap.width.toFloat(), raw.right + padding),
            min(bitmap.height.toFloat(), raw.bottom + padding),
        )
        return if (padded.width() > 1f && padded.height() > 1f) padded else null
    }
}

private object PdfDirectRenderEngine {
    private const val LOG_TAG = "RTL_READER"
    private const val CACHE_LIMIT = 4

    private val rendererLock = ReentrantLock()
    private val cacheLock = Any()
    private val prefetchExecutor = Executors.newSingleThreadExecutor { runnable ->
        Thread(runnable, "rtl-reader-direct-prefetch").apply { isDaemon = true }
    }
    private val pendingPrefetch = ConcurrentHashMap.newKeySet<RenderKey>()
    private val activePrefetch = ConcurrentHashMap.newKeySet<RenderKey>()
    private val foregroundDemand = AtomicInteger(0)
    private val bitmapCache = LinkedHashMap<RenderKey, CachedBitmap>(8, 0.75f, true)

    private var activePath: String? = null
    private var activeLength: Long = -1L
    private var activeModified: Long = -1L
    private var activeDescriptor: ParcelFileDescriptor? = null
    private var activeRenderer: PdfRenderer? = null

    private fun recycleCached(entry: CachedBitmap?) {
        val bitmap = entry?.bitmap ?: return
        if (!bitmap.isRecycled) bitmap.recycle()
    }

    private fun clearCache() {
        synchronized(cacheLock) {
            bitmapCache.values.forEach(::recycleCached)
            bitmapCache.clear()
        }
        pendingPrefetch.clear()
    }

    private fun takeCached(key: RenderKey): CachedBitmap? =
        synchronized(cacheLock) {
            bitmapCache.remove(key)
        }

    private fun hasCached(key: RenderKey): Boolean =
        synchronized(cacheLock) {
            bitmapCache.containsKey(key)
        }

    private fun putCached(key: RenderKey, entry: CachedBitmap) {
        synchronized(cacheLock) {
            recycleCached(bitmapCache.remove(key))
            bitmapCache[key] = entry
            while (bitmapCache.size > CACHE_LIMIT) {
                val eldestKey = bitmapCache.entries.iterator().next().key
                recycleCached(bitmapCache.remove(eldestKey))
            }
        }
    }

    fun returnVisibleBitmap(
        key: RenderKey,
        pageCount: Int,
        bitmap: Bitmap,
        trimmingRect: RectF?,
    ) {
        if (bitmap.isRecycled) return
        putCached(
            key,
            CachedBitmap(
                bitmap = bitmap,
                pageCount = pageCount,
                trimmingRect = trimmingRect?.let(::RectF),
            ),
        )
        Log.i(LOG_TAG, "RTL_READER_NATIVE_VIEW_VISIBLE_CACHED page=${key.pageIndex + 1}")
    }

    private fun makeKey(filePath: String, pageIndex: Int, requestedWidth: Int): Pair<File, RenderKey> {
        val file = File(filePath)
        if (!file.exists() || !file.isFile) {
            throw IllegalArgumentException("PDF file is not accessible: $filePath")
        }
        if (pageIndex < 0) {
            throw IllegalArgumentException("Invalid PDF page index: $pageIndex")
        }
        val canonicalPath = file.canonicalPath
        return Pair(
            file,
            RenderKey(
                canonicalPath = canonicalPath,
                length = file.length(),
                modified = file.lastModified(),
                pageIndex = pageIndex,
                requestedWidth = requestedWidth.coerceIn(320, 2200),
            ),
        )
    }

    private fun closeRendererLocked() {
        try {
            activeRenderer?.close()
        } catch (_: Throwable) {
        }
        activeRenderer = null

        try {
            activeDescriptor?.close()
        } catch (_: Throwable) {
        }
        activeDescriptor = null

        activePath = null
        activeLength = -1L
        activeModified = -1L
    }

    private fun ensureRendererLocked(file: File, key: RenderKey): Pair<PdfRenderer, Boolean> {
        val existing = activeRenderer
        val canReuse =
            existing != null &&
                activePath == key.canonicalPath &&
                activeLength == key.length &&
                activeModified == key.modified

        if (canReuse) {
            return Pair(existing!!, true)
        }

        closeRendererLocked()
        clearCache()

        val descriptor = ParcelFileDescriptor.open(file, ParcelFileDescriptor.MODE_READ_ONLY)
        val renderer = try {
            PdfRenderer(descriptor)
        } catch (error: Throwable) {
            try {
                descriptor.close()
            } catch (_: Throwable) {
            }
            throw error
        }

        activePath = key.canonicalPath
        activeLength = key.length
        activeModified = key.modified
        activeDescriptor = descriptor
        activeRenderer = renderer

        Log.i(
            LOG_TAG,
            "RTL_READER_NATIVE_VIEW_RENDERER_OPEN path=${key.canonicalPath} pages=${renderer.pageCount}",
        )
        return Pair(renderer, false)
    }

    private fun renderLocked(
        file: File,
        key: RenderKey,
        totalStarted: Long,
    ): DirectRenderResult {
        val openStarted = SystemClock.elapsedRealtime()
        val (renderer, reusedRenderer) = ensureRendererLocked(file, key)
        val openMs = SystemClock.elapsedRealtime() - openStarted

        if (key.pageIndex >= renderer.pageCount) {
            throw IllegalArgumentException(
                "PDF page ${key.pageIndex + 1} is outside the document (${renderer.pageCount} pages).",
            )
        }

        var page: PdfRenderer.Page? = null
        var bitmap: Bitmap? = null
        try {
            page = renderer.openPage(key.pageIndex)
            val height = max(
                1,
                (key.requestedWidth.toDouble() * page.height.toDouble() / page.width.toDouble()).roundToInt(),
            )

            bitmap = Bitmap.createBitmap(key.requestedWidth, height, Bitmap.Config.ARGB_8888)
            bitmap.eraseColor(Color.WHITE)

            val renderStarted = SystemClock.elapsedRealtime()
            page.render(
                bitmap,
                null,
                null,
                PdfRenderer.Page.RENDER_MODE_FOR_DISPLAY,
            )
            val renderMs = SystemClock.elapsedRealtime() - renderStarted
            val trimmingRect = NativeFillTrimming.detect(bitmap)
            val totalMs = SystemClock.elapsedRealtime() - totalStarted

            val result = DirectRenderResult(
                bitmap = bitmap,
                key = key,
                pageCount = renderer.pageCount,
                reusedRenderer = reusedRenderer,
                cacheHit = false,
                openMs = openMs,
                renderMs = renderMs,
                totalMs = totalMs,
                trimmingRect = trimmingRect,
            )
            bitmap = null
            return result
        } finally {
            bitmap?.recycle()
            try {
                page?.close()
            } catch (_: Throwable) {
            }
        }
    }

    fun renderForeground(
        filePath: String,
        pageIndex: Int,
        requestedWidth: Int,
        isCurrent: () -> Boolean,
    ): DirectRenderResult? {
        val totalStarted = SystemClock.elapsedRealtime()
        if (!isCurrent()) return null
        val (file, key) = makeKey(filePath, pageIndex, requestedWidth)

        takeCached(key)?.let { cached ->
            if (!isCurrent()) {
                putCached(key, cached)
                return null
            }
            val totalMs = SystemClock.elapsedRealtime() - totalStarted
            Log.i(
                LOG_TAG,
                "RTL_READER_NATIVE_VIEW_RENDER page=${pageIndex + 1} reused=true cacheHit=true " +
                    "openMs=0 renderMs=0 pngMs=0 base64Ms=0 totalMs=$totalMs",
            )
            return DirectRenderResult(
                bitmap = cached.bitmap,
                key = key,
                pageCount = cached.pageCount,
                reusedRenderer = true,
                cacheHit = true,
                openMs = 0L,
                renderMs = 0L,
                totalMs = totalMs,
                trimmingRect = cached.trimmingRect?.let(::RectF),
            )
        }

        // Cancel queued speculative work for this exact page before foreground waits.
        // An already-running PdfRenderer page cannot be preempted, but no later prefetch
        // may jump ahead of this foreground request.
        if (!isCurrent()) return null
        pendingPrefetch.remove(key)
        foregroundDemand.incrementAndGet()
        rendererLock.lock()
        try {
            if (!isCurrent()) return null
            takeCached(key)?.let { cached ->
                if (!isCurrent()) {
                    putCached(key, cached)
                    return null
                }
                val totalMs = SystemClock.elapsedRealtime() - totalStarted
                Log.i(
                    LOG_TAG,
                    "RTL_READER_NATIVE_VIEW_RENDER page=${pageIndex + 1} reused=true cacheHit=true " +
                        "openMs=0 renderMs=0 pngMs=0 base64Ms=0 totalMs=$totalMs",
                )
                return DirectRenderResult(
                    bitmap = cached.bitmap,
                    key = key,
                    pageCount = cached.pageCount,
                    reusedRenderer = true,
                    cacheHit = true,
                    openMs = 0L,
                    renderMs = 0L,
                    totalMs = totalMs,
                    trimmingRect = cached.trimmingRect?.let(::RectF),
                )
            }

            if (!isCurrent()) return null
            val result = renderLocked(file, key, totalStarted)
            Log.i(
                LOG_TAG,
                "RTL_READER_NATIVE_VIEW_RENDER page=${pageIndex + 1} reused=${result.reusedRenderer} cacheHit=false " +
                    "openMs=${result.openMs} renderMs=${result.renderMs} pngMs=0 base64Ms=0 totalMs=${result.totalMs}",
            )
            return result
        } finally {
            rendererLock.unlock()
            foregroundDemand.decrementAndGet()
        }
    }

    fun schedulePrefetch(filePath: String, pageIndexes: List<Int>, requestedWidth: Int) {
        pageIndexes.distinct().filter { it >= 0 }.forEach { pageIndex ->
            val pair = try {
                makeKey(filePath, pageIndex, requestedWidth)
            } catch (_: Throwable) {
                return@forEach
            }
            val file = pair.first
            val key = pair.second
            if (
                hasCached(key) ||
                activePrefetch.contains(key) ||
                !pendingPrefetch.add(key)
            ) {
                return@forEach
            }

            prefetchExecutor.execute {
                // Claim this queued request. Foreground rendering cancels it by removing the key
                // before the task starts.
                if (!pendingPrefetch.remove(key)) return@execute
                if (!activePrefetch.add(key)) return@execute

                try {
                    if (hasCached(key) || foregroundDemand.get() > 0) {
                        Log.i(
                            LOG_TAG,
                            "RTL_READER_NATIVE_VIEW_PREFETCH_SKIPPED page=${pageIndex + 1} reason=foreground_or_cached",
                        )
                        return@execute
                    }

                    val totalStarted = SystemClock.elapsedRealtime()
                    if (!rendererLock.tryLock(10L, TimeUnit.MILLISECONDS)) {
                        Log.i(
                            LOG_TAG,
                            "RTL_READER_NATIVE_VIEW_PREFETCH_SKIPPED page=${pageIndex + 1} reason=renderer_busy",
                        )
                        return@execute
                    }

                    try {
                        if (hasCached(key) || foregroundDemand.get() > 0) {
                            Log.i(
                                LOG_TAG,
                                "RTL_READER_NATIVE_VIEW_PREFETCH_SKIPPED page=${pageIndex + 1} reason=foreground_after_lock",
                            )
                            return@execute
                        }

                        val result = renderLocked(file, key, totalStarted)
                        putCached(
                            key,
                            CachedBitmap(
                                bitmap = result.bitmap,
                                pageCount = result.pageCount,
                                trimmingRect = result.trimmingRect?.let(::RectF),
                            ),
                        )
                        Log.i(
                            LOG_TAG,
                            "RTL_READER_NATIVE_VIEW_PREFETCH page=${pageIndex + 1} reused=${result.reusedRenderer} " +
                                "openMs=${result.openMs} renderMs=${result.renderMs} totalMs=${result.totalMs}",
                        )
                    } finally {
                        rendererLock.unlock()
                    }
                } catch (error: Throwable) {
                    Log.w(
                        LOG_TAG,
                        "RTL_READER_NATIVE_VIEW_PREFETCH_FAILED page=${pageIndex + 1}",
                        error,
                    )
                } finally {
                    activePrefetch.remove(key)
                }
            }
        }
    }
}

class PdfPageView(
    private val reactContext: ThemedReactContext,
) : View(reactContext) {

    companion object {
        private const val EVENT_RENDERED = "topPdfRendered"
        private const val EVENT_ERROR = "topPdfError"
        private const val PREFETCH_DELAY_MS = 50L

        private val foregroundExecutor = Executors.newSingleThreadExecutor { runnable ->
            Thread(runnable, "rtl-reader-direct-foreground").apply { isDaemon = true }
        }
        private val prefetchDelayExecutor = Executors.newSingleThreadScheduledExecutor { runnable ->
            Thread(runnable, "rtl-reader-prefetch-delay").apply { isDaemon = true }
        }
    }

    var pendingFilePath: String? = null
    var pendingPageIndex: Int = -1
    var pendingRequestedWidth: Int = 0
    var pendingContentMode: String = "fit"
    var pendingPrefetchPageIndexes: List<Int> = emptyList()
    var pendingRequestStartedAtMs: Double = 0.0

    private val renderGeneration = AtomicLong(0L)
    private val bitmapPaint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.FILTER_BITMAP_FLAG)
    private var committedSignature: String? = null
    private var pageBitmap: Bitmap? = null
    private var pageBitmapMetadata: VisibleBitmapMetadata? = null
    private var pendingRenderedEvent: PendingRenderedEvent? = null

    init {
        setWillNotDraw(false)
        setBackgroundColor(Color.WHITE)
    }

    fun commitProps() {
        val filePath = pendingFilePath
        val pageIndex = pendingPageIndex
        val requestedWidth = pendingRequestedWidth
        val prefetchPages = pendingPrefetchPageIndexes.distinct()
        val requestStartedAtMs = pendingRequestStartedAtMs
        val signature = "$filePath|$pageIndex|$requestedWidth|${prefetchPages.joinToString(",")}" 
        if (signature == committedSignature) return
        committedSignature = signature

        val generation = renderGeneration.incrementAndGet()
        pendingRenderedEvent = null
        if (filePath.isNullOrBlank() || pageIndex < 0 || requestedWidth <= 0) {
            replaceBitmap(null, null, cachePrevious = false)
            invalidate()
            return
        }

        foregroundExecutor.execute {
            if (generation != renderGeneration.get()) return@execute
            try {
                val result = PdfDirectRenderEngine.renderForeground(
                    filePath,
                    pageIndex,
                    requestedWidth,
                ) { generation == renderGeneration.get() } ?: return@execute
                post {
                    if (generation != renderGeneration.get()) {
                        PdfDirectRenderEngine.returnVisibleBitmap(
                            result.key,
                            result.pageCount,
                            result.bitmap,
                            result.trimmingRect,
                        )
                        return@post
                    }

                    val renderedEvent = PendingRenderedEvent(
                        generation = generation,
                        filePath = filePath,
                        pageIndex = pageIndex,
                        requestedWidth = requestedWidth,
                        prefetchPageIndexes = prefetchPages,
                        requestStartedAtMs = requestStartedAtMs,
                        result = result,
                    )
                    replaceBitmap(
                        result.bitmap,
                        VisibleBitmapMetadata(
                            key = result.key,
                            pageCount = result.pageCount,
                            trimmingRect = result.trimmingRect?.let(::RectF),
                        ),
                    )
                    pendingRenderedEvent = renderedEvent
                    invalidate()
                }
            } catch (error: Throwable) {
                Log.e(
                    "RTL_READER",
                    "RTL_READER_NATIVE_VIEW_FAILED page=${pageIndex + 1}",
                    error,
                )
                post {
                    if (generation != renderGeneration.get()) return@post
                    val event = Arguments.createMap().apply {
                        putInt("pageIndex", pageIndex)
                        putString("message", error.message ?: error.toString())
                    }
                    reactContext
                        .getJSModule(RCTEventEmitter::class.java)
                        .receiveEvent(id, EVENT_ERROR, event)
                }
            }
        }
    }

    fun setContentMode(contentMode: String?) {
        val normalized = if (contentMode == "native_fill") "native_fill" else "fit"
        if (pendingContentMode == normalized) return
        pendingContentMode = normalized
        invalidate()
    }

    fun dispose() {
        renderGeneration.incrementAndGet()
        committedSignature = null
        pendingRenderedEvent = null
        replaceBitmap(null, null, cachePrevious = false)
    }

    private fun replaceBitmap(
        next: Bitmap?,
        nextMetadata: VisibleBitmapMetadata?,
        cachePrevious: Boolean = true,
    ) {
        val previous = pageBitmap
        val previousMetadata = pageBitmapMetadata
        pageBitmap = next
        pageBitmapMetadata = nextMetadata
        if (previous != null && previous !== next && !previous.isRecycled) {
            if (cachePrevious && previousMetadata != null) {
                PdfDirectRenderEngine.returnVisibleBitmap(
                    previousMetadata.key,
                    previousMetadata.pageCount,
                    previous,
                    previousMetadata.trimmingRect,
                )
            } else {
                previous.recycle()
            }
        }
    }

    private fun emitRenderedAfterDraw(pending: PendingRenderedEvent) {
        val interactionMs =
            if (pending.requestStartedAtMs > 0.0) {
                max(0L, System.currentTimeMillis() - pending.requestStartedAtMs.toLong())
            } else {
                -1L
            }

        Log.i(
            "RTL_READER",
            "RTL_READER_NATIVE_VIEW_DISPLAY page=${pending.pageIndex + 1} cacheHit=${pending.result.cacheHit} " +
                "interactionMs=${if (interactionMs >= 0L) interactionMs else "none"} nativeMs=${pending.result.totalMs}",
        )

        val event = Arguments.createMap().apply {
            putInt("pageIndex", pending.pageIndex)
            putInt("pageCount", pending.result.pageCount)
            putBoolean("reusedRenderer", pending.result.reusedRenderer)
            putBoolean("cacheHit", pending.result.cacheHit)
            putDouble("openMs", pending.result.openMs.toDouble())
            putDouble("renderMs", pending.result.renderMs.toDouble())
            putDouble("totalMs", pending.result.totalMs.toDouble())
            putDouble("interactionMs", interactionMs.toDouble())
        }
        reactContext
            .getJSModule(RCTEventEmitter::class.java)
            .receiveEvent(id, EVENT_RENDERED, event)

        if (pending.prefetchPageIndexes.isNotEmpty()) {
            prefetchDelayExecutor.schedule(
                {
                    if (pending.generation == renderGeneration.get()) {
                        PdfDirectRenderEngine.schedulePrefetch(
                            pending.filePath,
                            pending.prefetchPageIndexes,
                            pending.requestedWidth,
                        )
                    }
                },
                PREFETCH_DELAY_MS,
                TimeUnit.MILLISECONDS,
            )
        }
    }

    private fun requestBitmapRedraw(reason: String) {
    val bitmap = pageBitmap ?: return
    if (bitmap.isRecycled || width <= 0 || height <= 0) return
    val pageNumber = pageBitmapMetadata?.key?.pageIndex?.plus(1) ?: -1
    Log.i(
        "RTL_READER",
        "RTL_READER_NATIVE_VIEW_SIZE_REDRAW page=$pageNumber reason=$reason size=${width}x${height}",
    )
    postInvalidate()
}

override fun onAttachedToWindow() {
    super.onAttachedToWindow()
    requestBitmapRedraw("attached")
}

override fun onSizeChanged(w: Int, h: Int, oldw: Int, oldh: Int) {
    super.onSizeChanged(w, h, oldw, oldh)
    if (w > 0 && h > 0 && (w != oldw || h != oldh)) {
        requestBitmapRedraw("size_changed")
    }
}

private fun validTrimmingRect(bitmap: Bitmap, rect: RectF?): Boolean =
    rect != null &&
        rect.left >= 0f &&
        rect.top >= 0f &&
        rect.right <= bitmap.width + 1f &&
        rect.bottom <= bitmap.height + 1f &&
        rect.width() > 1f &&
        rect.height() > 1f

private fun nativeTrimmedDestination(bitmap: Bitmap, trimmingRect: RectF): RectF {
    // Mirror Supernote TrimmingUtil/BitmapUtil geometry: fit the detected
    // non-white content rectangle into this page slot while preserving the
    // asymmetric margin anchor in the original page coordinate system.
    val scale = min(
        width.toFloat() / trimmingRect.width(),
        height.toFloat() / trimmingRect.height(),
    )
    val horizontalRoom = width - trimmingRect.width() * scale
    val verticalRoom = height - trimmingRect.height() * scale
    val horizontalMargin = bitmap.width - trimmingRect.width()
    val verticalMargin = bitmap.height - trimmingRect.height()
    val horizontalAnchor =
        (if (horizontalMargin > 0f) trimmingRect.left / horizontalMargin else 0.5f)
            .coerceIn(0f, 1f)
    val verticalAnchor =
        (if (verticalMargin > 0f) trimmingRect.top / verticalMargin else 0.5f)
            .coerceIn(0f, 1f)
    val trimmedLeft = horizontalRoom * horizontalAnchor
    val trimmedTop = verticalRoom * verticalAnchor
    val left = trimmedLeft - trimmingRect.left * scale
    val top = trimmedTop - trimmingRect.top * scale
    return RectF(
        left,
        top,
        left + bitmap.width * scale,
        top + bitmap.height * scale,
    )
}

override fun onDraw(canvas: Canvas) {
        super.onDraw(canvas)
        val bitmap = pageBitmap ?: return
        if (bitmap.isRecycled || width <= 0 || height <= 0) return

        val trimmingRect = pageBitmapMetadata?.trimmingRect
        val destination = if (
            pendingContentMode == "native_fill" &&
            validTrimmingRect(bitmap, trimmingRect)
        ) {
            nativeTrimmedDestination(bitmap, trimmingRect!!)
        } else {
            val widthScale = width.toFloat() / bitmap.width.toFloat()
            val heightScale = height.toFloat() / bitmap.height.toFloat()
            val scale = if (pendingContentMode == "native_fill") {
                max(widthScale, heightScale)
            } else {
                min(widthScale, heightScale)
            }
            val drawWidth = bitmap.width * scale
            val drawHeight = bitmap.height * scale
            val left = (width - drawWidth) / 2f
            val top = (height - drawHeight) / 2f
            RectF(left, top, left + drawWidth, top + drawHeight)
        }
        val saveCount = canvas.save()
        canvas.clipRect(0f, 0f, width.toFloat(), height.toFloat())
        canvas.drawBitmap(bitmap, null, destination, bitmapPaint)
        canvas.restoreToCount(saveCount)

        val pending = pendingRenderedEvent
        if (pending != null && pending.generation == renderGeneration.get()) {
            pendingRenderedEvent = null
            emitRenderedAfterDraw(pending)
        }
    }

    override fun onDetachedFromWindow() {
        dispose()
        super.onDetachedFromWindow()
    }
}
