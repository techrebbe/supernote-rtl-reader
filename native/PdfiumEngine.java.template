package __PACKAGE__;

import android.os.ParcelFileDescriptor;
import android.system.Os;
import android.system.OsConstants;
import android.system.StructStat;
import android.system.ErrnoException;
import java.io.ByteArrayOutputStream;
import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.InputStream;
import java.security.MessageDigest;

/** Exact vendor bytes -> unlinked immutable FD -> explicit native provider. */
final class PdfiumEngine {
    private static final String SHA="e6b7257b3905152dab64c79f7a4a570693e11ccb740e92e4d3b89c28df6fcbbb";
    private static boolean bound;
    private static String digest(byte[] bytes)throws Exception{
        StringBuilder hex=new StringBuilder(64);
        for(byte b:MessageDigest.getInstance("SHA-256").digest(bytes))hex.append(String.format(java.util.Locale.ROOT,"%02x",b&255));
        return hex.toString();
    }
    private static byte[] bytes(InputStream input)throws Exception{
        ByteArrayOutputStream output=new ByteArrayOutputStream();
        byte[] block=new byte[8192];int size=0,n;
        while((n=input.read(block))!=-1){size+=n;if(size>20000000)throw new IllegalStateException("Engine byte bound");output.write(block,0,n);}
        if(size==0)throw new IllegalStateException("Empty engine provider");
        return output.toByteArray();
    }
    private static byte[] snapshot(String path)throws Exception{
        if(path==null || !path.startsWith("/") || path.length()>4096)throw new IllegalStateException("Private engine origin unavailable");
        int embedded=path.indexOf("!/");
        byte[] result;
        if(embedded>=0){
            String apk=path.substring(0,embedded),entry=path.substring(embedded+2);
            if(!(apk.endsWith(".apk")||apk.endsWith(".npk")) || !entry.equals("lib/arm64-v8a/libpdfium.so"))
                throw new IllegalStateException("Unsupported embedded private engine");
            try(java.util.zip.ZipFile archive=new java.util.zip.ZipFile(apk)){
                java.util.zip.ZipEntry item=archive.getEntry(entry);
                if(item==null || item.getSize()<=0 || item.getSize()>20000000)throw new IllegalStateException("Private engine entry bound");
                try(InputStream input=archive.getInputStream(item)){result=bytes(input);}
            }
        }else{
            if(!path.endsWith("/libpdfium.so"))throw new IllegalStateException("Unsupported private engine file");
            try(FileInputStream input=new FileInputStream(Os.open(path,OsConstants.O_RDONLY|OsConstants.O_CLOEXEC|OsConstants.O_NOFOLLOW,0))){
                StructStat before=Os.fstat(input.getFD());
                if(!OsConstants.S_ISREG(before.st_mode) || before.st_size<=0 || before.st_size>20000000)throw new IllegalStateException("Private engine file bound");
                result=bytes(input);
                StructStat after=Os.fstat(input.getFD());
                if(before.st_dev!=after.st_dev || before.st_ino!=after.st_ino || before.st_size!=after.st_size ||
                   before.st_mtime!=after.st_mtime || before.st_ctime!=after.st_ctime || result.length!=after.st_size)
                    throw new IllegalStateException("Private engine changed during authentication");
            }
        }
        String observed=digest(result);
        if(!SHA.equals(observed))throw new IllegalStateException("Private PDFium origin="+path+" actualSHA256="+observed+" is not the pinned engine");
        return result;
    }
    static synchronized void ensure(File cache)throws Exception{
        if(bound)return;
        byte[] image=snapshot(PdfiumReaderCore.candidatePath());
        File directory=new File(cache.getCanonicalFile(),"snrtl20260726001-pdfium-engine");
        if(!directory.isDirectory() && !directory.mkdir())throw new IllegalStateException("Private engine cache unavailable");
        if(!OsConstants.S_ISDIR(Os.lstat(directory.getPath()).st_mode))throw new IllegalStateException("Private engine cache link/type");
        File temporary=File.createTempFile("engine-",".so",directory);
        StructStat created=Os.lstat(temporary.getPath());
        FileInputStream input=null;
        try{
            try(FileOutputStream output=new FileOutputStream(Os.open(temporary.getPath(),OsConstants.O_WRONLY|OsConstants.O_CLOEXEC|OsConstants.O_NOFOLLOW,0))){
                input=new FileInputStream(Os.open(temporary.getPath(),OsConstants.O_RDONLY|OsConstants.O_CLOEXEC|OsConstants.O_NOFOLLOW,0));
                StructStat writer=Os.fstat(output.getFD()),reader=Os.fstat(input.getFD());
                if(writer.st_dev!=reader.st_dev || writer.st_ino!=reader.st_ino || created.st_dev!=reader.st_dev ||
                   created.st_ino!=reader.st_ino || !OsConstants.S_ISREG(reader.st_mode) || reader.st_size!=0)
                    throw new IllegalStateException("Private engine snapshot identity");
                // Unlink BEFORE writing. A process death cannot leave engine bytes
                // or a pathname through which another operation can reopen them.
                if(!temporary.delete())throw new IllegalStateException("Private engine unlink failed");
                output.write(image);output.getFD().sync();
            }
            byte[] copied=bytes(input);
            String copiedHash=digest(copied);
            if(!SHA.equals(copiedHash))throw new IllegalStateException("Private engine copy mismatch");
            Os.lseek(input.getFD(),0,OsConstants.SEEK_SET);
            try(ParcelFileDescriptor descriptor=ParcelFileDescriptor.dup(input.getFD())){
                PdfiumReaderCore.bindEngine(descriptor.getFd(),temporary.getAbsolutePath(),copiedHash);
            }
        }finally{
            try{if(input!=null)input.close();}finally{removeCreated(temporary,created);}
        }
        bound=true;
    }
    private static void removeCreated(File file,StructStat created)throws Exception{
        StructStat observed;
        try{observed=Os.lstat(file.getPath());}
        catch(ErrnoException error){if(error.errno==OsConstants.ENOENT)return;throw error;}
        if(!OsConstants.S_ISREG(observed.st_mode) || observed.st_dev!=created.st_dev || observed.st_ino!=created.st_ino)
            throw new IllegalStateException("Owned engine path replaced; preserved");
        if(!file.delete())throw new IllegalStateException("Owned engine temporary cleanup failed");
    }
    private PdfiumEngine(){}
}
