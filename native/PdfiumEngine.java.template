package __PACKAGE__;

import android.os.ParcelFileDescriptor;
import android.system.Os;
import android.system.OsConstants;
import android.system.StructStat;
import java.io.ByteArrayOutputStream;
import java.io.File;
import java.io.FileInputStream;
import java.io.InputStream;
import java.security.MessageDigest;

/** Authenticate the installed library FD; never create executable cache files. */
final class PdfiumEngine {
    private static final String SHA="e6b7257b3905152dab64c79f7a4a570693e11ccb740e92e4d3b89c28df6fcbbb";
    private static final long SIZE=6573320;
    private static String digest(byte[] bytes)throws Exception{
        StringBuilder hex=new StringBuilder(64);
        for(byte b:MessageDigest.getInstance("SHA-256").digest(bytes))hex.append(String.format(java.util.Locale.ROOT,"%02x",b&255));
        return hex.toString();
    }
    private static byte[] bytes(InputStream input)throws Exception{
        ByteArrayOutputStream output=new ByteArrayOutputStream();
        byte[] block=new byte[8192];int size=0,n;
        while((n=input.read(block))!=-1){size+=n;if(size>20000000)throw new IllegalStateException("Engine byte bound");output.write(block,0,n);}
        if(size==0)throw new IllegalStateException("Empty engine provider");
        return output.toByteArray();
    }
    private static String physicalPath(String path){
        if(path==null || !path.startsWith("/") || path.length()>4096 || path.indexOf('\0')>=0 ||
           path.contains("!/") || !path.endsWith("/libpdfium.so"))
            throw new IllegalStateException("Only the installed physical PDFium sibling is supported");
        return path;
    }
    private static void authenticate(byte[] image,String origin)throws Exception{
        String observed=digest(image);
        if(image.length!=SIZE || !SHA.equals(observed))throw new IllegalStateException(
            "Installed PDFium origin="+origin+" actualSHA256="+observed+" is not the pinned engine");
    }
    private static boolean same(StructStat a,StructStat b){
        return a.st_dev==b.st_dev && a.st_ino==b.st_ino && a.st_size==b.st_size &&
            a.st_mode==b.st_mode && a.st_nlink==b.st_nlink && a.st_mtime==b.st_mtime && a.st_ctime==b.st_ctime;
    }
    static synchronized void ensure()throws Exception{
        String path=new File(physicalPath(PdfiumReaderCore.candidatePath())).getCanonicalPath();
        // Same FD is hashed and mapped. No cache copy, extraction, unlink or chmod.
        try(FileInputStream input=new FileInputStream(Os.open(path,OsConstants.O_RDONLY|OsConstants.O_CLOEXEC|OsConstants.O_NOFOLLOW,0))){
            StructStat before=Os.fstat(input.getFD());
            if(!OsConstants.S_ISREG(before.st_mode) || before.st_size!=SIZE || before.st_nlink<=0 ||
               !same(before,Os.lstat(path)))throw new IllegalStateException("Installed engine FD/path identity");
            authenticate(bytes(input),path);
            if(!same(before,Os.fstat(input.getFD())) || !same(before,Os.lstat(path)))
                throw new IllegalStateException("Installed engine changed during authentication");
            Os.lseek(input.getFD(),0,OsConstants.SEEK_SET);
            try(ParcelFileDescriptor descriptor=ParcelFileDescriptor.dup(input.getFD())){
                PdfiumReaderCore.bindEngine(descriptor.getFd(),path,SHA);
            }
            Os.lseek(input.getFD(),0,OsConstants.SEEK_SET);
            authenticate(bytes(input),path);
            if(!same(before,Os.fstat(input.getFD())) || !same(before,Os.lstat(path)))
                throw new IllegalStateException("Installed engine changed during binding");
        }
        // This is NOT an immutable/sealed FD or an ABA proof. The trusted SDK
        // must not install/update/re-extract native files while a session is live.
        // Session close/failure releases the mapping on the same process FIFO.
    }
    private PdfiumEngine(){}
}
