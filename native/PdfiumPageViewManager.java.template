package __PACKAGE__;

import com.facebook.react.common.MapBuilder;
import com.facebook.react.uimanager.SimpleViewManager;
import com.facebook.react.uimanager.ThemedReactContext;
import com.facebook.react.uimanager.annotations.ReactProp;
import java.util.Map;
import com.facebook.react.bridge.ReadableArray;

public final class PdfiumPageViewManager extends SimpleViewManager<PdfiumPageView> {
    @Override public String getName(){return "PdfiumPageView";}
    @Override protected PdfiumPageView createViewInstance(ThemedReactContext context){return new PdfiumPageView(context);}
    @ReactProp(name="requestSpec") public void request(PdfiumPageView view,String value){view.pending=value;}
    @Override protected void onAfterUpdateTransaction(PdfiumPageView view){super.onAfterUpdateTransaction(view);view.commit();}
    @Override public void onDropViewInstance(PdfiumPageView view){view.dispose();super.onDropViewInstance(view);}
    @Override public Map<String,Integer> getCommandsMap(){return MapBuilder.of("copySelection",1);}
    @Override public void receiveCommand(PdfiumPageView view,int command,ReadableArray args){
        if(command==1 && args!=null && args.size()==1)view.copySelection(args.getString(0));
    }
    @Override public void receiveCommand(PdfiumPageView view,String command,ReadableArray args){
        if("copySelection".equals(command))receiveCommand(view,1,args);
    }
    @Override public Map<String,Object> getExportedCustomDirectEventTypeConstants(){
        return MapBuilder.of("topPdfiumEvent",MapBuilder.of("registrationName","onPdfiumEvent"));
    }
}
