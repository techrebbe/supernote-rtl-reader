package __PACKAGE__;

import com.facebook.react.bridge.Arguments;
import com.facebook.react.bridge.Promise;
import com.facebook.react.bridge.ReactApplicationContext;
import com.facebook.react.bridge.ReactContextBaseJavaModule;
import com.facebook.react.bridge.ReactMethod;
import com.facebook.react.bridge.WritableMap;

public final class PdfiumReaderModule extends ReactContextBaseJavaModule {
    private volatile PdfiumSession owned;
    private volatile boolean invalid;
    private volatile String lastClosed;
    public PdfiumReaderModule(ReactApplicationContext context){super(context);}
    @Override public String getName(){return "PdfiumReaderModule";}
    @ReactMethod public void open(String path, double expectedPageCount, Promise promise){
        if(!Double.isFinite(expectedPageCount) || expectedPageCount!=Math.rint(expectedPageCount) ||
            expectedPageCount<1 || expectedPageCount>10000){promise.reject("PDFIUM_INPUT","Invalid original page count");return;}
        PdfiumSession.QUEUE.execute(()->{
            try{
                if(invalid || owned!=null)throw new IllegalStateException("Reader session already open or retired");
                PdfiumSession value=PdfiumSession.open(path,(int)expectedPageCount,getReactApplicationContext().getCacheDir());
                owned=value;
                if(invalid){value.close();owned=null;throw new IllegalStateException("Reader retired during open");}
                WritableMap result=Arguments.createMap();result.putString("sessionId",value.id);
                result.putString("filePath",value.path);result.putString("sourceSha256",value.sha256);
                result.putInt("pageCount",value.pageCount);
                result.putString("outline",PdfiumReaderCore.outline(value.token));
                promise.resolve(result);
            }catch(Exception|LinkageError error){
                PdfiumSession value=owned;
                if(value!=null){value.close();owned=null;}
                promise.reject("PDFIUM_OPEN",error.getMessage(),error);
            }
        });
    }
    @ReactMethod public void close(String id, boolean verifySource, Promise promise){
        PdfiumSession value=owned;
        if(value==null){
            if(id!=null && id.equals(lastClosed)){promise.resolve(true);return;}
            promise.reject("PDFIUM_OWNER","Unknown reader owner");return;
        }
        if(!value.id.equals(id)){promise.reject("PDFIUM_OWNER","Stale reader owner");return;}
        value.fence();
        PdfiumSession.QUEUE.execute(()->{
            try{
                if(verifySource)value.verifySource();
                value.close();if(owned==value)owned=null;lastClosed=id;promise.resolve(true);
            }catch(Exception|LinkageError error){
                value.close();if(owned==value)owned=null;lastClosed=id;
                promise.reject("PDFIUM_SOURCE",error.getMessage(),error);
            }
        });
    }
    @Override public void invalidate(){
        invalid=true;
        PdfiumSession value=owned;
        if(value!=null){value.fence();PdfiumSession.QUEUE.execute(()->{value.close();if(owned==value)owned=null;});}
        super.invalidate();
    }
}
