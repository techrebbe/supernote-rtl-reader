package __PACKAGE__;

import com.facebook.react.bridge.Promise;
import com.facebook.react.bridge.ReactApplicationContext;
import com.facebook.react.bridge.ReactContextBaseJavaModule;
import com.facebook.react.bridge.ReactMethod;
import java.util.UUID;

/** Creates identity only. No Activity, key hook, IO, page or writer access. */
public final class ReaderKeyModule extends ReactContextBaseJavaModule {
    public ReaderKeyModule(ReactApplicationContext context) { super(context); }
    @Override public String getName() { return "ReaderKeyModule"; }

    @ReactMethod public void createRequestNamespace(Promise promise) {
        // A constant or a JS counter alone could repeat after a JS reload.
        promise.resolve(UUID.randomUUID().toString());
    }
}
