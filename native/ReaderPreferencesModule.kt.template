    @Suppress("DEPRECATION")
    private fun packageVersionCode(packageName: String): Pair<Long, String?> {
        val info = reactApplicationContext.packageManager.getPackageInfo(packageName, 0)
        val code = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
            info.longVersionCode
        } else {
            info.versionCode.toLong()
        }
        return code to info.versionName
    }

    @Suppress("DEPRECATION")
    private fun signedPackageVersionCode(
        packageName: String,
    ): Triple<Long, String?, String> {
        val flags = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
            PackageManager.GET_SIGNING_CERTIFICATES
        } else {
            PackageManager.GET_SIGNATURES
        }
        val info = reactApplicationContext.packageManager.getPackageInfo(
            packageName,
            flags,
        )
        val signatures = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
            val signing = info.signingInfo
                ?: throw IllegalStateException("Native Reader signer is unavailable")
            if (signing.hasMultipleSigners()) {
                throw IllegalStateException("Native Reader has multiple current signers")
            }
            signing.apkContentsSigners
        } else {
            info.signatures
        }
        if (signatures == null || signatures.size != 1) {
            throw IllegalStateException("Native Reader signer set is not exact")
        }
        val applicationInfo = info.applicationInfo
            ?: throw IllegalStateException("Native Reader APK location is unavailable")
        if (!applicationInfo.splitSourceDirs.isNullOrEmpty()) {
            throw IllegalStateException("Native Reader split APKs are not supported")
        }
        val sourcePath = applicationInfo.sourceDir
            ?: throw IllegalStateException("Native Reader base APK path is unavailable")
        val sourceFile = File(sourcePath)
        val sourcePathIdentity = pathIdentityNoFollow(sourceFile)
            ?: throw IllegalStateException("Native Reader base APK disappeared")
        val sourceDescriptor = openPinnedRegularFile(
            sourceFile,
            sourcePathIdentity,
            "Native Reader base APK",
        )
        val sourceBytes = try {
            readPinnedRegularBytes(
                sourceDescriptor,
                sourcePathIdentity,
                "Native Reader base APK",
            )
        } finally {
            Os.close(sourceDescriptor)
        }
        if (sourceBytes.size.toLong() != NATIVE_READER_V2_APK_LENGTH ||
            sha256(sourceBytes) != NATIVE_READER_V2_APK_SHA256
        ) {
            throw IllegalStateException("Native Reader base APK identity is not exact")
        }
        val code = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
            info.longVersionCode
        } else {
            info.versionCode.toLong()
        }
        return Triple(
            code,
            info.versionName,
            sha256(signatures[0].toByteArray()),
        )
    }

    private fun requestNativeSpreadHandshake(
        pdfFile: File,
        configurationGeneration: Long,
        callback: (NativeSpreadHandshake) -> Unit,
    ) {
        val mainHandler = Handler(Looper.getMainLooper())
        val completed = AtomicBoolean(false)
        val receiver = AtomicReference<BroadcastReceiver?>(null)
        val expectedPath = pdfFile.absolutePath
        val handshakeDeadlineUptimeMs =
            SystemClock.uptimeMillis() + NATIVE_SPREAD_HANDSHAKE_TIMEOUT_MS
        lateinit var timeout: Runnable

        val finish: (NativeSpreadHandshake) -> Unit = { result ->
            val publication = Runnable {
                if (completed.compareAndSet(false, true)) {
                    mainHandler.removeCallbacks(timeout)
                    receiver.getAndSet(null)?.let { registered ->
                        nativeSpreadHandshakeReceivers.remove(registered)
                        try {
                            reactApplicationContext.unregisterReceiver(registered)
                        } catch (_: Throwable) {
                            // The receiver may already have been removed during teardown.
                        }
                    }
                    synchronized(nativeSpreadConfigurationIntentLock) {
                        if (!nativeSpreadModuleInvalidated.get()) {
                            val terminalResult =
                                if (nativeSpreadConfigurationGeneration.get() ==
                                    configurationGeneration
                                ) {
                                    result
                                } else {
                                    NativeSpreadHandshake(false, "stale_operation")
                                }
                            callback(terminalResult)
                        }
                    }
                }
            }
            if (Looper.myLooper() == Looper.getMainLooper()) {
                publication.run()
            } else if (!mainHandler.post(publication)) {
                // The host looper is exiting. Fence every later response even
                // though there is no live caller left to receive a callback.
                completed.compareAndSet(false, true)
            }
        }

        timeout = Runnable {
            val reason = when {
                nativeSpreadModuleInvalidated.get() -> "module_invalidated"
                nativeSpreadConfigurationGeneration.get() !=
                    configurationGeneration -> "stale_operation"
                else -> "timeout"
            }
            finish(NativeSpreadHandshake(false, reason))
        }

        if (!mainHandler.postDelayed(
                timeout,
                NATIVE_SPREAD_HANDSHAKE_TIMEOUT_MS,
            )
        ) {
            completed.set(true)
            return
        }

        if (reactApplicationContext.packageName != PLUGIN_HOST_PACKAGE) {
            finish(NativeSpreadHandshake(false, "unexpected_plugin_host"))
            return
        }
        if (nativeSpreadModuleInvalidated.get()) {
            finish(NativeSpreadHandshake(false, "module_invalidated"))
            return
        }
        if (nativeSpreadConfigurationGeneration.get() != configurationGeneration) {
            finish(NativeSpreadHandshake(false, "stale_operation"))
            return
        }

        val start = Runnable {
            if (completed.get()) return@Runnable
            if (SystemClock.uptimeMillis() >= handshakeDeadlineUptimeMs) {
                finish(NativeSpreadHandshake(false, "timeout"))
                return@Runnable
            }
            requestNativeSpreadHandshakeBound(
                expectedPath,
                handshakeDeadlineUptimeMs,
                configurationGeneration,
                completed,
                receiver,
                finish,
            )
        }
        if (Looper.myLooper() == Looper.getMainLooper()) {
            start.run()
        } else if (!mainHandler.post(start)) {
            completed.compareAndSet(false, true)
        }
    }

    private fun requestNativeSpreadHandshakeBound(
        expectedPath: String,
        handshakeDeadlineUptimeMs: Long,
        configurationGeneration: Long,
        completed: AtomicBoolean,
        receiver: AtomicReference<BroadcastReceiver?>,
        finish: (NativeSpreadHandshake) -> Unit,
    ) {
        check(Looper.myLooper() == Looper.getMainLooper()) {
            "Native Reader v2 handshake registration must run on the main thread"
        }
        if (completed.get()) return
        if (nativeSpreadModuleInvalidated.get()) {
            finish(NativeSpreadHandshake(false, "module_invalidated"))
            return
        }
        if (nativeSpreadConfigurationGeneration.get() != configurationGeneration) {
            finish(NativeSpreadHandshake(false, "stale_operation"))
            return
        }
        val nonce = UUID.randomUUID().toString()
        val registered = object : BroadcastReceiver() {
            override fun onReceive(context: Context?, intent: Intent?) {
                if (intent?.action != NATIVE_SPREAD_HANDSHAKE_RESPONSE ||
                    intent.getStringExtra(HANDSHAKE_EXTRA_NONCE) != nonce
                ) {
                    return
                }
                if (nativeSpreadModuleInvalidated.get()) {
                    finish(NativeSpreadHandshake(false, "module_invalidated"))
                    return
                }
                if (nativeSpreadConfigurationGeneration.get() !=
                    configurationGeneration
                ) {
                    finish(NativeSpreadHandshake(false, "stale_operation"))
                    return
                }
                if (SystemClock.uptimeMillis() >= handshakeDeadlineUptimeMs) {
                    finish(NativeSpreadHandshake(false, "timeout"))
                    return
                }

                val protocol = intent.getIntExtra(HANDSHAKE_EXTRA_PROTOCOL, -1)
                val hooksReady = intent.getBooleanExtra(
                    HANDSHAKE_EXTRA_HOOKS_READY,
                    false,
                )
                val moduleVersionCode = intent.getLongExtra(
                    HANDSHAKE_EXTRA_MODULE_VERSION_CODE,
                    -1L,
                )
                val documentApkLength = intent.getLongExtra(
                    HANDSHAKE_EXTRA_DOCUMENT_APK_LENGTH,
                    -1L,
                )
                val processId = intent.getIntExtra(
                    HANDSHAKE_EXTRA_PROCESS_ID,
                    -1,
                )
                val reportedPath = intent.getStringExtra(
                    HANDSHAKE_EXTRA_RAW_DOCUMENT_PATH,
                )

                val valid = hooksReady &&
                    protocol == NATIVE_SPREAD_HANDSHAKE_PROTOCOL &&
                    moduleVersionCode == NATIVE_READER_V2_MIN_VERSION_CODE &&
                    documentApkLength == SUPPORTED_DOCUMENT_APK_LENGTH &&
                    processId > 0 &&
                    reportedPath == expectedPath
                finish(
                    NativeSpreadHandshake(
                        valid,
                        if (valid) "ok" else "invalid_response",
                        protocol,
                        processId,
                    ),
                )
            }
        }
        receiver.set(registered)
        nativeSpreadHandshakeReceivers.add(registered)

        try {
            reactApplicationContext.registerReceiver(
                registered,
                IntentFilter(NATIVE_SPREAD_HANDSHAKE_RESPONSE),
            )
            if (SystemClock.uptimeMillis() >= handshakeDeadlineUptimeMs) {
                finish(NativeSpreadHandshake(false, "timeout"))
                return
            }
            reactApplicationContext.sendBroadcast(
                Intent(NATIVE_SPREAD_HANDSHAKE_REQUEST).apply {
                    setPackage(DOCUMENT_PACKAGE)
                    putExtra(HANDSHAKE_EXTRA_NONCE, nonce)
                    putExtra(HANDSHAKE_EXTRA_RAW_DOCUMENT_PATH, expectedPath)
                    putExtra(
                        HANDSHAKE_EXTRA_PROTOCOL,
                        NATIVE_SPREAD_HANDSHAKE_PROTOCOL,
                    )
                },
            )
            Log.i(
                LOG_TAG,
                "RTL_READER_NATIVE_SPREAD_HANDSHAKE_REQUEST path=$expectedPath",
            )
        } catch (error: Throwable) {
            Log.e(
                LOG_TAG,
                "RTL_READER_NATIVE_SPREAD_HANDSHAKE_REQUEST_FAILED: ${error.message}",
                error,
            )
            finish(NativeSpreadHandshake(false, "request_failed"))
        }
    }

    private fun beginNativeSpreadConfiguration(): Long =
        synchronized(nativeSpreadConfigurationIntentLock) {
            nativeSpreadConfigurationGeneration.incrementAndGet()
        }

    private inline fun <T> withNativeSpreadConfigurationAuthority(
        expected: Long,
        action: () -> T,
    ): T = synchronized(nativeSpreadConfigurationIntentLock) {
        requireNativeSpreadConfigurationGeneration(expected)
        action()
    }

    private fun requireNativeSpreadConfigurationGeneration(expected: Long) {
        synchronized(nativeSpreadConfigurationIntentLock) {
            check(
                !nativeSpreadModuleInvalidated.get() &&
                    nativeSpreadConfigurationGeneration.get() == expected
            ) {
                "Native Spread configuration was superseded"
            }
        }
    }

    private fun nativeSpreadCapability(): NativeSpreadCapability {
        val module = try {
            signedPackageVersionCode(NATIVE_SPREAD_PACKAGE)
        } catch (_: Throwable) {
            Triple(-1L, null, "")
        }
        val document = try {
            packageVersionCode(DOCUMENT_PACKAGE).first
        } catch (_: Throwable) {
            -1L
        }
        val compatible = Build.FINGERPRINT == SUPPORTED_FINGERPRINT &&
            document == SUPPORTED_DOCUMENT_VERSION_CODE &&
            module.first == NATIVE_READER_V2_MIN_VERSION_CODE &&
            module.third == NATIVE_READER_V2_SIGNER_SHA256
        return NativeSpreadCapability(
            compatible,
            module.first,
            module.second,
            document,
            module.third.ifEmpty { null },
        )
    }

    private fun requirePdf(filePath: String): File {
        val file = File(filePath)
        if (!file.isFile || !file.name.endsWith(".pdf", ignoreCase = true)) {
            throw IllegalStateException("Current PDF is not accessible: $filePath")
        }
        return file
    }

    private fun nativeSpreadMarker(pdfFile: File): File {
        val parent = pdfFile.parentFile
            ?: throw IllegalStateException("Current PDF has no parent directory")
        return File(parent, ".${pdfFile.name}$NATIVE_SPREAD_MARKER_SUFFIX")
    }

    private fun nativeMarkRecoveryPathKey(marker: File): String = marker.absolutePath

    private fun registerNativeMarkRecoveryRequired(marker: File) {
        synchronized(NATIVE_MARK_RECOVERY_PROCESS_LOCK) {
            NATIVE_MARK_RECOVERY_REQUIRED_PATHS.add(nativeMarkRecoveryPathKey(marker))
        }
    }

    private fun clearNativeMarkRecoveryRequired(marker: File) {
        synchronized(NATIVE_MARK_RECOVERY_PROCESS_LOCK) {
            NATIVE_MARK_RECOVERY_REQUIRED_PATHS.remove(nativeMarkRecoveryPathKey(marker))
        }
    }

    private fun nativeMarkRecoveryRequiredPending(): Boolean =
        synchronized(NATIVE_MARK_RECOVERY_PROCESS_LOCK) {
            NATIVE_MARK_RECOVERY_REQUIRED_PATHS.isNotEmpty()
        }

    private fun nativeMarkRecoveryPathRegistered(marker: File): Boolean =
        synchronized(NATIVE_MARK_RECOVERY_PROCESS_LOCK) {
            NATIVE_MARK_RECOVERY_REQUIRED_PATHS.contains(
                nativeMarkRecoveryPathKey(marker),
            )
        }

    /**
     * Reads the durable restore journal through the same no-follow authority
     * boundary used for every marker.  A malformed journal, an unexpected
     * replacement of a journal already observed in this process, or an
     * unreadable marker remains blocking.  An ordinary exact Native Spread
     * marker is not a recovery journal.
     */
    private fun inspectNativeMarkRecoveryFence(
        pdfFile: File,
        marker: File = nativeSpreadMarker(pdfFile),
    ): NativeMarkRecoveryInspection {
        val authority = try {
            readPersistedAuthorityIfFile(marker)
        } catch (error: Throwable) {
            registerNativeMarkRecoveryRequired(marker)
            return NativeMarkRecoveryInspection(
                null,
                true,
                "journal_unreadable:${error.message}",
            )
        }
        return inspectNativeMarkRecoveryFenceFromAuthority(
            pdfFile,
            marker,
            authority,
        )
    }

    private fun inspectNativeMarkRecoveryFenceFromAuthority(
        pdfFile: File,
        marker: File,
        authority: PersistedFileAuthority?,
    ): NativeMarkRecoveryInspection {
        if (authority == null) {
            return if (nativeMarkRecoveryPathRegistered(marker)) {
                NativeMarkRecoveryInspection(null, true, "journal_disappeared")
            } else {
                NativeMarkRecoveryInspection(null, false, "absent")
            }
        }

        val properties = try {
            strictProperties(authority.bytes)
        } catch (error: Throwable) {
            registerNativeMarkRecoveryRequired(marker)
            return NativeMarkRecoveryInspection(
                null,
                true,
                "journal_or_marker_invalid:${error.message}",
            )
        }
        val recoveryShaped = properties.getProperty("kind", "") ==
            NATIVE_MARK_RECOVERY_JOURNAL_KIND ||
            properties.containsKey("operationId") ||
            properties.containsKey("desiredMarkPresent")
        if (!recoveryShaped) {
            if (nativeMarkRecoveryPathRegistered(marker)) {
                return NativeMarkRecoveryInspection(
                    null,
                    true,
                    "journal_replaced",
                )
            }
            return try {
                requireNativeReaderV2MarkerSchema(properties)
                NativeMarkRecoveryInspection(null, false, "ordinary_marker")
            } catch (error: Throwable) {
                registerNativeMarkRecoveryRequired(marker)
                NativeMarkRecoveryInspection(
                    null,
                    true,
                    "journal_or_marker_invalid:${error.message}",
                )
            }
        }

        val journal = try {
            val exact = strictProperties(
                authority.bytes,
                NATIVE_MARK_RECOVERY_JOURNAL_FIELDS,
            )
            require(
                exact.getProperty("version") ==
                    NATIVE_MARK_RECOVERY_JOURNAL_VERSION.toString() &&
                    exact.getProperty("managedBy") == "supernote-rtl-reader" &&
                    exact.getProperty("kind") == NATIVE_MARK_RECOVERY_JOURNAL_KIND
            ) {
                "unsupported native mark recovery journal"
            }
            val operationId = exact.getProperty("operationId", "")
            UUID.fromString(operationId)
            val documentPath = exact.getProperty("documentPath", "")
            val documentLength = exact.getProperty("documentLength")?.toLongOrNull()
                ?: throw IllegalStateException("journal document length is invalid")
            val documentSha256 = exact.getProperty("documentSha256", "")
            val markPath = exact.getProperty("markPath", "")
            val desiredPresent = when (exact.getProperty("desiredMarkPresent", "")) {
                "true" -> true
                "false" -> false
                else -> throw IllegalStateException("journal desired presence is invalid")
            }
            val desiredLength = exact.getProperty("desiredMarkLength")?.toLongOrNull()
                ?: throw IllegalStateException("journal desired length is invalid")
            val desiredSha256 = exact.getProperty("desiredMarkSha256", "")
            val backupManifestPath = exact.getProperty("backupManifestPath", "")
            val backupManifestLength =
                exact.getProperty("backupManifestLength")?.toLongOrNull()
                    ?: throw IllegalStateException("journal backup length is invalid")
            val backupManifestSha256 =
                exact.getProperty("backupManifestSha256", "")
            val backupSnapshotPath = exact.getProperty("backupSnapshotPath", "")
            val createdAt = exact.getProperty("createdAt")?.toLongOrNull()
                ?: throw IllegalStateException("journal creation time is invalid")
            val expectedDocumentPath = pdfFile.canonicalPath
            val expectedMarkPath = nativeAnnotationMark(pdfFile).canonicalPath
            val expectedManifestPath = nativeAnnotationBackupManifest(pdfFile).canonicalPath
            val expectedSnapshotPath = nativeAnnotationBackupSnapshot(pdfFile).canonicalPath
            require(
                documentPath == expectedDocumentPath &&
                    documentLength == pdfFile.length() &&
                    documentSha256.matches(Regex("[0-9a-f]{64}")) &&
                    documentSha256 == sha256(pdfFile) &&
                    markPath == expectedMarkPath &&
                    desiredLength >= 0L &&
                    (
                        desiredPresent && desiredSha256.matches(Regex("[0-9a-f]{64}")) ||
                            !desiredPresent && desiredLength == 0L &&
                            desiredSha256 == "ABSENT"
                        ) &&
                    backupManifestPath == expectedManifestPath &&
                    backupManifestLength in 1..STRICT_PROPERTIES_MAX_BYTES.toLong() &&
                    backupManifestSha256.matches(Regex("[0-9a-f]{64}")) &&
                    backupSnapshotPath == expectedSnapshotPath &&
                    createdAt > 0L
            ) {
                "native mark recovery journal authority is invalid"
            }
            NativeMarkRecoveryJournal(
                marker,
                authority,
                operationId,
                documentPath,
                documentLength,
                documentSha256,
                markPath,
                desiredPresent,
                desiredLength,
                desiredSha256,
                backupManifestPath,
                backupManifestLength,
                backupManifestSha256,
                backupSnapshotPath,
                createdAt,
            )
        } catch (error: Throwable) {
            registerNativeMarkRecoveryRequired(marker)
            return NativeMarkRecoveryInspection(
                null,
                true,
                "journal_invalid:${error.message}",
            )
        }
        registerNativeMarkRecoveryRequired(marker)
        return NativeMarkRecoveryInspection(journal, true, "journal_verified")
    }

    private fun requireNoNativeMarkRecoveryFence(pdfFile: File) {
        val inspection = inspectNativeMarkRecoveryFence(pdfFile)
        if (inspection.blocking) {
            throw NativeMarkRecoveryRequiredException(
                "Native annotation recovery remains fenced: ${inspection.reason}",
                IllegalStateException(inspection.reason),
            )
        }
    }

