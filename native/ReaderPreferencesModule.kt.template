package __PACKAGE__

import android.app.ActivityManager
import android.content.BroadcastReceiver
import android.content.Context
import android.content.Intent
import android.content.IntentFilter
import android.os.Build
import android.os.Handler
import android.os.Looper
import android.net.Uri
import android.os.SystemClock
import android.system.Os
import android.system.OsConstants
import android.util.Log
import com.facebook.react.bridge.Arguments
import com.facebook.react.bridge.Promise
import com.facebook.react.bridge.ReactApplicationContext
import com.facebook.react.bridge.ReactContextBaseJavaModule
import com.facebook.react.bridge.ReactMethod
import org.json.JSONObject
import java.io.ByteArrayOutputStream
import java.io.File
import java.io.FileInputStream
import java.io.FileOutputStream
import java.io.ObjectInputStream
import java.io.ObjectOutputStream
import java.util.Properties
import java.util.UUID
import java.util.concurrent.atomic.AtomicBoolean

class ReaderPreferencesModule(
    reactContext: ReactApplicationContext,
) : ReactContextBaseJavaModule(reactContext) {

    companion object {
        private const val STORE_NAME = "supernote_rtl_reader_preferences"
        private const val LOG_TAG = "RTL_READER"
        private const val DOCUMENT_PACKAGE = "com.supernote.document"
        private const val DOCUMENT_ACTIVITY =
            "com.supernote.document.document.DocumentActivity"
        private const val NATIVE_SPREAD_PACKAGE =
            "com.techrebbe.supernote.spreadprobe"
        private const val PLUGIN_HOST_PACKAGE = "com.ratta.supernote.pluginhost"
        private const val NATIVE_SPREAD_MIN_VERSION_CODE = 62L
        private const val NATIVE_SPREAD_MARKER_SUFFIX = ".snspread"
        private const val NATIVE_SPREAD_HANDSHAKE_PROTOCOL = 1
        private const val NATIVE_SPREAD_HANDSHAKE_TIMEOUT_MS = 1500L
        private const val NATIVE_SPREAD_HANDSHAKE_REQUEST =
            "com.techrebbe.supernote.spreadprobe.HANDSHAKE_REQUEST"
        private const val NATIVE_SPREAD_HANDSHAKE_RESPONSE =
            "com.techrebbe.supernote.spreadprobe.HANDSHAKE_RESPONSE"
        private const val HANDSHAKE_EXTRA_NONCE = "nonce"
        private const val HANDSHAKE_EXTRA_DOCUMENT_PATH = "documentPath"
        private const val HANDSHAKE_EXTRA_PROTOCOL = "protocol"
        private const val HANDSHAKE_EXTRA_HOOKS_READY = "hooksReady"
        private const val HANDSHAKE_EXTRA_MODULE_VERSION_CODE = "moduleVersionCode"
        private const val HANDSHAKE_EXTRA_DOCUMENT_APK_LENGTH = "documentApkLength"
        private const val HANDSHAKE_EXTRA_PROCESS_ID = "processId"
        private const val SUPPORTED_FINGERPRINT =
            "Supernote/Supernote/Supernote:11/RQ2A.210505.003/eng.supern.20260616.100032:user/release-keys"
        private const val SUPPORTED_DOCUMENT_VERSION_CODE = 102446L
        private const val SUPPORTED_DOCUMENT_APK_LENGTH = 138486560L

        private val DOCUMENT_CACHE_ROOTS = arrayOf(
            "/data/data/com.supernote.document/document_internal_cache",
            "/data/data/com.supernote.document/document_external_cache",
        )
    }

    private val preferences by lazy {
        reactApplicationContext.getSharedPreferences(STORE_NAME, Context.MODE_PRIVATE)
    }

    @Volatile
    private var lastSavedFilePath: String? = null

    override fun getName(): String = "ReaderPreferencesModule"

    @ReactMethod
    fun load(filePath: String, promise: Promise) {
        try {
            promise.resolve(preferences.getString(filePath, null))
        } catch (error: Throwable) {
            promise.reject("READER_PREFS_LOAD_FAILED", error.message, error)
        }
    }

    @ReactMethod
    fun save(filePath: String, json: String, promise: Promise) {
        try {
            val saved = preferences.edit().putString(filePath, json).commit()
            if (!saved) {
                throw IllegalStateException("SharedPreferences commit returned false")
            }
            lastSavedFilePath = filePath
            promise.resolve(true)
        } catch (error: Throwable) {
            promise.reject("READER_PREFS_SAVE_FAILED", error.message, error)
        }
    }

    @ReactMethod
    fun remove(filePath: String, promise: Promise) {
        try {
            val removed = preferences.edit().remove(filePath).commit()
            if (!removed) {
                throw IllegalStateException("SharedPreferences commit returned false")
            }
            if (lastSavedFilePath == filePath) {
                lastSavedFilePath = null
            }
            promise.resolve(true)
        } catch (error: Throwable) {
            promise.reject("READER_PREFS_REMOVE_FAILED", error.message, error)
        }
    }

    @ReactMethod
    fun loadNativeSpreadMode(filePath: String, promise: Promise) {
        try {
            val pdfFile = requirePdf(filePath)
            val marker = nativeSpreadMarker(pdfFile)
            val properties = Properties()
            if (marker.isFile) {
                FileInputStream(marker).use { input -> properties.load(input) }
            }

            val enabled = properties.getProperty("enabled", "false")
                .equals("true", ignoreCase = true) &&
                properties.getProperty("direction", "")
                    .equals("rtl", ignoreCase = true)
            val editable = enabled && properties.getProperty("editable", "false")
                .equals("true", ignoreCase = true)
            val coverSeparate = properties.getProperty("coverSeparate", "false")
                .equals("true", ignoreCase = true)
            val capability = nativeSpreadCapability()

            if (!capability.compatible) {
                resolveNativeSpreadMode(
                    promise,
                    enabled,
                    editable,
                    coverSeparate,
                    marker,
                    capability,
                    NativeSpreadHandshake(false, "package_incompatible"),
                )
                return
            }

            requestNativeSpreadHandshake(pdfFile) { handshake ->
                resolveNativeSpreadMode(
                    promise,
                    enabled,
                    editable,
                    coverSeparate,
                    marker,
                    capability,
                    handshake,
                )
            }
        } catch (error: Throwable) {
            promise.reject("NATIVE_SPREAD_LOAD_FAILED", error.message, error)
        }
    }

    @ReactMethod
    fun configureNativeSpreadReadOnly(
        filePath: String,
        enabled: Boolean,
        coverSeparate: Boolean,
        promise: Promise,
    ) {
        try {
            val pdfFile = requirePdf(filePath)
            val marker = nativeSpreadMarker(pdfFile)
            val capability = nativeSpreadCapability()

            if (enabled && !capability.compatible) {
                throw IllegalStateException(
                    "Compatible Native Spread module is not active for this firmware",
                )
            }

            if (!enabled) {
                if (marker.exists() && !marker.delete()) {
                    throw IllegalStateException(
                        "Could not remove native spread setting: ${marker.absolutePath}",
                    )
                }
                Log.i(LOG_TAG, "RTL_READER_NATIVE_SPREAD_CONFIG enabled=false marker=${marker.absolutePath}")
                promise.resolve(false)
                return
            }

            requestNativeSpreadHandshake(pdfFile) { handshake ->
                if (!handshake.active) {
                    val error = IllegalStateException(
                        "Native Spread hooks did not answer the live safety check: ${handshake.reason}",
                    )
                    Log.e(
                        LOG_TAG,
                        "RTL_READER_NATIVE_SPREAD_CONFIG_FAILED: ${error.message}",
                        error,
                    )
                    promise.reject(
                        "NATIVE_SPREAD_HANDSHAKE_FAILED",
                        error.message,
                        error,
                    )
                    return@requestNativeSpreadHandshake
                }

                try {
                    writeNativeSpreadReadOnlyMarker(
                        marker,
                        coverSeparate,
                        handshake,
                    )
                    promise.resolve(true)
                } catch (error: Throwable) {
                    Log.e(
                        LOG_TAG,
                        "RTL_READER_NATIVE_SPREAD_CONFIG_FAILED: ${error.message}",
                        error,
                    )
                    promise.reject(
                        "NATIVE_SPREAD_CONFIG_FAILED",
                        error.message,
                        error,
                    )
                }
            }
        } catch (error: Throwable) {
            Log.e(LOG_TAG, "RTL_READER_NATIVE_SPREAD_CONFIG_FAILED: ${error.message}", error)
            promise.reject("NATIVE_SPREAD_CONFIG_FAILED", error.message, error)
        }
    }

    private fun writeNativeSpreadReadOnlyMarker(
        marker: File,
        coverSeparate: Boolean,
        handshake: NativeSpreadHandshake,
    ) {
        check(handshake.active) { "Native Spread live safety check was not active" }

        val properties = Properties().apply {
            setProperty("enabled", "true")
            setProperty("direction", "rtl")
            setProperty("coverSeparate", coverSeparate.toString())
            setProperty("editable", "false")
            setProperty("disposable", "false")
            setProperty("managedBy", "supernote-rtl-reader")
            setProperty("mode", "read-only-pilot")
        }
        val temporary = File(
            marker.parentFile,
            "${marker.name}.tmp-${android.os.Process.myPid()}",
        )
        try {
            FileOutputStream(temporary, false).use { output ->
                properties.store(output, "Supernote RTL native reader settings")
                output.flush()
                output.fd.sync()
            }
            Os.rename(temporary.absolutePath, marker.absolutePath)
        } finally {
            if (temporary.exists()) temporary.delete()
        }

        val verified = Properties()
        FileInputStream(marker).use { input -> verified.load(input) }
        if (!verified.getProperty("enabled", "false")
                .equals("true", ignoreCase = true) ||
            !verified.getProperty("direction", "")
                .equals("rtl", ignoreCase = true) ||
            !verified.getProperty("editable", "true")
                .equals("false", ignoreCase = true)
        ) {
            throw IllegalStateException("Native spread setting verification failed")
        }

        Log.i(
            LOG_TAG,
            "RTL_READER_NATIVE_SPREAD_CONFIG enabled=true editable=false cover=$coverSeparate hooksActive=true processId=${handshake.processId} marker=${marker.absolutePath}",
        )
    }

    private fun resolveNativeSpreadMode(
        promise: Promise,
        enabled: Boolean,
        editable: Boolean,
        coverSeparate: Boolean,
        marker: File,
        capability: NativeSpreadCapability,
        handshake: NativeSpreadHandshake,
    ) {
        val runtimeCompatible = capability.compatible && handshake.active
        val result = Arguments.createMap().apply {
            putBoolean("configured", enabled)
            putBoolean("enabled", enabled && runtimeCompatible)
            putBoolean("editable", editable && runtimeCompatible)
            putBoolean("coverSeparate", coverSeparate)
            putString("markerPath", marker.absolutePath)
            putBoolean("compatible", runtimeCompatible)
            putBoolean("hooksActive", handshake.active)
            putString("handshakeReason", handshake.reason)
            putDouble("handshakeProtocol", handshake.protocol.toDouble())
            putDouble("handshakeProcessId", handshake.processId.toDouble())
            putBoolean("moduleInstalled", capability.moduleVersionCode >= 0L)
            putDouble("moduleVersionCode", capability.moduleVersionCode.toDouble())
            putString("moduleVersionName", capability.moduleVersionName)
            putDouble(
                "documentVersionCode",
                capability.documentVersionCode.toDouble(),
            )
            putString("firmwareFingerprint", Build.FINGERPRINT)
        }
        Log.i(
            LOG_TAG,
            "RTL_READER_NATIVE_SPREAD_HANDSHAKE active=${handshake.active} reason=${handshake.reason} protocol=${handshake.protocol} processId=${handshake.processId}",
        )
        promise.resolve(result)
    }

    private data class NativeSpreadCapability(
        val compatible: Boolean,
        val moduleVersionCode: Long,
        val moduleVersionName: String?,
        val documentVersionCode: Long,
    )

    private data class NativeSpreadHandshake(
        val active: Boolean,
        val reason: String,
        val protocol: Int = -1,
        val processId: Int = -1,
    )

    @Suppress("DEPRECATION")
    private fun packageVersionCode(packageName: String): Pair<Long, String?> {
        val info = reactApplicationContext.packageManager.getPackageInfo(packageName, 0)
        val code = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
            info.longVersionCode
        } else {
            info.versionCode.toLong()
        }
        return code to info.versionName
    }

    private fun requestNativeSpreadHandshake(
        pdfFile: File,
        callback: (NativeSpreadHandshake) -> Unit,
    ) {
        if (reactApplicationContext.packageName != PLUGIN_HOST_PACKAGE) {
            callback(NativeSpreadHandshake(false, "unexpected_plugin_host"))
            return
        }

        val expectedPath = try {
            pdfFile.canonicalPath
        } catch (error: Throwable) {
            callback(NativeSpreadHandshake(false, "document_path_unavailable"))
            return
        }
        val nonce = UUID.randomUUID().toString()
        val completed = AtomicBoolean(false)
        val handler = Handler(Looper.getMainLooper())
        var receiver: BroadcastReceiver? = null
        var timeout: Runnable? = null

        val finish: (NativeSpreadHandshake) -> Unit = { result ->
            if (completed.compareAndSet(false, true)) {
                timeout?.let(handler::removeCallbacks)
                receiver?.let { registered ->
                    try {
                        reactApplicationContext.unregisterReceiver(registered)
                    } catch (_: Throwable) {
                        // The receiver may already have been removed during teardown.
                    }
                }
                callback(result)
            }
        }

        receiver = object : BroadcastReceiver() {
            override fun onReceive(context: Context?, intent: Intent?) {
                if (intent?.action != NATIVE_SPREAD_HANDSHAKE_RESPONSE ||
                    intent.getStringExtra(HANDSHAKE_EXTRA_NONCE) != nonce
                ) {
                    return
                }

                val protocol = intent.getIntExtra(HANDSHAKE_EXTRA_PROTOCOL, -1)
                val hooksReady = intent.getBooleanExtra(
                    HANDSHAKE_EXTRA_HOOKS_READY,
                    false,
                )
                val moduleVersionCode = intent.getLongExtra(
                    HANDSHAKE_EXTRA_MODULE_VERSION_CODE,
                    -1L,
                )
                val documentApkLength = intent.getLongExtra(
                    HANDSHAKE_EXTRA_DOCUMENT_APK_LENGTH,
                    -1L,
                )
                val processId = intent.getIntExtra(
                    HANDSHAKE_EXTRA_PROCESS_ID,
                    -1,
                )
                val reportedPath = intent.getStringExtra(
                    HANDSHAKE_EXTRA_DOCUMENT_PATH,
                )
                val canonicalReportedPath = try {
                    reportedPath?.let { File(it).canonicalPath }
                } catch (_: Throwable) {
                    null
                }

                val valid = hooksReady &&
                    protocol == NATIVE_SPREAD_HANDSHAKE_PROTOCOL &&
                    moduleVersionCode >= NATIVE_SPREAD_MIN_VERSION_CODE &&
                    documentApkLength == SUPPORTED_DOCUMENT_APK_LENGTH &&
                    processId > 0 &&
                    canonicalReportedPath == expectedPath
                finish(
                    NativeSpreadHandshake(
                        valid,
                        if (valid) "ok" else "invalid_response",
                        protocol,
                        processId,
                    ),
                )
            }
        }

        timeout = Runnable {
            finish(NativeSpreadHandshake(false, "timeout"))
        }

        try {
            reactApplicationContext.registerReceiver(
                receiver,
                IntentFilter(NATIVE_SPREAD_HANDSHAKE_RESPONSE),
            )
            handler.postDelayed(
                timeout,
                NATIVE_SPREAD_HANDSHAKE_TIMEOUT_MS,
            )
            reactApplicationContext.sendBroadcast(
                Intent(NATIVE_SPREAD_HANDSHAKE_REQUEST).apply {
                    setPackage(DOCUMENT_PACKAGE)
                    putExtra(HANDSHAKE_EXTRA_NONCE, nonce)
                    putExtra(HANDSHAKE_EXTRA_DOCUMENT_PATH, expectedPath)
                    putExtra(
                        HANDSHAKE_EXTRA_PROTOCOL,
                        NATIVE_SPREAD_HANDSHAKE_PROTOCOL,
                    )
                },
            )
            Log.i(
                LOG_TAG,
                "RTL_READER_NATIVE_SPREAD_HANDSHAKE_REQUEST path=$expectedPath",
            )
        } catch (error: Throwable) {
            Log.e(
                LOG_TAG,
                "RTL_READER_NATIVE_SPREAD_HANDSHAKE_REQUEST_FAILED: ${error.message}",
                error,
            )
            finish(NativeSpreadHandshake(false, "request_failed"))
        }
    }

    private fun nativeSpreadCapability(): NativeSpreadCapability {
        val module = try {
            packageVersionCode(NATIVE_SPREAD_PACKAGE)
        } catch (_: Throwable) {
            -1L to null
        }
        val document = try {
            packageVersionCode(DOCUMENT_PACKAGE).first
        } catch (_: Throwable) {
            -1L
        }
        val compatible = Build.FINGERPRINT == SUPPORTED_FINGERPRINT &&
            document == SUPPORTED_DOCUMENT_VERSION_CODE &&
            module.first >= NATIVE_SPREAD_MIN_VERSION_CODE
        return NativeSpreadCapability(
            compatible,
            module.first,
            module.second,
            document,
        )
    }

    private fun requirePdf(filePath: String): File {
        val file = File(filePath)
        if (!file.isFile || !file.name.endsWith(".pdf", ignoreCase = true)) {
            throw IllegalStateException("Current PDF is not accessible: $filePath")
        }
        return file
    }

    private fun nativeSpreadMarker(pdfFile: File): File {
        val parent = pdfFile.parentFile
            ?: throw IllegalStateException("Current PDF has no parent directory")
        return File(parent, ".${pdfFile.name}$NATIVE_SPREAD_MARKER_SUFFIX")
    }

    /**
     * Experimental native-reader handoff.
     *
     * Hardware testing established that Supernote stores the native PDF position
     * in a Java-serialized HashMap and that PluginHost and SupernoteDocument both
     * run as UID 1000. The config update therefore needs no su access. v0.0.9
     * also avoids invoking the `am` shell utility: after PluginHost closes, a
     * background worker signals only the com.supernote.document PID and then
     * starts its private DocumentActivity directly through Android APIs.
     */
    @ReactMethod
    fun handoffLastSavedPage(promise: Promise) {
        var configFile: File? = null
        var originalBytes: ByteArray? = null
        var wroteConfig = false

        try {
            val filePath = lastSavedFilePath
                ?: throw IllegalStateException("No PDF has been saved in this reader session")
            // Consume the session path immediately. A later activation must save
            // its own path before another handoff can occur.
            lastSavedFilePath = null

            val savedJson = preferences.getString(filePath, null)
                ?: throw IllegalStateException("No saved reader preferences for current PDF")
            val pageIndex = JSONObject(savedJson).optInt("lastPageIndex", -1)
            if (pageIndex < 0) {
                throw IllegalStateException("Saved reader state has no valid lastPageIndex")
            }

            val pdfFile = File(filePath)
            if (!pdfFile.isFile) {
                throw IllegalStateException("Current PDF is not accessible: $filePath")
            }

            val inode = Os.stat(pdfFile.absolutePath).st_ino.toString()
            configFile = findMatchingConfig(pdfFile, inode)
            originalBytes = configFile.readBytes()

            val configMap = readConfigMap(configFile)
            val oldPage = configMap["currentPage"] as? String
                ?: throw IllegalStateException("Native config currentPage is not a String")

            configMap["currentPage"] = pageIndex.toString()
            val updatedBytes = serializeConfigMap(configMap)
            writeBytesSynced(configFile, updatedBytes)
            wroteConfig = true

            val verifiedMap = readConfigMap(configFile)
            val verifiedPage = verifiedMap["currentPage"] as? String
            if (verifiedPage != pageIndex.toString()) {
                throw IllegalStateException(
                    "Native config verification failed: expected $pageIndex, found $verifiedPage",
                )
            }
            verifyConfigIdentity(verifiedMap, pdfFile, inode)

            Log.i(
                LOG_TAG,
                "RTL_READER_HANDOFF_CONFIG_WRITTEN page=${pageIndex + 1} uid=${android.os.Process.myUid()} config=${configFile.absolutePath}",
            )

            scheduleDocumentRestart()

            val result = Arguments.createMap().apply {
                putString("filePath", pdfFile.absolutePath)
                putString("configPath", configFile.absolutePath)
                putString("inode", inode)
                putInt("pageIndex", pageIndex)
                putString("oldPage", oldPage)
                putInt("uid", android.os.Process.myUid())
            }
            promise.resolve(result)
        } catch (error: Throwable) {
            if (wroteConfig && configFile != null && originalBytes != null) {
                try {
                    writeBytesSynced(configFile, originalBytes)
                    Log.w(LOG_TAG, "RTL_READER_HANDOFF_CONFIG_RESTORED_AFTER_FAILURE")
                } catch (restoreError: Throwable) {
                    Log.e(
                        LOG_TAG,
                        "RTL_READER_HANDOFF_RESTORE_FAILED: ${restoreError.message}",
                        restoreError,
                    )
                }
            }
            Log.e(LOG_TAG, "RTL_READER_HANDOFF_FAILED: ${error.message}", error)
            promise.reject("READER_HANDOFF_FAILED", error.message, error)
        }
    }

    private fun findMatchingConfig(pdfFile: File, inode: String): File {
        var sawReadableRoot = false
        var sawCandidate = false

        for (rootPath in DOCUMENT_CACHE_ROOTS) {
            val root = File(rootPath)
            val children = root.listFiles()
            if (children == null) {
                continue
            }
            sawReadableRoot = true

            for (directory in children) {
                if (!directory.isDirectory || !directory.name.startsWith("${inode}_")) {
                    continue
                }
                val candidate = File(directory, "CONFIG/config.data")
                if (!candidate.isFile) {
                    continue
                }
                sawCandidate = true

                try {
                    val map = readConfigMap(candidate)
                    verifyConfigIdentity(map, pdfFile, inode)
                    return candidate
                } catch (_: Throwable) {
                    // A matching inode prefix is not enough; keep looking until
                    // both the serialized inode and URI identify this exact PDF.
                }
            }
        }

        if (!sawReadableRoot) {
            throw IllegalStateException(
                "PluginHost cannot read Supernote document cache as UID ${android.os.Process.myUid()}",
            )
        }
        if (sawCandidate) {
            throw IllegalStateException("Found inode candidate, but its URI did not match current PDF")
        }
        throw IllegalStateException("No native config found for PDF inode $inode")
    }

    private fun verifyConfigIdentity(
        map: MutableMap<Any?, Any?>,
        pdfFile: File,
        inode: String,
    ) {
        val storedInode = map["file_inode"] as? String
            ?: throw IllegalStateException("Native config file_inode is missing")
        if (storedInode != inode) {
            throw IllegalStateException(
                "Native config inode mismatch: expected $inode, found $storedInode",
            )
        }

        val storedUri = map["uri"] as? String
            ?: throw IllegalStateException("Native config URI is missing")
        val storedPath = Uri.parse(storedUri).path
            ?: throw IllegalStateException("Native config URI has no file path")

        val expectedPath = pdfFile.canonicalPath
        val actualPath = File(storedPath).canonicalPath
        if (expectedPath != actualPath) {
            throw IllegalStateException(
                "Native config URI mismatch: expected $expectedPath, found $actualPath",
            )
        }
    }

    @Suppress("UNCHECKED_CAST")
    private fun readConfigMap(file: File): MutableMap<Any?, Any?> {
        FileInputStream(file).use { stream ->
            ObjectInputStream(stream).use { input ->
                val value = input.readObject()
                if (value !is MutableMap<*, *>) {
                    throw IllegalStateException(
                        "Native config is ${value.javaClass.name}, expected MutableMap",
                    )
                }
                return value as MutableMap<Any?, Any?>
            }
        }
    }

    private fun serializeConfigMap(map: MutableMap<Any?, Any?>): ByteArray {
        val buffer = ByteArrayOutputStream()
        ObjectOutputStream(buffer).use { output ->
            output.writeObject(map)
            output.flush()
        }
        return buffer.toByteArray()
    }

    private fun writeBytesSynced(file: File, bytes: ByteArray) {
        FileOutputStream(file, false).use { output ->
            output.write(bytes)
            output.flush()
            output.fd.sync()
        }
    }

    private fun documentPids(activityManager: ActivityManager): List<Int> =
        activityManager.runningAppProcesses
            ?.asSequence()
            ?.filter { process -> process.processName == DOCUMENT_PACKAGE }
            ?.map { process -> process.pid }
            ?.filter { pid -> pid != android.os.Process.myPid() }
            ?.toList()
            ?: emptyList()

    private fun scheduleDocumentRestart() {
        Thread {
            try {
                Log.i(
                    LOG_TAG,
                    "RTL_READER_HANDOFF_WORKER_START uid=${android.os.Process.myUid()} pluginPid=${android.os.Process.myPid()}",
                )

                // Give closePluginView() time to return the native reader to the
                // foreground before replacing its process.
                SystemClock.sleep(900)

                val activityManager = reactApplicationContext.getSystemService(
                    Context.ACTIVITY_SERVICE,
                ) as ActivityManager
                val pids = documentPids(activityManager)
                Log.i(LOG_TAG, "RTL_READER_HANDOFF_DOCUMENT_PIDS ${pids.joinToString(",")}")

                for (pid in pids) {
                    try {
                        Os.kill(pid, OsConstants.SIGKILL)
                        Log.i(LOG_TAG, "RTL_READER_HANDOFF_KILL_SENT pid=$pid")
                    } catch (error: Throwable) {
                        Log.e(
                            LOG_TAG,
                            "RTL_READER_HANDOFF_KILL_FAILED pid=$pid: ${error.message}",
                            error,
                        )
                        throw error
                    }
                }

                if (pids.isNotEmpty()) {
                    val deadline = SystemClock.elapsedRealtime() + 2500L
                    var remaining = pids
                    while (remaining.isNotEmpty() && SystemClock.elapsedRealtime() < deadline) {
                        SystemClock.sleep(100)
                        val running = documentPids(activityManager).toSet()
                        remaining = pids.filter { pid -> pid in running }
                    }
                    if (remaining.isEmpty()) {
                        Log.i(LOG_TAG, "RTL_READER_HANDOFF_KILL_CONFIRMED")
                    } else {
                        Log.w(
                            LOG_TAG,
                            "RTL_READER_HANDOFF_KILL_NOT_CONFIRMED pids=${remaining.joinToString(",")}",
                        )
                    }
                } else {
                    Log.w(LOG_TAG, "RTL_READER_HANDOFF_NO_DOCUMENT_PID")
                }

                SystemClock.sleep(450)

                val intent = Intent().apply {
                    setClassName(DOCUMENT_PACKAGE, DOCUMENT_ACTIVITY)
                    addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TASK)
                }
                reactApplicationContext.startActivity(intent)
                Log.i(LOG_TAG, "RTL_READER_HANDOFF_START_REQUESTED_DIRECT")
            } catch (error: Throwable) {
                Log.e(
                    LOG_TAG,
                    "RTL_READER_HANDOFF_WORKER_FAILED: ${error.message}",
                    error,
                )
            }
        }.apply {
            name = "RtlReaderNativeHandoff"
            isDaemon = true
            start()
        }
    }
}
