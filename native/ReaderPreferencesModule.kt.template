    private fun failedActivationBackupManifest(
        pdfFile: File,
        activationToken: String,
    ): File {
        val parent = pdfFile.parentFile
            ?: throw IllegalStateException("Current PDF has no parent directory")
        return File(
            parent,
            ".${pdfFile.name}.snspread-failed-$activationToken.properties",
        )
    }

    private fun failedActivationBackupSnapshot(
        pdfFile: File,
        activationToken: String,
    ): File {
        val parent = pdfFile.parentFile
            ?: throw IllegalStateException("Current PDF has no parent directory")
        return File(
            parent,
            ".${pdfFile.name}.snspread-failed-$activationToken.mark",
        )
    }

    private fun failedActivationBackupSourceManifest(
        pdfFile: File,
        activationToken: String,
    ): File {
        val parent = pdfFile.parentFile
            ?: throw IllegalStateException("Current PDF has no parent directory")
        return File(
            parent,
            ".${pdfFile.name}.snspread-failed-$activationToken.source.properties",
        )
    }

    private fun failedActivationBackupArchive(
        pdfFile: File,
        activationToken: String,
    ): FailedActivationBackupArchive = FailedActivationBackupArchive(
        activationToken,
        failedActivationBackupManifest(pdfFile, activationToken),
        failedActivationBackupSourceManifest(pdfFile, activationToken),
        failedActivationBackupSnapshot(pdfFile, activationToken),
    )

    private fun readFailedActivationBackupEvidence(
        pdfFile: File,
        archive: FailedActivationBackupArchive,
    ): FailedActivationBackupEvidence? = runCatching {
        val canonicalToken =
            UUID.fromString(archive.activationToken).toString() ==
                archive.activationToken
        val expectedArchive = failedActivationBackupArchive(
            pdfFile,
            archive.activationToken,
        )
        if (!canonicalToken ||
            archive.manifest.canonicalPath != expectedArchive.manifest.canonicalPath ||
            archive.sourceManifest.canonicalPath !=
                expectedArchive.sourceManifest.canonicalPath ||
            archive.snapshot.canonicalPath != expectedArchive.snapshot.canonicalPath ||
            !archive.manifest.isFile ||
            !archive.sourceManifest.isFile
        ) {
            throw IllegalStateException("failed_archive_paths_invalid")
        }

        val archiveManifestBytes = archive.manifest.readBytes()
        val archiveManifestHash = sha256(archiveManifestBytes)
        val properties = Properties().apply {
            ByteArrayInputStream(archiveManifestBytes).use { input -> load(input) }
        }
        if (properties.getProperty("version", "") !=
                NATIVE_SPREAD_FAILED_ARCHIVE_VERSION.toString() ||
            properties.getProperty("kind", "") !=
                NATIVE_SPREAD_FAILED_ARCHIVE_KIND ||
            properties.getProperty("managedBy", "") !=
                "supernote-rtl-reader" ||
            properties.getProperty("activationToken", "") !=
                archive.activationToken ||
            File(properties.getProperty("sourceManifestPath", "")).canonicalPath !=
                archive.sourceManifest.canonicalPath ||
            File(properties.getProperty("snapshotPath", "")).canonicalPath !=
                archive.snapshot.canonicalPath
        ) {
            throw IllegalStateException("failed_archive_attestation_invalid")
        }

        val sourceManifestBytes = archive.sourceManifest.readBytes()
        val sourceManifestLength = properties.getProperty(
            "sourceManifestLength",
        )?.toLongOrNull() ?: throw IllegalStateException(
            "failed_archive_source_length_invalid",
        )
        val sourceManifestHash = properties.getProperty(
            "sourceManifestSha256",
            "",
        )
        if (sourceManifestBytes.size.toLong() != sourceManifestLength ||
            sha256(sourceManifestBytes) != sourceManifestHash
        ) {
            throw IllegalStateException("failed_archive_source_bytes_invalid")
        }

        val sourceProperties = Properties().apply {
            ByteArrayInputStream(sourceManifestBytes).use { input -> load(input) }
        }
        val documentPath = File(
            properties.getProperty("documentPath", ""),
        ).canonicalPath
        val documentLength = properties.getProperty("documentLength")?.toLongOrNull()
            ?: throw IllegalStateException("failed_archive_document_length_invalid")
        val documentHash = properties.getProperty("documentSha256", "")
        val markPath = File(properties.getProperty("markPath", "")).canonicalPath
        val canonicalManifestPath = File(
            properties.getProperty("canonicalManifestPath", ""),
        ).canonicalPath
        val canonicalSnapshotPath = File(
            properties.getProperty("canonicalSnapshotPath", ""),
        ).canonicalPath
        val originalMarkText = properties.getProperty("originalMarkPresent", "")
        if (originalMarkText != "true" && originalMarkText != "false") {
            throw IllegalStateException("failed_archive_original_presence_invalid")
        }
        val originalMarkPresent = originalMarkText == "true"
        val markLength = properties.getProperty("markLength")?.toLongOrNull()
            ?: throw IllegalStateException("failed_archive_mark_length_invalid")
        val markHash = properties.getProperty("markSha256", "")
        val createdAt = properties.getProperty("createdAt")?.toLongOrNull()
            ?: throw IllegalStateException("failed_archive_created_at_invalid")

        if (sourceManifestLength < 0L ||
            sourceManifestHash.length != 64 ||
            documentLength < 0L ||
            documentHash.length != 64 ||
            markLength < 0L ||
            (originalMarkPresent && markHash.length != 64) ||
            createdAt < 0L ||
            documentPath != pdfFile.canonicalPath ||
            canonicalManifestPath !=
                nativeAnnotationBackupManifest(pdfFile).canonicalPath ||
            canonicalSnapshotPath !=
                nativeAnnotationBackupSnapshot(pdfFile).canonicalPath ||
            markPath != nativeAnnotationMark(pdfFile).canonicalPath ||
            sourceProperties.getProperty("version", "") !=
                NATIVE_SPREAD_BACKUP_VERSION.toString() ||
            sourceProperties.getProperty("managedBy", "") !=
                "supernote-rtl-reader" ||
            File(sourceProperties.getProperty("documentPath", "")).canonicalPath !=
                documentPath ||
            sourceProperties.getProperty("documentLength")?.toLongOrNull() !=
                documentLength ||
            sourceProperties.getProperty("documentSha256", "") != documentHash ||
            File(sourceProperties.getProperty("markPath", "")).canonicalPath !=
                markPath ||
            File(sourceProperties.getProperty("snapshotPath", "")).canonicalPath !=
                canonicalSnapshotPath ||
            sourceProperties.getProperty("originalMarkPresent", "") !=
                originalMarkPresent.toString() ||
            sourceProperties.getProperty("markLength")?.toLongOrNull() != markLength ||
            sourceProperties.getProperty("markSha256", "") != markHash ||
            sourceProperties.getProperty("createdAt")?.toLongOrNull() != createdAt
        ) {
            throw IllegalStateException("failed_archive_source_identity_invalid")
        }

        if (originalMarkPresent) {
            if (!archive.snapshot.isFile ||
                archive.snapshot.length() != markLength ||
                sha256(archive.snapshot) != markHash
            ) {
                throw IllegalStateException("failed_archive_snapshot_bytes_invalid")
            }
        } else if (archive.snapshot.exists() ||
            markLength != 0L ||
            markHash != "ABSENT"
        ) {
            throw IllegalStateException("failed_archive_absent_snapshot_invalid")
        }

        if (archive.manifest.length() != archiveManifestBytes.size.toLong() ||
            sha256(archive.manifest) != archiveManifestHash ||
            archive.sourceManifest.length() != sourceManifestLength ||
            sha256(archive.sourceManifest) != sourceManifestHash
        ) {
            throw IllegalStateException("failed_archive_changed_during_verification")
        }

        FailedActivationBackupEvidence(
            archive,
            sourceManifestLength,
            sourceManifestHash,
            documentPath,
            documentLength,
            documentHash,
            markPath,
            canonicalManifestPath,
            canonicalSnapshotPath,
            originalMarkPresent,
            markLength,
            markHash,
            createdAt,
        )
    }.getOrNull()

    private fun failedActivationEvidenceMatchesBackup(
        evidence: FailedActivationBackupEvidence,
        backup: NativeAnnotationBackup,
    ): Boolean =
        evidence.sourceManifestLength == backup.manifestLength &&
            evidence.sourceManifestSha256 == backup.manifestSha256 &&
            evidence.documentPath == backup.documentPath &&
            evidence.documentLength == backup.documentLength &&
            evidence.documentSha256 == backup.documentSha256 &&
            evidence.markPath == backup.mark.canonicalPath &&
            evidence.canonicalManifestPath == backup.manifest.canonicalPath &&
            evidence.canonicalSnapshotPath == backup.snapshot.canonicalPath &&
            evidence.originalMarkPresent == backup.originalMarkPresent &&
            evidence.markLength == backup.markLength &&
            evidence.markSha256 == backup.markSha256 &&
            evidence.createdAt == backup.createdAt

    private fun failedActivationBackupArchived(
        pdfFile: File,
        archive: FailedActivationBackupArchive,
    ): Boolean = readFailedActivationBackupEvidence(pdfFile, archive) != null

    private fun archiveFailedActivationBackup(
        pdfFile: File,
        backup: NativeAnnotationBackup,
        activationToken: String,
    ): FailedActivationBackupArchive {
        val archive = failedActivationBackupArchive(pdfFile, activationToken)
        val canonicalToken = runCatching {
            UUID.fromString(activationToken).toString() == activationToken
        }.getOrDefault(false)
        if (!canonicalToken || !nativeAnnotationBackupSourceFilesMatch(backup)) {
            throw IllegalStateException(
                "Failed-activation recovery evidence changed before archival",
            )
        }
        var archiveVerified = false
        var manifestCreated = false
        var sourceManifestCreated = false
        var snapshotCreated = false
        try {
            val existingEvidence = readFailedActivationBackupEvidence(pdfFile, archive)
            if (existingEvidence != null) {
                if (!failedActivationEvidenceMatchesBackup(existingEvidence, backup)) {
                    throw IllegalStateException(
                        "Failed-activation evidence for this token names a different backup",
                    )
                }
                archiveVerified = true
            } else {
                // A published attestation that cannot be verified is ambiguous.
                // Never overwrite it or guess which of its referenced files is
                // authoritative. Exact pre-attestation files may, however, be
                // resumed after a process death while the canonical backup and
                // owning activation marker still prove their identity.
                if (archive.manifest.exists()) {
                    throw IllegalStateException(
                        "Failed-activation attestation for this token is invalid",
                    )
                }
                if (archive.sourceManifest.exists()) {
                    if (!archive.sourceManifest.isFile ||
                        archive.sourceManifest.length() != backup.manifestLength ||
                        sha256(archive.sourceManifest) != backup.manifestSha256
                    ) {
                        throw IllegalStateException(
                            "Partial failed-activation source manifest is ambiguous",
                        )
                    }
                } else {
                    sourceManifestCreated = true
                    copyFileAtomically(backup.manifest, archive.sourceManifest)
                }
                if (backup.originalMarkPresent) {
                    if (archive.snapshot.exists()) {
                        if (!archive.snapshot.isFile ||
                            archive.snapshot.length() != backup.markLength ||
                            sha256(archive.snapshot) != backup.markSha256
                        ) {
                            throw IllegalStateException(
                                "Partial failed-activation snapshot is ambiguous",
                            )
                        }
                    } else {
                        snapshotCreated = true
                        copyFileAtomically(backup.snapshot, archive.snapshot)
                    }
                } else if (archive.snapshot.exists()) {
                    throw IllegalStateException(
                        "Partial failed-activation snapshot conflicts with an absent mark",
                    )
                }

                if (archive.sourceManifest.length() != backup.manifestLength ||
                    sha256(archive.sourceManifest) != backup.manifestSha256 ||
                    (
                        backup.originalMarkPresent &&
                            (
                                archive.snapshot.length() != backup.markLength ||
                                    sha256(archive.snapshot) != backup.markSha256
                            )
                        )
                ) {
                    throw IllegalStateException(
                        "Failed-activation recovery bytes changed before attestation",
                    )
                }

                val archiveProperties = Properties().apply {
                    setProperty("version", NATIVE_SPREAD_FAILED_ARCHIVE_VERSION.toString())
                    setProperty("kind", NATIVE_SPREAD_FAILED_ARCHIVE_KIND)
                    setProperty("managedBy", "supernote-rtl-reader")
                    setProperty("activationToken", activationToken)
                    setProperty("documentPath", backup.documentPath)
                    setProperty("documentLength", backup.documentLength.toString())
                    setProperty("documentSha256", backup.documentSha256)
                    setProperty("markPath", backup.mark.canonicalPath)
                    setProperty("canonicalManifestPath", backup.manifest.canonicalPath)
                    setProperty("canonicalSnapshotPath", backup.snapshot.canonicalPath)
                    setProperty("sourceManifestPath", archive.sourceManifest.canonicalPath)
                    setProperty("sourceManifestLength", backup.manifestLength.toString())
                    setProperty("sourceManifestSha256", backup.manifestSha256)
                    setProperty("snapshotPath", archive.snapshot.canonicalPath)
                    setProperty("originalMarkPresent", backup.originalMarkPresent.toString())
                    setProperty("markLength", backup.markLength.toString())
                    setProperty("markSha256", backup.markSha256)
                    setProperty("createdAt", backup.createdAt.toString())
                }
                // Publish the self-contained attestation last. Its presence alone
                // is not trusted; every referenced byte and identity is reread.
                manifestCreated = true
                writePropertiesAtomically(
                    archive.manifest,
                    archiveProperties,
                    "Supernote RTL failed activation recovery evidence",
                )
                val evidence = readFailedActivationBackupEvidence(pdfFile, archive)
                if (evidence == null ||
                    !failedActivationEvidenceMatchesBackup(evidence, backup)
                ) {
                    throw IllegalStateException(
                        "Failed-activation evidence verification failed",
                    )
                }
                archiveVerified = true
            }
            if (!nativeAnnotationBackupSourceFilesMatch(backup)) {
                throw IllegalStateException(
                    "Canonical recovery evidence changed during archival",
                )
            }
            removeNativeAnnotationBackupFiles(pdfFile, backup)
            if (nativeAnnotationBackupManifest(pdfFile).exists() ||
                nativeAnnotationBackupSnapshot(pdfFile).exists() ||
                nativeAnnotationRetiringSnapshot(pdfFile).exists() ||
                readFailedActivationBackupEvidence(pdfFile, archive)?.let { verified ->
                    failedActivationEvidenceMatchesBackup(verified, backup)
                } != true
            ) {
                throw IllegalStateException(
                    "Failed-activation evidence or canonical retirement could not be verified",
                )
            }
            Log.w(
                LOG_TAG,
                "RTL_READER_NATIVE_EDITABLE_ACTIVATION_BACKUP_ARCHIVED token=$activationToken attestation=${archive.manifest.absolutePath} sourceManifest=${archive.sourceManifest.absolutePath} sourceManifestSha256=${backup.manifestSha256} snapshot=${if (backup.originalMarkPresent) archive.snapshot.absolutePath else "ABSENT"} snapshotSha256=${backup.markSha256}",
            )
            return archive
        } catch (error: Throwable) {
            // A verified archive is permanent recovery evidence, including
            // when canonical retirement later fails. Only files that never
            // formed a verified self-contained set in this invocation are
            // eligible for cleanup. Preexisting partial evidence is preserved
            // exactly so a later owning-token retry can attest it or fail closed.
            if (!archiveVerified) {
                if (manifestCreated && !deleteFileDurably(archive.manifest)
                ) {
                    error.addSuppressed(
                        IllegalStateException(
                            "Could not remove partial failed-activation manifest",
                        ),
                    )
                }
                if (sourceManifestCreated && !deleteFileDurably(archive.sourceManifest)
                ) {
                    error.addSuppressed(
                        IllegalStateException(
                            "Could not remove partial failed-activation source manifest",
                        ),
                    )
                }
                if (snapshotCreated && !deleteFileDurably(archive.snapshot)
                ) {
                    error.addSuppressed(
                        IllegalStateException(
                            "Could not remove partial failed-activation snapshot",
                        ),
                    )
                }
            }
            throw error
        }
    }

    private fun failedActivationArchiveTokens(pdfFile: File): List<String> {
        val parent = pdfFile.parentFile
            ?: throw IllegalStateException("Current PDF has no parent directory")
        val files = parent.listFiles()
            ?: throw IllegalStateException(
                "Could not inspect failed-activation recovery evidence",
            )
        val prefix = ".${pdfFile.name}.snspread-failed-"
        return files.asSequence()
            .map { file -> file.name }
            .filter { name -> name.startsWith(prefix) }
            .mapNotNull { name ->
                val remainder = name.removePrefix(prefix)
                remainder.substringBefore('.').takeIf { token -> token.isNotEmpty() }
            }
            .filter { token ->
                runCatching {
                    UUID.fromString(token).toString() == token
                }.getOrDefault(false)
            }
            .distinct()
            .sorted()
            .toList()
    }

    private fun restorePendingActivationPreviousMarker(
        marker: File,
        pending: PendingEditableActivation,
    ) {
        val previousBytes = pending.previousMarkerBytes
        if (previousBytes == null) {
            if (!deleteFileDurably(marker)) {
                throw IllegalStateException(
                    "Could not remove the interrupted pending activation marker",
                )
            }
        } else {
            writeBytesAtomically(marker, previousBytes)
        }
        val restored = if (previousBytes == null) {
            !marker.exists()
        } else {
            readPersistedBytesIfFile(marker)?.contentEquals(previousBytes) == true
        }
        if (!restored) {
            throw IllegalStateException(
                "Interrupted activation's previous marker could not be restored",
            )
        }
    }

    private fun markerClaimsProtectedEditable(
        properties: Properties,
    ): Boolean =
        properties.getProperty("enabled", "false").equals("true", true) &&
            properties.getProperty("direction", "").equals("rtl", true) &&
            properties.getProperty("editable", "false").equals("true", true) &&
            !properties.getProperty("disposable", "false").equals("true", true) &&
            properties.getProperty("managedBy", "") == "supernote-rtl-reader" &&
            (
                properties.getProperty("mode", "") == NATIVE_SPREAD_EDITABLE_MODE ||
                    properties.getProperty("mode", "") ==
                    NATIVE_SPREAD_LEGACY_EDITABLE_MODE
                )

    private fun pendingPreviousMarkerMatchesIdentity(
        pdfFile: File,
        pending: PendingEditableActivation,
    ): Boolean = runCatching {
        val bytes = pending.previousMarkerBytes
            ?: throw IllegalStateException("pending_previous_marker_missing")
        val properties = strictNativeSpreadMarkerProperties(bytes)
        if (!markerClaimsProtectedEditable(properties) ||
            !properties.getProperty("backupVerified", "false")
                .equals("true", true) ||
            File(properties.getProperty("documentPath", "")).canonicalPath !=
                pdfFile.canonicalPath ||
            File(properties.getProperty("backupManifestPath", "")).canonicalPath !=
                pending.backupManifestPath ||
            properties.getProperty("backupManifestSha256", "") !=
                pending.backupManifestSha256
        ) {
            false
        } else if (properties.getProperty("mode", "") ==
            NATIVE_SPREAD_LEGACY_EDITABLE_MODE
        ) {
            true
        } else {
            val activationToken = properties.getProperty("activationToken", "")
            val pendingOnlyKeys = listOf(
                "pendingIntent",
                "previousMarkerPresent",
                "previousMarkerProtected",
                "previousMarkerLength",
                "previousMarkerSha256",
                "previousMarkerBase64",
            )
            UUID.fromString(activationToken).toString() == activationToken &&
                properties.getProperty("transactionProtocol", "") ==
                    NATIVE_SPREAD_EDITABLE_MARKER_PROTOCOL.toString() &&
                properties.getProperty("minimumModuleVersionCode", "") ==
                    NATIVE_READER_V2_MIN_VERSION_CODE.toString() &&
                properties.getProperty("activationState", "") ==
                    NATIVE_SPREAD_ACTIVATION_COMMITTED &&
                pendingOnlyKeys.none { key -> properties.containsKey(key) } &&
                properties.getProperty("documentLength")?.toLongOrNull() ==
                    pending.documentLength &&
                properties.getProperty("documentSha256", "") ==
                    pending.documentSha256 &&
                properties.getProperty("backupManifestLength")?.toLongOrNull() ==
                    pending.backupManifestLength &&
                File(properties.getProperty("backupSnapshotPath", "")).canonicalPath ==
                    pending.backupSnapshotPath &&
                File(properties.getProperty("markPath", "")).canonicalPath ==
                    pending.markPath &&
                properties.getProperty("originalMarkPresent", "") ==
                    pending.originalMarkPresent.toString() &&
                properties.getProperty("markLength")?.toLongOrNull() ==
                    pending.markLength &&
                properties.getProperty("markSha256", "") == pending.markSha256 &&
                properties.getProperty("backupCreatedAt")?.toLongOrNull() ==
                    pending.backupCreatedAt
        }
    }.getOrDefault(false)

    private fun reconcileFailedActivationBackupForExplicitActivation(
        pdfFile: File,
        marker: File,
    ) {
        val markerProperties = readPropertiesIfFile(marker)
        val pendingMarkerPresent =
            markerProperties.getProperty("mode", "") ==
                NATIVE_SPREAD_EDITABLE_MODE &&
                markerProperties.getProperty("activationState", "") ==
                NATIVE_SPREAD_ACTIVATION_PENDING
        val canonicalResult = readNativeAnnotationBackup(pdfFile)
        val canonicalBackup = canonicalResult.backup

        if (pendingMarkerPresent) {
            val pending = readPendingEditableActivation(
                pdfFile,
                markerProperties,
                canonicalBackup,
            ) ?: throw IllegalStateException(
                "Interrupted protected activation is invalid; recovery files were not changed",
            )

            if (pending.intent != NATIVE_SPREAD_PENDING_ENABLE_EDITABLE) {
                if (!pending.previousMarkerProtected) {
                    throw IllegalStateException(
                        "Interrupted protected-session retirement lacks prior authority",
                    )
                }
                if (canonicalBackup != null) {
                    restorePendingActivationPreviousMarker(marker, pending)
                    if (!nativeAnnotationBackupSourceFilesMatch(canonicalBackup) ||
                        !protectedEditableSessionMarkerValid(
                            pdfFile,
                            readPropertiesIfFile(marker),
                            canonicalBackup,
                        )
                    ) {
                        throw IllegalStateException(
                            "Interrupted protected-session retirement could not restore prior authority",
                        )
                    }
                    Log.w(
                        LOG_TAG,
                        "RTL_READER_NATIVE_RETIREMENT_PENDING_RECONCILED token=${pending.activationToken} intent=${pending.intent} canonicalRestored=true",
                    )
                    return
                }

                if (!pendingPreviousMarkerMatchesIdentity(pdfFile, pending) ||
                    nativeAnnotationBackupManifest(pdfFile).exists() ||
                    nativeAnnotationBackupSnapshot(pdfFile).exists()
                ) {
                    throw IllegalStateException(
                        "Interrupted protected-session retirement is ambiguous; evidence was retained",
                    )
                }
                val retiring = nativeAnnotationRetiringSnapshot(pdfFile)
                if (retiring.exists() &&
                    (
                        !pending.originalMarkPresent ||
                            !retiring.isFile ||
                            retiring.length() != pending.markLength ||
                            sha256(retiring) != pending.markSha256
                        )
                ) {
                    throw IllegalStateException(
                        "Interrupted protected-session retirement snapshot is ambiguous",
                    )
                }
                if (!deleteFileDurably(retiring)) {
                    throw IllegalStateException(
                        "Interrupted protected-session retirement could not finish",
                    )
                }
                if (!deleteFileDurably(marker)) {
                    throw IllegalStateException(
                        "Interrupted protected-session retirement marker could not be cleared",
                    )
                }
                if (nativeAnnotationBackupManifest(pdfFile).exists() ||
                    nativeAnnotationBackupSnapshot(pdfFile).exists() ||
                    nativeAnnotationRetiringSnapshot(pdfFile).exists() ||
                    marker.exists()
                ) {
                    throw IllegalStateException(
                        "Interrupted protected-session retirement cleanup was not durable",
                    )
                }
                Log.w(
                    LOG_TAG,
                    "RTL_READER_NATIVE_RETIREMENT_PENDING_RECONCILED token=${pending.activationToken} intent=${pending.intent} canonicalAlreadyRetired=true",
                )
                return
            }

            if (canonicalBackup != null) {
                if (pending.previousMarkerProtected) {
                    restorePendingActivationPreviousMarker(marker, pending)
                    if (!nativeAnnotationBackupSourceFilesMatch(canonicalBackup) ||
                        !protectedEditableSessionMarkerValid(
                            pdfFile,
                            readPropertiesIfFile(marker),
                            canonicalBackup,
                        )
                    ) {
                        throw IllegalStateException(
                            "Interrupted protected-session update could not restore prior authority",
                        )
                    }
                    Log.w(
                        LOG_TAG,
                        "RTL_READER_NATIVE_EDITABLE_PENDING_RECONCILED token=${pending.activationToken} existingSession=true previousMarkerRestored=true",
                    )
                    return
                }

                val archive = archiveFailedActivationBackup(
                    pdfFile,
                    canonicalBackup,
                    pending.activationToken,
                )
                restorePendingActivationPreviousMarker(marker, pending)
                if (nativeAnnotationBackupManifest(pdfFile).exists() ||
                    nativeAnnotationBackupSnapshot(pdfFile).exists() ||
                    nativeAnnotationRetiringSnapshot(pdfFile).exists() ||
                    readFailedActivationBackupEvidence(pdfFile, archive)?.let { evidence ->
                        pendingActivationMatchesEvidence(pending, evidence) &&
                            failedActivationEvidenceMatchesBackup(
                                evidence,
                                canonicalBackup,
                            )
                    } != true
                ) {
                    throw IllegalStateException(
                        "Interrupted first activation reconciliation could not be verified",
                    )
                }
                Log.w(
                    LOG_TAG,
                    "RTL_READER_NATIVE_EDITABLE_PENDING_RECONCILED token=${pending.activationToken} existingSession=false canonicalRetired=true previousMarkerRestored=true",
                )
                return
            }

            // The canonical slot can already be gone if the process died after
            // archive verification/retirement but before restoring the prior
            // marker. Only the exact self-contained token archive can complete
            // that interrupted transition.
            if (pending.previousMarkerProtected) {
                throw IllegalStateException(
                    "Interrupted protected-session update lost its canonical backup",
                )
            }
            val archive = failedActivationBackupArchive(
                pdfFile,
                pending.activationToken,
            )
            val evidence = readFailedActivationBackupEvidence(pdfFile, archive)
                ?: throw IllegalStateException(
                    "Interrupted activation has neither canonical nor archived recovery evidence",
                )
            if (!pendingActivationMatchesEvidence(pending, evidence)) {
                throw IllegalStateException(
                    "Interrupted activation archive does not match its pending marker",
                )
            }
            val retiringSnapshot = nativeAnnotationRetiringSnapshot(pdfFile)
            val canonicalSnapshot = nativeAnnotationBackupSnapshot(pdfFile)
            if (canonicalSnapshot.exists() ||
                (
                    retiringSnapshot.exists() &&
                        (
                            !pending.originalMarkPresent ||
                                !retiringSnapshot.isFile ||
                                retiringSnapshot.length() != pending.markLength ||
                                sha256(retiringSnapshot) != pending.markSha256
                            )
                    ) ||
                (!pending.originalMarkPresent && retiringSnapshot.exists())
            ) {
                throw IllegalStateException(
                    "Interrupted activation has ambiguous canonical retirement remnants",
                )
            }
            if (!deleteFileDurably(retiringSnapshot)) {
                throw IllegalStateException(
                    "Interrupted activation's exact retiring snapshot could not be removed",
                )
            }
            restorePendingActivationPreviousMarker(marker, pending)
            if (nativeAnnotationBackupManifest(pdfFile).exists() ||
                nativeAnnotationBackupSnapshot(pdfFile).exists() ||
                nativeAnnotationRetiringSnapshot(pdfFile).exists() ||
                readFailedActivationBackupEvidence(pdfFile, archive)?.let { verified ->
                    pendingActivationMatchesEvidence(pending, verified)
                } != true
            ) {
                throw IllegalStateException(
                    "Archived interrupted activation reconciliation could not be verified",
                )
            }
            Log.w(
                LOG_TAG,
                "RTL_READER_NATIVE_EDITABLE_PENDING_RECONCILED token=${pending.activationToken} canonicalAlreadyRetired=true previousMarkerRestored=true",
            )
            return
        }

        val canonicalManifest = nativeAnnotationBackupManifest(pdfFile)
        val canonicalSnapshot = nativeAnnotationBackupSnapshot(pdfFile)
        val retiringSnapshot = nativeAnnotationRetiringSnapshot(pdfFile)
        if (!canonicalManifest.exists()) {
            if (canonicalSnapshot.exists() || retiringSnapshot.exists()) {
                if (markerClaimsProtectedEditable(markerProperties)) {
                    throw IllegalStateException(
                        "A protected editable marker claims an incomplete recovery snapshot; evidence was retained",
                    )
                }
                if (canonicalSnapshot.exists() && retiringSnapshot.exists()) {
                    throw IllegalStateException(
                        "Multiple incomplete annotation snapshots exist; evidence was retained",
                    )
                }
                val orphanSnapshot = if (canonicalSnapshot.exists()) {
                    canonicalSnapshot
                } else {
                    retiringSnapshot
                }
                val liveMark = nativeAnnotationMark(pdfFile)
                val orphanSnapshotMatchesLive = runCatching {
                    orphanSnapshot.isFile &&
                        liveMark.isFile &&
                        orphanSnapshot.length() == liveMark.length() &&
                        sha256(orphanSnapshot) == sha256(liveMark)
                }.getOrDefault(false)
                if (!orphanSnapshotMatchesLive || !deleteFileDurably(orphanSnapshot)) {
                    throw IllegalStateException(
                        "An incomplete annotation snapshot differs from the live mark; recovery files were not changed",
                    )
                }
                if (canonicalSnapshot.exists() || retiringSnapshot.exists()) {
                    throw IllegalStateException(
                        "The matching incomplete annotation snapshot could not be retired",
                    )
                }
                Log.w(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_UNPUBLISHED_SNAPSHOT_RETIRED liveMarkMatched=true",
                )
            }
            return
        }
        if (canonicalBackup == null) {
            throw IllegalStateException(
                "Canonical annotation recovery files are invalid: ${canonicalResult.status}",
            )
        }

        fun failClosed(message: String): Nothing {
            throw IllegalStateException("$message; exact evidence was retained")
        }

        var matchingEvidence: FailedActivationBackupEvidence? = null
        for (token in failedActivationArchiveTokens(pdfFile)) {
            val archive = failedActivationBackupArchive(pdfFile, token)
            val evidence = readFailedActivationBackupEvidence(pdfFile, archive)
            if (evidence != null &&
                failedActivationEvidenceMatchesBackup(evidence, canonicalBackup)
            ) {
                if (matchingEvidence != null) {
                    failClosed(
                        "Multiple failed-activation archives claim the canonical recovery slot",
                    )
                }
                matchingEvidence = evidence
            }
        }
        val evidence = matchingEvidence
        if (evidence == null) {
            if (protectedEditableSessionMarkerValid(
                    pdfFile,
                    markerProperties,
                    canonicalBackup,
                )
            ) return
            if (markerClaimsProtectedEditable(markerProperties)) {
                throw IllegalStateException(
                    "A protected editable marker claims an invalid recovery baseline; evidence was retained",
                )
            }
            if (!liveNativeAnnotationMatchesBackup(canonicalBackup)) {
                throw IllegalStateException(
                    "An inactive annotation backup differs from the live mark; restore it before changing Native Spread",
                )
            }
            removeNativeAnnotationBackupFiles(pdfFile, canonicalBackup)
            if (nativeAnnotationBackupManifest(pdfFile).exists() ||
                nativeAnnotationBackupSnapshot(pdfFile).exists() ||
                nativeAnnotationRetiringSnapshot(pdfFile).exists()
            ) {
                throw IllegalStateException(
                    "Matching unpublished annotation backup retirement failed",
                )
            }
            Log.w(
                LOG_TAG,
                "RTL_READER_NATIVE_BACKUP_UNPUBLISHED_BASELINE_RETIRED liveMarkMatched=true",
            )
            return
        }
        if (protectedEditableSessionMarkerValid(
                pdfFile,
                markerProperties,
                canonicalBackup,
            )
        ) {
            failClosed(
                "A committed protected session conflicts with failed-activation evidence",
            )
        }
        if (!nativeAnnotationBackupSourceFilesMatch(canonicalBackup) ||
            !failedActivationEvidenceMatchesBackup(evidence, canonicalBackup)
        ) {
            failClosed(
                "Failed-activation canonical recovery reconciliation is ambiguous",
            )
        }
        removeNativeAnnotationBackupFiles(pdfFile, canonicalBackup)
        if (nativeAnnotationBackupManifest(pdfFile).exists() ||
            nativeAnnotationBackupSnapshot(pdfFile).exists() ||
            nativeAnnotationRetiringSnapshot(pdfFile).exists() ||
            readFailedActivationBackupEvidence(
                pdfFile,
                evidence.archive,
            )?.let { verified ->
                failedActivationEvidenceMatchesBackup(verified, canonicalBackup)
            } != true
        ) {
            failClosed(
                "Failed-activation canonical recovery reconciliation failed",
            )
        }
        Log.w(
            LOG_TAG,
            "RTL_READER_NATIVE_EDITABLE_ACTIVATION_BACKUP_RECONCILED token=${evidence.archive.activationToken} canonicalRetired=true",
        )
    }

    private fun readPropertiesIfFile(file: File): Properties =
        readPersistedBytesIfFile(file)?.let { bytes ->
            strictNativeSpreadMarkerProperties(bytes)
        } ?: Properties()

    /**
     * Reads one persisted marker through a descriptor that is proven to name
     * the same bounded, regular, single-link inode before and after the read.
     * Recovery and rollback consume these bytes as authority too, so they
     * must use the same anti-substitution boundary as property parsing.
     */
    private fun readPersistedBytesIfFile(file: File): ByteArray? =
        readPersistedAuthorityIfFile(file)?.bytes

    private fun readPersistedAuthorityIfFile(file: File): PersistedFileAuthority? =
        readRegularFileAuthorityIfFile(
            file,
            STRICT_PROPERTIES_MAX_BYTES.toLong(),
            requireNonEmpty = true,
            authorityLabel = "persisted-properties",
        )

    private fun readRegularFileAuthorityIfFile(
        file: File,
        maximumBytes: Long,
        requireNonEmpty: Boolean,
        authorityLabel: String,
    ): PersistedFileAuthority? {
        val path = file.absolutePath
        val pathBefore = try {
            Os.lstat(path)
        } catch (missing: ErrnoException) {
            if (missing.errno == OsConstants.ENOENT) return null
            throw missing
        }
        require(
            OsConstants.S_ISREG(pathBefore.st_mode) &&
                pathBefore.st_nlink == 1L &&
                pathBefore.st_size >= (if (requireNonEmpty) 1L else 0L) &&
                pathBefore.st_size <= maximumBytes &&
                pathBefore.st_size <= Int.MAX_VALUE.toLong(),
        ) {
            "$authorityLabel authority is not one bounded single-link file"
        }
        val descriptor = Os.open(
            path,
            OsConstants.O_RDONLY or OsConstants.O_CLOEXEC or OsConstants.O_NOFOLLOW,
            0,
        )
        try {
            val opened = Os.fstat(descriptor)
            require(samePersistedFileVersion(pathBefore, opened)) {
                "$authorityLabel descriptor disagrees with its path"
            }
            val bytes = ByteArrayOutputStream(opened.st_size.toInt()).use { output ->
                FileInputStream(Os.dup(descriptor)).use { input ->
                    val buffer = ByteArray(8192)
                    while (true) {
                        val count = input.read(buffer)
                        if (count < 0) break
                        require(output.size().toLong() + count <= maximumBytes) {
                            "$authorityLabel file exceeded its size bound"
                        }
                        output.write(buffer, 0, count)
                    }
                }
                output.toByteArray()
            }
            val openedAfter = Os.fstat(descriptor)
            val pathAfter = Os.lstat(path)
            require(
                samePersistedFileVersion(opened, openedAfter) &&
                    samePersistedFileVersion(opened, pathAfter) &&
                    bytes.size.toLong() == opened.st_size,
            ) {
                "$authorityLabel authority changed or was replaced while reading"
            }
            return PersistedFileAuthority(bytes, opened)
        } finally {
            Os.close(descriptor)
        }
    }

    private fun sameFileObject(first: StructStat, second: StructStat): Boolean =
        first.st_dev == second.st_dev &&
            first.st_ino == second.st_ino &&
            first.st_mode == second.st_mode

    /**
     * Opens and pins a directory without accepting a symlink or replacement.
     *
     * Android 11's emulated-storage FUSE mount rejects O_DIRECTORY with EINVAL,
     * but accepts O_NOFOLLOW and directory fsync. Prefer both kernel-enforced
     * flags everywhere else. On that one documented incompatibility, drop only
     * O_DIRECTORY and prove the still-no-follow descriptor against lstat
     * snapshots before returning it. Every caller keeps the descriptor open
     * and revalidates the same inode across its operation.
     */
    private fun openPinnedDirectory(
        directory: File,
        authorityLabel: String,
    ): FileDescriptor {
        val strictFlags = OsConstants.O_RDONLY or OsConstants.O_CLOEXEC or
            LINUX_O_DIRECTORY or OsConstants.O_NOFOLLOW
        val strictFailure = try {
            return Os.open(directory.absolutePath, strictFlags, 0)
        } catch (failure: ErrnoException) {
            failure
        }
        if (strictFailure.errno != OsConstants.EINVAL) {
            throw strictFailure
        }

        val before = Os.lstat(directory.absolutePath)
        require(OsConstants.S_ISDIR(before.st_mode)) {
            "$authorityLabel is not a no-follow directory"
        }
        val descriptor = Os.open(
            directory.absolutePath,
            OsConstants.O_RDONLY or OsConstants.O_CLOEXEC or
                OsConstants.O_NOFOLLOW,
            0,
        )
        try {
            val opened = Os.fstat(descriptor)
            val after = Os.lstat(directory.absolutePath)
            require(
                OsConstants.S_ISDIR(opened.st_mode) &&
                    sameFileObject(before, opened) &&
                    sameFileObject(opened, after),
            ) {
                "$authorityLabel changed during FUSE-compatible directory open"
            }
            Log.w(
                LOG_TAG,
                "RTL_READER_PINNED_DIRECTORY_FUSE_FALLBACK path=${directory.absolutePath}",
            )
            return descriptor
        } catch (failure: Throwable) {
            runCatching { Os.close(descriptor) }
            throw failure
        }
    }

    private fun samePersistedFileVersion(first: StructStat, second: StructStat): Boolean =
        first.st_dev == second.st_dev &&
            first.st_ino == second.st_ino &&
            first.st_mode == second.st_mode &&
            first.st_nlink == second.st_nlink &&
            first.st_size == second.st_size &&
            first.st_mtime == second.st_mtime &&
            first.st_mtim.tv_nsec == second.st_mtim.tv_nsec &&
            first.st_ctime == second.st_ctime &&
            first.st_ctim.tv_nsec == second.st_ctim.tv_nsec

    /**
     * Mirrors NativeReaderV2StrictProperties. Java Properties silently keeps
     * the last duplicate key, which would let the companion display authority
     * that the injected module correctly rejects.
     */
    private fun strictProperties(
        bytes: ByteArray,
        exactKeys: Set<String>? = null,
    ): Properties {
        require(bytes.isNotEmpty() && bytes.size <= STRICT_PROPERTIES_MAX_BYTES) {
            "invalid persisted-properties byte length"
        }
        require(bytes.none { item -> item == 0.toByte() }) {
            "persisted properties contain NUL"
        }
        val text = bytes.toString(Charsets.ISO_8859_1)
        val keys = HashSet<String>()
        val logical = StringBuilder()
        var continuing = false
        var start = 0
        var index = 0
        while (index <= text.length) {
            if (index != text.length && text[index] != '\n' && text[index] != '\r') {
                index += 1
                continue
            }
            var physical = text.substring(start, index)
            if (index < text.length && text[index] == '\r' &&
                index + 1 < text.length && text[index + 1] == '\n'
            ) {
                index += 1
            }
            start = index + 1
            if (continuing) {
                physical = physical.dropWhile { value -> isPropertyWhitespace(value) }
            }
            logical.append(physical)
            if (endsWithPropertyContinuation(logical)) {
                logical.setLength(logical.length - 1)
                continuing = true
                index += 1
                continue
            }
            continuing = false
            inspectLogicalPropertyLine(logical.toString(), keys)
            logical.setLength(0)
            index += 1
        }
        require(!continuing) { "unterminated persisted-properties continuation" }
        val properties = Properties().apply {
            ByteArrayInputStream(bytes).use { input -> load(input) }
        }
        require(properties.size == keys.size) {
            "persisted-properties key decoding was ambiguous"
        }
        if (exactKeys != null) {
            require(properties.stringPropertyNames() == exactKeys) {
                "persisted-properties schema is not exact"
            }
        }
        return properties
    }

    private fun strictNativeSpreadMarkerProperties(bytes: ByteArray): Properties {
        val properties = strictProperties(bytes)
        requireNativeReaderV2MarkerSchema(properties)
        return properties
    }

    private fun requireNativeReaderV2MarkerSchema(properties: Properties) {
        val engine = properties.getProperty("nativeReaderEngine", "")
        val mode = properties.getProperty("mode", "")
        if (engine != "native-reader-v2" && mode != NATIVE_SPREAD_EDITABLE_MODE) {
            return
        }
        require(engine == "native-reader-v2" && mode == NATIVE_SPREAD_EDITABLE_MODE) {
            "Native Reader v2 marker identity is incomplete"
        }
        val expected = when (properties.getProperty("activationState", "")) {
            NATIVE_SPREAD_ACTIVATION_COMMITTED -> NATIVE_READER_V2_COMMITTED_FIELDS
            NATIVE_SPREAD_ACTIVATION_PENDING -> NATIVE_READER_V2_PENDING_FIELDS
            else -> throw IllegalStateException(
                "Native Reader v2 marker activation state is unsupported",
            )
        }
        require(properties.stringPropertyNames() == expected) {
            "Native Reader v2 marker schema is not exact"
        }
    }

    private fun inspectLogicalPropertyLine(line: String, keys: MutableSet<String>) {
        val trimmed = line.dropWhile { value -> isPropertyWhitespace(value) }
        if (trimmed.isEmpty() || trimmed[0] == '#' || trimmed[0] == '!') return
        val one = Properties().apply {
            ByteArrayInputStream((line + "\n").toByteArray(Charsets.ISO_8859_1)).use {
                input -> load(input)
            }
        }
        require(one.size == 1) { "invalid persisted-property line" }
        val key = one.stringPropertyNames().single()
        require(keys.add(key)) { "duplicate persisted-property key $key" }
    }

    private fun endsWithPropertyContinuation(line: StringBuilder): Boolean {
        var slashes = 0
        var index = line.length - 1
        while (index >= 0 && line[index] == '\\') {
            slashes += 1
            index -= 1
        }
        return slashes and 1 != 0
    }

    private fun isPropertyWhitespace(value: Char): Boolean =
        value == ' ' || value == '\t' || value == '\u000c'

    private fun startNativeBackupWorker(name: String, action: () -> Unit) {
        Thread(
            { synchronized(nativeSpreadConfigurationLock) { action() } },
            name,
        ).apply {
            isDaemon = true
            start()
        }
    }

    private fun migrateLegacyProtectedEditableSession(
        pdfFile: File,
        marker: File,
        handshake: NativeSpreadHandshake,
        configurationGeneration: Long,
    ): NativeAnnotationBackup {
        check(handshake.active) {
            "Native Spread live safety check was not active for legacy migration"
        }
        val legacyProperties = readPropertiesIfFile(marker)
        val legacyBackup = readNativeAnnotationBackup(pdfFile).backup
            ?: throw IllegalStateException(
                "The legacy protected session has no verified recovery snapshot",
            )
        if (!legacyProtectedEditableMarkerValid(
                pdfFile,
                legacyProperties,
                legacyBackup,
            )
        ) {
            throw IllegalStateException(
                "The protected session changed before legacy migration",
            )
        }

        val migrated = activateNativeSpreadEditableWithStableBackup(
            pdfFile,
            marker,
            legacyProperties.getProperty("coverSeparate", "false")
                .equals("true", ignoreCase = true),
            !legacyProperties.getProperty("showDivider", "true")
                .equals("false", ignoreCase = true),
            !legacyProperties.getProperty("showHeader", "true")
                .equals("false", ignoreCase = true),
            if (legacyProperties.getProperty("spreadSizing", "fit")
                    .equals("native_fill", ignoreCase = true)
            ) "native_fill" else "fit",
            handshake,
            configurationGeneration,
        )
        // activateNativeSpreadEditableWithStableBackup returns only after the
        // committed rename. Do not introduce a fallible post-commit state
        // decision that could report read-only while the companion authorizes
        // the committed marker.
        runCatching {
            Log.i(
                LOG_TAG,
                "RTL_READER_NATIVE_LEGACY_SESSION_MIGRATED marker=${marker.absolutePath}",
            )
        }
        return migrated
    }

    private fun retireNativeAnnotationBackup(
        pdfFile: File,
        markerProperties: Properties,
        backupResult: NativeAnnotationBackupResult,
    ) {
        val backup = backupResult.backup ?: return
        if (!protectedEditableSessionMarkerValid(
                pdfFile,
                markerProperties,
                backup,
            )
        ) return

        // Removing or downgrading the editable marker ends that protected
        // session. Retire its recovery baseline so a later "Back up & enable"
        // starts from the current .mark instead of silently reusing stale bytes
        // from before an ordinary, unprotected annotation interval.
        removeNativeAnnotationBackupFiles(pdfFile, backup)
        Log.i(
            LOG_TAG,
            "RTL_READER_NATIVE_BACKUP_RETIRED createdAt=${backup.createdAt}",
        )
    }

    private fun removeNativeAnnotationBackupFiles(
        pdfFile: File,
        backup: NativeAnnotationBackup,
    ) {
        synchronized(nativeSpreadConfigurationLock) {
            val retiring = nativeAnnotationRetiringSnapshot(pdfFile)
            if (retiring.exists()) {
                throw IllegalStateException("A prior annotation backup retirement is incomplete")
            }
            if (backup.originalMarkPresent) {
                renameFileDurably(backup.snapshot, retiring)
            }
            if (!deleteFileDurably(backup.manifest)) {
                if (backup.originalMarkPresent && retiring.exists()) {
                    renameFileDurably(retiring, backup.snapshot)
                }
                throw IllegalStateException("Could not retire the completed annotation backup manifest")
            }
            if (!deleteFileDurably(retiring)) {
                Log.w(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_RETIRE_CLEANUP_DEFERRED file=${retiring.absolutePath}",
                )
            }
        }
    }

    private fun ensureNativeAnnotationBackup(pdfFile: File): NativeAnnotationBackup {
        val existing = readNativeAnnotationBackup(pdfFile)
        if (existing.backup != null) {
            val markerProperties = readPropertiesIfFile(nativeSpreadMarker(pdfFile))
            if (!protectedEditableSessionMarkerValid(
                    pdfFile,
                    markerProperties,
                    existing.backup,
                )
            ) {
                throw IllegalStateException(
                    "A verified annotation backup belongs to an inactive protected session; restore it before starting a new editable session",
                )
            }
            Log.i(
                LOG_TAG,
                "RTL_READER_NATIVE_BACKUP_REUSED manifest=${existing.backup.manifest.absolutePath}",
            )
            return existing.backup
        }

        val manifest = nativeAnnotationBackupManifest(pdfFile)
        val snapshot = nativeAnnotationBackupSnapshot(pdfFile)
        val retiring = nativeAnnotationRetiringSnapshot(pdfFile)
        if (manifest.exists() || snapshot.exists() || retiring.exists()) {
            throw IllegalStateException(
                "An unverified annotation backup already exists (${existing.status}); recovery files were not overwritten",
            )
        }

        val mark = nativeAnnotationMark(pdfFile)
        if (mark.exists() && !mark.isFile) {
            throw IllegalStateException("Supernote annotation path is not a regular file")
        }
        val originalPresent = mark.isFile
        try {
            val markLength: Long
            val markHash: String
            if (originalPresent) {
                markLength = mark.length()
                markHash = sha256(mark)
                copyFileAtomically(mark, snapshot)
                if (snapshot.length() != markLength || sha256(snapshot) != markHash) {
                    throw IllegalStateException("Annotation snapshot byte verification failed")
                }
            } else {
                markLength = 0L
                markHash = "ABSENT"
            }

            val createdAt = System.currentTimeMillis()
            val properties = Properties().apply {
                setProperty("version", NATIVE_SPREAD_BACKUP_VERSION.toString())
                setProperty("managedBy", "supernote-rtl-reader")
                setProperty("documentPath", pdfFile.canonicalPath)
                setProperty("documentLength", pdfFile.length().toString())
                setProperty("documentSha256", sha256(pdfFile))
                // Supernote updates the PDF mtime when DocumentActivity reopens.
                // Retain it for diagnostics, but bind recovery to the PDF bytes.
                setProperty("documentModified", pdfFile.lastModified().toString())
                setProperty("markPath", mark.canonicalPath)
                setProperty("originalMarkPresent", originalPresent.toString())
                setProperty("markLength", markLength.toString())
                setProperty("markSha256", markHash)
                setProperty("snapshotPath", snapshot.canonicalPath)
                setProperty("createdAt", createdAt.toString())
            }
            writePropertiesAtomically(
                manifest,
                properties,
                "Supernote RTL annotation recovery snapshot",
            )

            val verified = readNativeAnnotationBackup(pdfFile)
            return verified.backup
                ?: throw IllegalStateException(
                    "Annotation backup verification failed after creation: ${verified.status}",
                )
        } catch (error: Throwable) {
            var rollbackFailed = false
            if (!deleteFileDurably(manifest)) {
                rollbackFailed = true
                val cleanupError = IllegalStateException(
                    "Could not remove the failed annotation backup manifest",
                )
                error.addSuppressed(cleanupError)
                Log.e(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_CREATION_ROLLBACK_FAILED file=${manifest.absolutePath}",
                    cleanupError,
                )
            }
            if (!manifest.exists() && !deleteFileDurably(snapshot)) {
                rollbackFailed = true
                val cleanupError = IllegalStateException(
                    "Could not remove the failed annotation backup snapshot",
                )
                error.addSuppressed(cleanupError)
                Log.e(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_CREATION_ROLLBACK_FAILED file=${snapshot.absolutePath}",
                    cleanupError,
                )
            }
            if (!rollbackFailed) {
                Log.w(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_CREATION_ROLLED_BACK manifest=${manifest.absolutePath} snapshot=${snapshot.absolutePath}",
                )
            }
            if (!deleteFileDurably(retiring)) {
                val cleanupError = IllegalStateException(
                    "Could not remove the failed annotation backup retirement file",
                )
                error.addSuppressed(cleanupError)
                Log.e(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_CREATION_ROLLBACK_FAILED file=${retiring.absolutePath}",
                    cleanupError,
                )
            }
            throw error
        }
    }

    private fun ensureStableNativeAnnotationBackupForActivation(
        pdfFile: File,
        backupManifestExisted: Boolean,
    ): NativeAnnotationBackup {
        if (backupManifestExisted) {
            // An already-active protected session intentionally diverges from
            // its recovery baseline as the user edits. Reuse is authorized by
            // ensureNativeAnnotationBackup's marker/manifest validation.
            return ensureNativeAnnotationBackup(pdfFile)
        }

        val maximumAttempts = 3
        repeat(maximumAttempts) { attempt ->
            val backup = ensureNativeAnnotationBackup(pdfFile)
            if (liveNativeAnnotationMatchesBackup(backup)) {
                Log.i(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_LIVE_MARK_VERIFIED attempt=${attempt + 1}",
                )
                return backup
            }

            Log.w(
                LOG_TAG,
                "RTL_READER_NATIVE_BACKUP_LIVE_MARK_CHANGED attempt=${attempt + 1}; retrying snapshot",
            )
            removeNativeAnnotationBackupFiles(pdfFile, backup)
            if (attempt + 1 < maximumAttempts) {
                Thread.sleep(100L)
            }
        }
        throw IllegalStateException(
            "Supernote annotations kept changing while protected editing was being enabled; no editable marker was written",
        )
    }

    private fun activateNativeSpreadEditableWithStableBackup(
        pdfFile: File,
        marker: File,
        coverSeparate: Boolean,
        showDivider: Boolean,
        showHeader: Boolean,
        spreadSizing: String,
        handshake: NativeSpreadHandshake,
        configurationGeneration: Long,
    ): NativeAnnotationBackup {
        val previousMarkerBytes = readPersistedBytesIfFile(marker)
        val backupManifestExisted = nativeAnnotationBackupManifest(pdfFile).isFile
        val activationToken = UUID.randomUUID().toString()
        var backup: NativeAnnotationBackup? = null
        var markerPublishedByActivation = false
        var committedMarkerPublishedByActivation = false
        var committedMarkerVerifiedByActivation = false
        var rollbackAttempted = false
        try {
            val activationBackup = ensureStableNativeAnnotationBackupForActivation(
                pdfFile,
                backupManifestExisted,
            )
            backup = activationBackup
            val previousMarkerProperties = previousMarkerBytes?.let { bytes ->
                strictNativeSpreadMarkerProperties(bytes)
            } ?: Properties()
            val previousMarkerProtected = previousMarkerBytes != null &&
                protectedEditableSessionMarkerValid(
                    pdfFile,
                    previousMarkerProperties,
                    activationBackup,
                )
            if (backupManifestExisted && !previousMarkerProtected) {
                throw IllegalStateException(
                    "The existing annotation backup lost its protected marker before activation",
                )
            }
            val publishedBackup = writeNativeSpreadPendingMarker(
                pdfFile,
                marker,
                activationToken,
                coverSeparate,
                showDivider,
                showHeader,
                spreadSizing,
                handshake,
                activationBackup,
                NATIVE_SPREAD_PENDING_ENABLE_EDITABLE,
                previousMarkerBytes,
                previousMarkerProtected,
                configurationGeneration,
            ) {
                markerPublishedByActivation = true
            }
            backup = publishedBackup

            // Pending publication is deliberately not authorization. For a
            // new protected session, verify the live .mark while the companion
            // still rejects this token. Existing protected sessions may have
            // intentionally diverged from their original recovery baseline.
            if (backupManifestExisted ||
                liveNativeAnnotationMatchesBackup(activationBackup)
            ) {
                Log.i(
                    LOG_TAG,
                    "RTL_READER_NATIVE_EDITABLE_PENDING_LIVE_MARK_VERIFIED token=$activationToken",
                )
                val committedBackup = commitNativeSpreadEditableMarker(
                    pdfFile,
                    marker,
                    activationToken,
                    coverSeparate,
                    showDivider,
                    showHeader,
                    spreadSizing,
                    publishedBackup,
                    requireLiveBaselineMatch = !backupManifestExisted,
                    configurationGeneration = configurationGeneration,
                ) {
                    committedMarkerPublishedByActivation = true
                }
                committedMarkerVerifiedByActivation = true
                return committedBackup
            }

            val changed = IllegalStateException(
                "Supernote annotations changed while protected editing was pending",
            )
            rollbackAttempted = true
            rollbackNativeSpreadEditableActivation(
                pdfFile,
                marker,
                previousMarkerBytes,
                activationToken,
                publishedBackup,
                backupManifestExisted,
                markerPublishedByActivation,
                changed,
            )
            // Never retry from bytes that changed after marker publication.
            // Rollback archives the verified pre-activation bytes as evidence
            // while freeing the canonical backup slot. The caller can then
            // explicitly retry from a fresh snapshot of the newer live mark.
            throw changed
        } catch (activationError: Throwable) {
            if (committedMarkerPublishedByActivation) {
                // The committed rename is final authorization, so rollback is
                // no longer safe. Publication alone is not a successful
                // activation, however: a descriptor/path/bytes/fsync failure
                // after rename must still reject the caller and be re-admitted
                // from persisted authority on the next load.
                Log.e(
                    LOG_TAG,
                    "RTL_READER_NATIVE_EDITABLE_COMMIT_VERIFICATION_FAILED " +
                        "verified=$committedMarkerVerifiedByActivation: " +
                        activationError.message,
                    activationError,
                )
                throw activationError
            }
            if (backup != null && !rollbackAttempted) {
                rollbackAttempted = true
                rollbackNativeSpreadEditableActivation(
                    pdfFile,
                    marker,
                    previousMarkerBytes,
                    activationToken,
                    backup,
                    backupManifestExisted,
                    markerPublishedByActivation,
                    activationError,
                )
            }
            throw activationError
        }
    }

    private fun rollbackNativeSpreadEditableActivation(
        pdfFile: File,
        marker: File,
        previousMarkerBytes: ByteArray?,
        activationToken: String,
        backup: NativeAnnotationBackup,
        backupManifestExisted: Boolean,
        markerPublishedByActivation: Boolean,
        activationError: Throwable,
    ): Boolean = withNativeSpreadPublicationLock(marker) {
        try {
            var failedActivationArchive: FailedActivationBackupArchive? = null
            val currentMarkerAuthority = readPersistedAuthorityIfFile(marker)
            val currentMarkerBytes = currentMarkerAuthority?.bytes
            val currentMarkerProperties = currentMarkerBytes?.let { bytes ->
                strictNativeSpreadMarkerProperties(bytes)
            } ?: Properties()
            val ownsPublishedMarker = currentMarkerProperties.getProperty(
                "activationToken",
                "",
            ) == activationToken
            val markerAlreadyPrevious = if (previousMarkerBytes == null) {
                currentMarkerAuthority == null
            } else {
                currentMarkerBytes?.contentEquals(previousMarkerBytes) == true
            }
            val markerOwnershipLost = !ownsPublishedMarker && !markerAlreadyPrevious
            val archiveNewBackup = !backupManifestExisted &&
                (markerPublishedByActivation || ownsPublishedMarker)
            if (markerOwnershipLost && !archiveNewBackup) {
                Log.w(
                    LOG_TAG,
                    "RTL_READER_NATIVE_EDITABLE_ACTIVATION_ROLLBACK_SKIPPED reason=marker_ownership_lost marker=${marker.absolutePath}",
                )
                return@withNativeSpreadPublicationLock false
            }
            fun restorePublishedMarkerIfOwned() {
                if (!ownsPublishedMarker) return
                if (previousMarkerBytes == null) {
                    val ownedIdentity = currentMarkerAuthority?.identity
                        ?: throw IllegalStateException(
                            "Owned protected editable marker disappeared",
                        )
                    deleteRegularFileCas(
                        marker,
                        ownedIdentity,
                        "failed protected editable marker rollback",
                    )
                } else {
                    writeBytesAtomicallyCas(
                        marker,
                        previousMarkerBytes,
                        currentMarkerAuthority,
                    )
                }
            }

            // Once this activation published a marker, complete and verify its
            // self-contained evidence archive, then free the canonical slot,
            // before restoring the prior marker. A process death after archive
            // publication is therefore reconcilable by the next explicit
            // activation without trusting an inactive canonical backup.
            if (archiveNewBackup) {
                // If archival cannot yet be verified, retain the exact pending
                // marker and canonical/partial evidence. Removing that token
                // would make a later explicit retry unable to resume safely.
                failedActivationArchive = archiveFailedActivationBackup(
                    pdfFile,
                    backup,
                    activationToken,
                )
                restorePublishedMarkerIfOwned()
            } else {
                restorePublishedMarkerIfOwned()
                if (!backupManifestExisted) {
                    removeNativeAnnotationBackupFiles(pdfFile, backup)
                }
            }
            val markerRestored = if (previousMarkerBytes == null) {
                !marker.exists()
            } else {
                readPersistedBytesIfFile(marker)
                    ?.contentEquals(previousMarkerBytes) == true
            }
            val canonicalBackupCleared =
                !nativeAnnotationBackupManifest(pdfFile).exists() &&
                    !nativeAnnotationBackupSnapshot(pdfFile).exists() &&
                    !nativeAnnotationRetiringSnapshot(pdfFile).exists()
            val preserved = readNativeAnnotationBackup(pdfFile).backup
            val backupRestored = when {
                backupManifestExisted ->
                    markerRestored &&
                        preserved != null &&
                        sameNativeAnnotationBackup(backup, preserved) &&
                        protectedEditableSessionMarkerValid(
                            pdfFile,
                            readPropertiesIfFile(marker),
                            preserved,
                        )
                archiveNewBackup ->
                    (failedActivationArchive?.let { archive ->
                        failedActivationBackupArchived(pdfFile, archive) &&
                            (readFailedActivationBackupEvidence(
                                pdfFile,
                                archive,
                            )?.let { evidence ->
                                failedActivationEvidenceMatchesBackup(evidence, backup)
                            } == true)
                    } == true) && canonicalBackupCleared
                else -> canonicalBackupCleared
            }
            val markerSettled = markerRestored ||
                (markerOwnershipLost && archiveNewBackup && canonicalBackupCleared)
            if (!markerSettled || !backupRestored) {
                throw IllegalStateException(
                    "Protected editable activation rollback could not be verified",
                )
            }
            Log.w(
                LOG_TAG,
                "RTL_READER_NATIVE_EDITABLE_ACTIVATION_ROLLED_BACK marker=${marker.absolutePath} markerRestored=$markerRestored markerOwnershipLost=$markerOwnershipLost backupCreated=${!backupManifestExisted} backupArchived=$archiveNewBackup",
            )
            true
        } catch (rollbackError: Throwable) {
            activationError.addSuppressed(rollbackError)
            Log.e(
                LOG_TAG,
                "RTL_READER_NATIVE_EDITABLE_ACTIVATION_ROLLBACK_FAILED marker=${marker.absolutePath}",
                rollbackError,
            )
            false
        }
    }

    private fun liveNativeAnnotationMatchesBackup(
        backup: NativeAnnotationBackup,
    ): Boolean {
        val mark = backup.mark
        return if (backup.originalMarkPresent) {
            mark.isFile &&
                mark.length() == backup.markLength &&
                sha256(mark) == backup.markSha256
        } else {
            !mark.exists()
        }
    }

    private fun readNativeAnnotationBackup(pdfFile: File): NativeAnnotationBackupResult {
        return synchronized(nativeSpreadConfigurationLock) {
            try {
            val manifest = nativeAnnotationBackupManifest(pdfFile)
            val snapshot = nativeAnnotationBackupSnapshot(pdfFile)
            val retiring = nativeAnnotationRetiringSnapshot(pdfFile)
            if (snapshot.exists() && retiring.exists()) {
                throw IllegalStateException(
                    "ambiguous_canonical_and_retiring_snapshots",
                )
            }
            if (manifest.isFile && !snapshot.exists() && retiring.isFile) {
                renameFileDurably(retiring, snapshot)
                Log.w(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_RETIREMENT_ROLLED_BACK file=${snapshot.absolutePath}",
                )
            }
            if (!manifest.isFile) {
                return@synchronized NativeAnnotationBackupResult(
                    null,
                    if (retiring.exists()) {
                        "invalid:retiring_snapshot_without_manifest"
                    } else {
                        "missing"
                    },
                )
            }
            if (manifest.length() !in 1..STRICT_PROPERTIES_MAX_BYTES.toLong()) {
                throw IllegalStateException("manifest_length_invalid")
            }
            val manifestBytes = manifest.readBytes()
            val manifestHash = sha256(manifestBytes)
            val properties = strictProperties(
                manifestBytes,
                NATIVE_ANNOTATION_BACKUP_FIELDS,
            )
            if (properties.getProperty("version") != NATIVE_SPREAD_BACKUP_VERSION.toString() ||
                properties.getProperty("managedBy") != "supernote-rtl-reader"
            ) {
                throw IllegalStateException("unsupported_manifest")
            }
            val documentPath = File(
                properties.getProperty("documentPath", ""),
            ).canonicalPath
            val documentLength = properties.getProperty("documentLength")?.toLongOrNull()
                ?: throw IllegalStateException("document_length_invalid")
            val documentHash = properties.getProperty("documentSha256", "")
            if (documentPath != pdfFile.canonicalPath ||
                documentLength != pdfFile.length() ||
                properties.getProperty("documentSha256", "") != sha256(pdfFile)
            ) {
                throw IllegalStateException("document_identity_changed")
            }

            val mark = nativeAnnotationMark(pdfFile)
            if (File(properties.getProperty("markPath", "")).canonicalPath != mark.canonicalPath) {
                throw IllegalStateException("mark_path_mismatch")
            }
            if (File(properties.getProperty("snapshotPath", "")).canonicalPath !=
                snapshot.canonicalPath
            ) {
                throw IllegalStateException("snapshot_path_mismatch")
            }
            val originalPresent = when (
                properties.getProperty("originalMarkPresent", "")
            ) {
                "true" -> true
                "false" -> false
                else -> throw IllegalStateException("original_presence_invalid")
            }
            val markLength = properties.getProperty("markLength")?.toLongOrNull()
                ?: throw IllegalStateException("mark_length_invalid")
            val markHash = properties.getProperty("markSha256", "")
            if (originalPresent) {
                if (!snapshot.isFile || snapshot.length() != markLength ||
                    sha256(snapshot) != markHash
                ) {
                    throw IllegalStateException("snapshot_bytes_invalid")
                }
            } else if (markLength != 0L || markHash != "ABSENT" || snapshot.exists()) {
                throw IllegalStateException("absent_snapshot_invalid")
            }
            val createdAt = properties.getProperty("createdAt")?.toLongOrNull()
                ?: throw IllegalStateException("created_at_invalid")
            val backup = NativeAnnotationBackup(
                manifest,
                snapshot,
                mark,
                manifestBytes.size.toLong(),
                manifestHash,
                documentPath,
                documentLength,
                documentHash,
                originalPresent,
                markLength,
                markHash,
                createdAt,
            )
            if (!nativeAnnotationBackupSourceFilesMatch(backup)) {
                throw IllegalStateException("backup_files_changed_during_verification")
            }
            NativeAnnotationBackupResult(backup, "verified")
            } catch (error: Throwable) {
                NativeAnnotationBackupResult(null, "invalid:${error.message}")
            }
        }
    }

    private fun nativeAnnotationBackupMap(
        backup: NativeAnnotationBackup,
        status: String,
    ) = Arguments.createMap().apply {
        putBoolean("backupAvailable", true)
        putString("backupStatus", status)
        putString("backupManifestPath", backup.manifest.absolutePath)
        putBoolean("backupOriginalMarkPresent", backup.originalMarkPresent)
        putDouble("backupCreatedAt", backup.createdAt.toDouble())
    }

    private fun sameNativeAnnotationBackup(
        expected: NativeAnnotationBackup,
        actual: NativeAnnotationBackup,
    ): Boolean =
        expected.manifest.canonicalPath == actual.manifest.canonicalPath &&
            expected.snapshot.canonicalPath == actual.snapshot.canonicalPath &&
            expected.mark.canonicalPath == actual.mark.canonicalPath &&
            expected.manifestLength == actual.manifestLength &&
            expected.manifestSha256 == actual.manifestSha256 &&
            expected.documentPath == actual.documentPath &&
            expected.documentLength == actual.documentLength &&
            expected.documentSha256 == actual.documentSha256 &&
            expected.originalMarkPresent == actual.originalMarkPresent &&
            expected.markLength == actual.markLength &&
            expected.markSha256 == actual.markSha256 &&
            expected.createdAt == actual.createdAt

    private fun nativeMarkRecoveryJournalMatchesBackup(
        journal: NativeMarkRecoveryJournal,
        backup: NativeAnnotationBackup,
    ): Boolean =
        journal.documentPath == backup.documentPath &&
            journal.documentLength == backup.documentLength &&
            journal.documentSha256 == backup.documentSha256 &&
            journal.markPath == backup.mark.canonicalPath &&
            journal.desiredMarkPresent == backup.originalMarkPresent &&
            journal.desiredMarkLength == backup.markLength &&
            journal.desiredMarkSha256 == backup.markSha256 &&
            journal.backupManifestPath == backup.manifest.canonicalPath &&
            journal.backupManifestLength == backup.manifestLength &&
            journal.backupManifestSha256 == backup.manifestSha256 &&
            journal.backupSnapshotPath == backup.snapshot.canonicalPath &&
            journal.createdAt == backup.createdAt

    private fun liveNativeAnnotationMatchesRecoveryJournal(
        journal: NativeMarkRecoveryJournal,
    ): Boolean = runCatching {
        val live = readRegularFileAuthorityIfFile(
            File(journal.markPath),
            Int.MAX_VALUE.toLong(),
            requireNonEmpty = false,
            authorityLabel = "recovery-journal live annotation",
        )
        if (journal.desiredMarkPresent) {
            live != null &&
                live.bytes.size.toLong() == journal.desiredMarkLength &&
                sha256(live.bytes) == journal.desiredMarkSha256
        } else {
            live == null
        }
    }.getOrDefault(false)

    private fun publishNativeMarkRecoveryJournal(
        pdfFile: File,
        marker: File,
        backup: NativeAnnotationBackup,
    ): NativeMarkRecoveryJournal {
        require(readPersistedAuthorityIfFile(marker) == null) {
            "Native mark recovery journal destination is not absent"
        }
        require(nativeAnnotationBackupSourceFilesMatch(backup)) {
            "Native mark recovery journal backup authority changed"
        }
        val properties = Properties().apply {
            setProperty("version", NATIVE_MARK_RECOVERY_JOURNAL_VERSION.toString())
            setProperty("managedBy", "supernote-rtl-reader")
            setProperty("kind", NATIVE_MARK_RECOVERY_JOURNAL_KIND)
            setProperty("operationId", UUID.randomUUID().toString())
            setProperty("documentPath", backup.documentPath)
            setProperty("documentLength", backup.documentLength.toString())
            setProperty("documentSha256", backup.documentSha256)
            setProperty("markPath", backup.mark.canonicalPath)
            setProperty("desiredMarkPresent", backup.originalMarkPresent.toString())
            setProperty("desiredMarkLength", backup.markLength.toString())
            setProperty("desiredMarkSha256", backup.markSha256)
            setProperty("backupManifestPath", backup.manifest.canonicalPath)
            setProperty("backupManifestLength", backup.manifestLength.toString())
            setProperty("backupManifestSha256", backup.manifestSha256)
            setProperty("backupSnapshotPath", backup.snapshot.canonicalPath)
            setProperty("createdAt", backup.createdAt.toString())
        }
        val bytes = propertiesBytes(
            properties,
            "Supernote RTL native mark recovery fence",
        )
        registerNativeMarkRecoveryRequired(marker)
        try {
            val identity = createRegularFileNoClobber(
                marker,
                bytes,
                "native mark recovery journal",
            )
            val published = readPersistedAuthorityIfFile(marker)
                ?: throw IllegalStateException(
                    "Native mark recovery journal disappeared after publication",
                )
            require(
                samePersistedFileVersion(identity, published.identity) &&
                    published.bytes.contentEquals(bytes)
            ) {
                "Native mark recovery journal changed after publication"
            }
            val inspection = inspectNativeMarkRecoveryFence(pdfFile, marker)
            val journal = inspection.journal ?: throw IllegalStateException(
                "Published native mark recovery journal was not re-admitted: " +
                    inspection.reason,
            )
            require(nativeMarkRecoveryJournalMatchesBackup(journal, backup)) {
                "Published native mark recovery journal disagrees with backup"
            }
            Log.i(
                LOG_TAG,
                "RTL_READER_NATIVE_MARK_RECOVERY_JOURNAL_PUBLISHED operation=${journal.operationId}",
            )
            return journal
        } catch (error: Throwable) {
            throw NativeMarkRecoveryRequiredException(
                "Native mark recovery fence could not be proven durable; " +
                    "DocumentActivity must remain stopped",
                error,
            )
        }
    }

    private fun retireNativeMarkRecoveryJournal(
        pdfFile: File,
        expected: NativeMarkRecoveryJournal,
        onCommitProven: () -> Unit,
    ) {
        val inspection = inspectNativeMarkRecoveryFence(pdfFile, expected.marker)
        val current = inspection.journal ?: throw NativeMarkRecoveryRequiredException(
            "Native mark recovery journal is not available for exact retirement",
            IllegalStateException(inspection.reason),
        )
        require(
            current.operationId == expected.operationId &&
                samePersistedAuthority(expected.authority, current.authority)
        ) {
            "Native mark recovery journal changed before retirement"
        }
        require(liveNativeAnnotationMatchesRecoveryJournal(expected)) {
            "Restored native annotation no longer matches its recovery journal"
        }
        // Both durable authority objects have now been freshly re-read and
        // proven exact. Publish the irreversible commit boundary immediately
        // before attempting the no-clobber journal retirement.
        onCommitProven()
        val displaced = try {
            preserveRegularDestinationNoClobber(
                expected.marker,
                current.authority,
                "native mark recovery journal retirement",
            ) {}
        } catch (error: Throwable) {
            throw NativeMarkRecoveryRequiredException(
                "Native mark recovery journal could not be retired exactly",
                error,
            )
        }
        require(pathIdentityNoFollow(expected.marker) == null) {
            "Native mark recovery journal reappeared after retirement"
        }
        clearNativeMarkRecoveryRequired(expected.marker)
        runCatching {
            retireDisplacedRegularFile(displaced, "native mark recovery journal")
        }.onFailure { cleanupError ->
            Log.w(
                LOG_TAG,
                "RTL_READER_NATIVE_MARK_RECOVERY_JOURNAL_CLEANUP_DEFERRED",
                cleanupError,
            )
        }
        Log.i(
            LOG_TAG,
            "RTL_READER_NATIVE_MARK_RECOVERY_JOURNAL_RETIRED operation=${expected.operationId}",
        )
    }

    private fun nativeAnnotationBackupSourceFilesMatch(
        backup: NativeAnnotationBackup,
    ): Boolean = runCatching {
        !File("${backup.snapshot.absolutePath}.retiring").exists() &&
            backup.manifest.isFile &&
            backup.manifest.length() == backup.manifestLength &&
            sha256(backup.manifest) == backup.manifestSha256 &&
            (
                if (backup.originalMarkPresent) {
                    backup.snapshot.isFile &&
                        backup.snapshot.length() == backup.markLength &&
                        sha256(backup.snapshot) == backup.markSha256
                } else {
                    !backup.snapshot.exists() &&
                        backup.markLength == 0L &&
                        backup.markSha256 == "ABSENT"
                }
            )
    }.getOrDefault(false)

    private fun protectedEditableSessionMarkerValid(
        pdfFile: File,
        properties: Properties,
        backup: NativeAnnotationBackup?,
    ): Boolean =
        protectedEditableMarkerValid(pdfFile, properties, backup) ||
            legacyProtectedEditableMarkerValid(pdfFile, properties, backup)

    private fun transactionalEditableMarkerMatchesBackup(
        pdfFile: File,
        properties: Properties,
        backup: NativeAnnotationBackup,
        activationState: String,
    ): Boolean = runCatching {
        val activationToken = properties.getProperty("activationToken", "")
        val canonicalActivationToken =
            UUID.fromString(activationToken).toString() == activationToken
        val originalMarkText = properties.getProperty("originalMarkPresent", "")
        val originalMarkPresent = when (originalMarkText) {
            "true" -> true
            "false" -> false
            else -> throw IllegalStateException("marker_original_presence_invalid")
        }
        val documentLength = properties.getProperty("documentLength")?.toLongOrNull()
        val backupManifestLength =
            properties.getProperty("backupManifestLength")?.toLongOrNull()
        val markLength = properties.getProperty("markLength")?.toLongOrNull()
        val backupCreatedAt = properties.getProperty("backupCreatedAt")?.toLongOrNull()
        val booleanValuesValid = listOf(
            properties.getProperty("coverSeparate", ""),
            properties.getProperty("showDivider", ""),
            properties.getProperty("showHeader", ""),
        ).all { value -> value == "true" || value == "false" }
        val pendingOnlyKeys = listOf(
            "pendingIntent",
            "previousMarkerPresent",
            "previousMarkerProtected",
            "previousMarkerLength",
            "previousMarkerSha256",
            "previousMarkerBase64",
        )
        properties.getProperty("enabled", "") == "true" &&
            properties.getProperty("nativeReaderEngine", "") ==
                "native-reader-v2" &&
            properties.getProperty("direction", "") == "rtl" &&
            properties.getProperty("editable", "") == "true" &&
            properties.getProperty("disposable", "") == "false" &&
            properties.getProperty("mode", "") == NATIVE_SPREAD_EDITABLE_MODE &&
            properties.getProperty("transactionProtocol", "") ==
                NATIVE_SPREAD_EDITABLE_MARKER_PROTOCOL.toString() &&
            properties.getProperty("minimumModuleVersionCode", "") ==
                NATIVE_READER_V2_MIN_VERSION_CODE.toString() &&
            properties.getProperty("activationState", "") == activationState &&
            (activationState != NATIVE_SPREAD_ACTIVATION_COMMITTED ||
                pendingOnlyKeys.none { key -> properties.containsKey(key) }) &&
            canonicalActivationToken &&
            properties.getProperty("managedBy", "") == "supernote-rtl-reader" &&
            properties.getProperty("backupVerified", "") == "true" &&
            booleanValuesValid &&
            (
                properties.getProperty("spreadSizing", "") == "fit" ||
                    properties.getProperty("spreadSizing", "") == "native_fill"
                ) &&
            File(properties.getProperty("documentPath", "")).canonicalPath ==
                pdfFile.canonicalPath &&
            documentLength == backup.documentLength &&
            documentLength == pdfFile.length() &&
            properties.getProperty("documentSha256", "") ==
                backup.documentSha256 &&
            backup.documentPath == pdfFile.canonicalPath &&
            backup.documentSha256 == sha256(pdfFile) &&
            File(properties.getProperty("backupManifestPath", "")).canonicalPath ==
                backup.manifest.canonicalPath &&
            backupManifestLength == backup.manifestLength &&
            properties.getProperty("backupManifestSha256", "") ==
                backup.manifestSha256 &&
            File(properties.getProperty("backupSnapshotPath", "")).canonicalPath ==
                backup.snapshot.canonicalPath &&
            File(properties.getProperty("markPath", "")).canonicalPath ==
                backup.mark.canonicalPath &&
            originalMarkPresent == backup.originalMarkPresent &&
            markLength == backup.markLength &&
            properties.getProperty("markSha256", "") == backup.markSha256 &&
            backupCreatedAt == backup.createdAt &&
            nativeAnnotationBackupSourceFilesMatch(backup)
    }.getOrDefault(false)

    private fun readPendingEditableActivation(
        pdfFile: File,
        properties: Properties,
        backup: NativeAnnotationBackup? = null,
    ): PendingEditableActivation? = runCatching {
        val activationToken = properties.getProperty("activationToken", "")
        val pendingIntent = properties.getProperty("pendingIntent", "")
        val canonicalActivationToken =
            UUID.fromString(activationToken).toString() == activationToken
        val originalMarkText = properties.getProperty("originalMarkPresent", "")
        val previousMarkerPresentText =
            properties.getProperty("previousMarkerPresent", "")
        val previousMarkerProtectedText =
            properties.getProperty("previousMarkerProtected", "")
        if (!canonicalActivationToken ||
            properties.getProperty("enabled", "") != "true" ||
            properties.getProperty("direction", "") != "rtl" ||
            properties.getProperty("editable", "") != "true" ||
            properties.getProperty("disposable", "") != "false" ||
            properties.getProperty("managedBy", "") != "supernote-rtl-reader" ||
            properties.getProperty("mode", "") != NATIVE_SPREAD_EDITABLE_MODE ||
            properties.getProperty("transactionProtocol", "") !=
                NATIVE_SPREAD_EDITABLE_MARKER_PROTOCOL.toString() ||
            properties.getProperty("minimumModuleVersionCode", "") !=
                NATIVE_READER_V2_MIN_VERSION_CODE.toString() ||
            properties.getProperty("activationState", "") !=
                NATIVE_SPREAD_ACTIVATION_PENDING ||
            (
                pendingIntent != NATIVE_SPREAD_PENDING_ENABLE_EDITABLE &&
                    pendingIntent != NATIVE_SPREAD_PENDING_READ_ONLY &&
                    pendingIntent != NATIVE_SPREAD_PENDING_DISABLE
                ) ||
            properties.getProperty("backupVerified", "") != "true" ||
            (originalMarkText != "true" && originalMarkText != "false") ||
            (previousMarkerPresentText != "true" &&
                previousMarkerPresentText != "false") ||
            (previousMarkerProtectedText != "true" &&
                previousMarkerProtectedText != "false") ||
            listOf(
                properties.getProperty("coverSeparate", ""),
                properties.getProperty("showDivider", ""),
                properties.getProperty("showHeader", ""),
            ).any { value -> value != "true" && value != "false" } ||
            (
                properties.getProperty("spreadSizing", "") != "fit" &&
                    properties.getProperty("spreadSizing", "") != "native_fill"
                )
        ) {
            throw IllegalStateException("pending_marker_schema_invalid")
        }

        val documentPath =
            File(properties.getProperty("documentPath", "")).canonicalPath
        val documentLength = properties.getProperty("documentLength")?.toLongOrNull()
            ?: throw IllegalStateException("pending_document_length_invalid")
        val documentSha256 = properties.getProperty("documentSha256", "")
        val backupManifestPath =
            File(properties.getProperty("backupManifestPath", "")).canonicalPath
        val backupManifestLength =
            properties.getProperty("backupManifestLength")?.toLongOrNull()
                ?: throw IllegalStateException("pending_manifest_length_invalid")
        val backupManifestSha256 =
            properties.getProperty("backupManifestSha256", "")
        val backupSnapshotPath =
            File(properties.getProperty("backupSnapshotPath", "")).canonicalPath
        val markPath = File(properties.getProperty("markPath", "")).canonicalPath
        val originalMarkPresent = originalMarkText == "true"
        val markLength = properties.getProperty("markLength")?.toLongOrNull()
            ?: throw IllegalStateException("pending_mark_length_invalid")
        val markSha256 = properties.getProperty("markSha256", "")
        val backupCreatedAt = properties.getProperty("backupCreatedAt")?.toLongOrNull()
            ?: throw IllegalStateException("pending_created_at_invalid")
        val previousMarkerPresent = previousMarkerPresentText == "true"
        val previousMarkerProtected = previousMarkerProtectedText == "true"
        val previousMarkerLength =
            properties.getProperty("previousMarkerLength")?.toLongOrNull()
                ?: throw IllegalStateException("pending_previous_length_invalid")
        val previousMarkerSha256 =
            properties.getProperty("previousMarkerSha256", "")
        val previousMarkerBase64 =
            properties.getProperty("previousMarkerBase64", "")
        val previousMarkerBytes = if (previousMarkerPresent) {
            Base64.getDecoder().decode(previousMarkerBase64)
        } else {
            null
        }

        if (documentPath != pdfFile.canonicalPath ||
            documentLength < 0L ||
            documentSha256.length != 64 ||
            backupManifestPath != nativeAnnotationBackupManifest(pdfFile).canonicalPath ||
            backupManifestLength < 0L ||
            backupManifestSha256.length != 64 ||
            backupSnapshotPath != nativeAnnotationBackupSnapshot(pdfFile).canonicalPath ||
            markPath != nativeAnnotationMark(pdfFile).canonicalPath ||
            markLength < 0L ||
            (originalMarkPresent && markSha256.length != 64) ||
            (!originalMarkPresent && (markLength != 0L || markSha256 != "ABSENT")) ||
            backupCreatedAt < 0L ||
            previousMarkerLength < 0L ||
            (
                if (previousMarkerPresent) {
                    previousMarkerBytes == null ||
                        previousMarkerBytes.size.toLong() != previousMarkerLength ||
                        previousMarkerSha256.length != 64 ||
                        sha256(previousMarkerBytes) != previousMarkerSha256
                } else {
                    previousMarkerLength != 0L ||
                        previousMarkerSha256 != "ABSENT" ||
                        previousMarkerBase64.isNotEmpty() ||
                        previousMarkerProtected
                }
                ) ||
            (previousMarkerProtected && previousMarkerBytes == null)
        ) {
            throw IllegalStateException("pending_marker_identity_invalid")
        }

        val pending = PendingEditableActivation(
            activationToken,
            pendingIntent,
            documentPath,
            documentLength,
            documentSha256,
            backupManifestPath,
            backupManifestLength,
            backupManifestSha256,
            backupSnapshotPath,
            markPath,
            originalMarkPresent,
            markLength,
            markSha256,
            backupCreatedAt,
            previousMarkerBytes,
            previousMarkerProtected,
        )
        if (backup != null) {
            val previousProperties = pending.previousMarkerBytes?.let { bytes ->
                strictNativeSpreadMarkerProperties(bytes)
            } ?: Properties()
            val previousActuallyProtected = pending.previousMarkerBytes != null &&
                protectedEditableSessionMarkerValid(
                    pdfFile,
                    previousProperties,
                    backup,
                )
            if (!transactionalEditableMarkerMatchesBackup(
                    pdfFile,
                    properties,
                    backup,
                    NATIVE_SPREAD_ACTIVATION_PENDING,
                ) ||
                pending.previousMarkerProtected != previousActuallyProtected
            ) {
                throw IllegalStateException("pending_marker_backup_mismatch")
            }
        }
        pending
    }.getOrNull()

    private fun pendingActivationMatchesEvidence(
        pending: PendingEditableActivation,
        evidence: FailedActivationBackupEvidence,
    ): Boolean =
        pending.activationToken == evidence.archive.activationToken &&
            pending.documentPath == evidence.documentPath &&
            pending.documentLength == evidence.documentLength &&
            pending.documentSha256 == evidence.documentSha256 &&
            pending.backupManifestPath == evidence.canonicalManifestPath &&
            pending.backupManifestLength == evidence.sourceManifestLength &&
            pending.backupManifestSha256 == evidence.sourceManifestSha256 &&
            pending.backupSnapshotPath == evidence.canonicalSnapshotPath &&
            pending.markPath == evidence.markPath &&
            pending.originalMarkPresent == evidence.originalMarkPresent &&
            pending.markLength == evidence.markLength &&
            pending.markSha256 == evidence.markSha256 &&
            pending.backupCreatedAt == evidence.createdAt

    private fun protectedEditableMarkerValid(
        pdfFile: File,
        properties: Properties,
        backup: NativeAnnotationBackup?,
    ): Boolean {
        backup ?: return false
        return transactionalEditableMarkerMatchesBackup(
            pdfFile,
            properties,
            backup,
            NATIVE_SPREAD_ACTIVATION_COMMITTED,
        )
    }

    private fun legacyProtectedEditableMarkerValid(
        pdfFile: File,
        properties: Properties,
        backup: NativeAnnotationBackup?,
    ): Boolean {
        backup ?: return false
        return runCatching {
            if (!properties.getProperty("enabled", "false").equals("true", true) ||
                !properties.getProperty("direction", "").equals("rtl", true) ||
                !properties.getProperty("editable", "false").equals("true", true) ||
                properties.getProperty("disposable", "false").equals("true", true) ||
                properties.getProperty("mode", "") !=
                    NATIVE_SPREAD_LEGACY_EDITABLE_MODE ||
                properties.getProperty("managedBy", "") != "supernote-rtl-reader" ||
                !properties.getProperty("backupVerified", "false")
                    .equals("true", true) ||
                File(properties.getProperty("documentPath", "")).canonicalPath !=
                    pdfFile.canonicalPath ||
                backup.documentPath != pdfFile.canonicalPath ||
                backup.documentLength != pdfFile.length() ||
                File(properties.getProperty("backupManifestPath", "")).canonicalPath !=
                    backup.manifest.canonicalPath ||
                properties.getProperty("backupManifestSha256", "") !=
                    backup.manifestSha256 ||
                backup.manifestSha256 != sha256(backup.manifest)
            ) {
                false
            } else {
                nativeAnnotationBackupSourceFilesMatch(backup)
            }
        }.getOrDefault(false)
    }

    private fun writePropertiesAtomically(
        file: File,
        properties: Properties,
        comment: String,
        onPublished: () -> Unit = {},
        beforePublish: () -> Unit = {},
    ) {
        val bytes = propertiesBytes(properties, comment)
        writeBytesAtomically(
            file,
            bytes,
            onPublished = onPublished,
            beforePublish = beforePublish,
        )
    }

    /**
     * Serializes marker compare-and-publish across every PluginHost process.
     * The persistent lock inode and its parent directory remain open and are
     * revalidated for the full critical section. The in-process monitor avoids
     * FileChannel's overlapping-lock exception when two module instances in the
     * same VM race for the same OS lock.
     */
    private fun <T> withNativeSpreadPublicationLock(
        marker: File,
        action: () -> T,
    ): T = synchronized(NATIVE_SPREAD_PUBLICATION_PROCESS_LOCK) {
        val parent = marker.parentFile
            ?: throw IllegalStateException("Native Spread marker has no parent")
        val parentDescriptor = openPinnedDirectory(
            parent,
            "Native Spread publication-lock parent",
        )
        try {
            val parentIdentity = Os.fstat(parentDescriptor)
            require(OsConstants.S_ISDIR(parentIdentity.st_mode)) {
                "Native Spread marker parent is not a directory"
            }
            require(sameFileObject(parentIdentity, Os.lstat(parent.absolutePath))) {
                "Native Spread marker parent path changed before locking"
            }

            val lockFile = File(parent, marker.name + NATIVE_SPREAD_PUBLICATION_LOCK_SUFFIX)
            val lockDescriptor = Os.open(
                lockFile.absolutePath,
                OsConstants.O_RDWR or OsConstants.O_CREAT or
                    OsConstants.O_CLOEXEC or OsConstants.O_NOFOLLOW,
                0x180, // 0600
            )
            try {
                val lockIdentity = Os.fstat(lockDescriptor)
                require(
                    OsConstants.S_ISREG(lockIdentity.st_mode) &&
                        lockIdentity.st_nlink == 1L &&
                        sameFileObject(lockIdentity, Os.lstat(lockFile.absolutePath)),
                ) {
                    "Native Spread publication lock authority is invalid"
                }
                Os.fsync(parentDescriptor)
                FileOutputStream(Os.dup(lockDescriptor)).channel.use { channel ->
                    channel.lock().use {
                        require(
                            sameFileObject(parentIdentity, Os.fstat(parentDescriptor)) &&
                                sameFileObject(parentIdentity, Os.lstat(parent.absolutePath)) &&
                                samePersistedFileVersion(
                                    lockIdentity,
                                    Os.fstat(lockDescriptor),
                                ) &&
                                samePersistedFileVersion(
                                    lockIdentity,
                                    Os.lstat(lockFile.absolutePath),
                                ),
                        ) {
                            "Native Spread publication lock or parent was replaced"
                        }
                        val result = action()
                        require(
                            sameFileObject(parentIdentity, Os.fstat(parentDescriptor)) &&
                                sameFileObject(parentIdentity, Os.lstat(parent.absolutePath)) &&
                                samePersistedFileVersion(
                                    lockIdentity,
                                    Os.fstat(lockDescriptor),
                                ) &&
                                samePersistedFileVersion(
                                    lockIdentity,
                                    Os.lstat(lockFile.absolutePath),
                                ),
                        ) {
                            "Native Spread publication authority changed while locked"
                        }
                        result
                    }
                }
            } finally {
                Os.close(lockDescriptor)
            }
        } finally {
            Os.close(parentDescriptor)
        }
    }

    private fun samePersistedAuthority(
        expected: PersistedFileAuthority?,
        actual: PersistedFileAuthority?,
    ): Boolean = when {
        expected == null -> actual == null
        actual == null -> false
        else -> samePersistedFileVersion(expected.identity, actual.identity) &&
            expected.bytes.contentEquals(actual.bytes)
    }

    private fun writePropertiesAtomicallyCas(
        file: File,
        properties: Properties,
        comment: String,
        expected: PersistedFileAuthority?,
        onPublished: () -> Unit = {},
        beforePublish: () -> Unit = {},
    ) {
        val bytes = propertiesBytes(properties, comment)
        writeBytesAtomicallyCas(
            file,
            bytes,
            expected,
            onPublished,
            beforePublish,
        )
    }

    private fun propertiesBytes(properties: Properties, comment: String): ByteArray =
        ByteArrayOutputStream().use { buffer ->
            properties.store(buffer, comment)
            buffer.toByteArray()
        }

    /**
     * Publishes only over the exact destination inode/version observed by the
     * caller (or over proven absence), while the cross-process marker lock is
     * held. Temporary creation is exclusive and no-follow; its inode and the
     * parent directory are pinned across fsync and the atomic rename.
     */
    private fun writeBytesAtomicallyCas(
        file: File,
        bytes: ByteArray,
        expected: PersistedFileAuthority?,
        onPublished: () -> Unit = {},
        beforePublish: () -> Unit = {},
    ) {
        val parent = file.parentFile
            ?: throw IllegalStateException("Published file has no parent directory")
        val parentDescriptor = openPinnedDirectory(
            parent,
            "Published-file parent",
        )
        val temporary = File(
            parent,
            ".${file.name}.cas-${android.os.Process.myPid()}-${UUID.randomUUID()}",
        )
        var temporaryDescriptor: FileDescriptor? = null
        try {
            val parentIdentity = Os.fstat(parentDescriptor)
            require(
                OsConstants.S_ISDIR(parentIdentity.st_mode) &&
                    sameFileObject(parentIdentity, Os.lstat(parent.absolutePath)),
            ) {
                "Publication parent authority is invalid"
            }
            val openedTemporary = Os.open(
                temporary.absolutePath,
                OsConstants.O_WRONLY or OsConstants.O_CREAT or
                    OsConstants.O_EXCL or OsConstants.O_CLOEXEC or
                    OsConstants.O_NOFOLLOW,
                0x180, // 0600
            )
            temporaryDescriptor = openedTemporary
            FileOutputStream(Os.dup(openedTemporary)).use { output ->
                output.write(bytes)
                output.flush()
                output.fd.sync()
            }
            val stagedIdentity = Os.fstat(openedTemporary)
            require(
                OsConstants.S_ISREG(stagedIdentity.st_mode) &&
                    stagedIdentity.st_nlink == 1L &&
                    stagedIdentity.st_size == bytes.size.toLong() &&
                    samePersistedFileVersion(
                        stagedIdentity,
                        Os.lstat(temporary.absolutePath),
                    ),
            ) {
                "Staged publication authority changed"
            }

            beforePublish()
            val immediate = readPersistedAuthorityIfFile(file)
            require(samePersistedAuthority(expected, immediate)) {
                "Published destination changed before compare-and-publish"
            }
            require(
                sameFileObject(parentIdentity, Os.fstat(parentDescriptor)) &&
                    sameFileObject(parentIdentity, Os.lstat(parent.absolutePath)) &&
                    samePersistedFileVersion(
                        stagedIdentity,
                        Os.fstat(openedTemporary),
                    ) &&
                    samePersistedFileVersion(
                        stagedIdentity,
                        Os.lstat(temporary.absolutePath),
                    ),
            ) {
                "Publication source or parent changed before compare-and-publish"
            }

            Os.rename(temporary.absolutePath, file.absolutePath)
            // Android's emulated-storage FUSE layer legitimately advances
            // ctime when the staged inode is renamed into its published path.
            // Compare the still-open staged descriptor across the rename by
            // object identity, then use its post-rename version as the exact
            // authority for the descriptor-backed destination read. This
            // accepts the rename metadata transition without weakening the
            // destination-substitution or post-read path fences.
            val renamedStagedIdentity = try {
                Os.fstat(openedTemporary)
            } finally {
                // Rename is the irreversible publication boundary. Record it
                // exactly once even when the post-rename descriptor snapshot
                // itself fails, so callers never roll an already-authorizing
                // committed marker back as though publication had not happened.
                onPublished()
            }
            val published = readPersistedAuthorityIfFile(file)
                ?: throw IllegalStateException("Published destination disappeared")
            require(
                sameFileObject(stagedIdentity, renamedStagedIdentity) &&
                    samePersistedFileVersion(
                        renamedStagedIdentity,
                        published.identity,
                    ) &&
                    samePersistedFileVersion(
                        published.identity,
                        Os.lstat(file.absolutePath),
                    ) &&
                    published.bytes.contentEquals(bytes) &&
                    sameFileObject(parentIdentity, Os.fstat(parentDescriptor)) &&
                    sameFileObject(parentIdentity, Os.lstat(parent.absolutePath)),
            ) {
                "Published destination or parent changed after atomic publication"
            }
            Os.fsync(parentDescriptor)
        } finally {
            temporaryDescriptor?.let { descriptor ->
                runCatching { Os.close(descriptor) }
            }
            runCatching {
                val staged = Os.lstat(temporary.absolutePath)
                if (OsConstants.S_ISREG(staged.st_mode) && staged.st_nlink == 1L) {
                    Files.deleteIfExists(temporary.toPath())
                }
            }
            Os.close(parentDescriptor)
        }
    }

    private fun pathIdentityNoFollow(file: File): StructStat? = try {
        Os.lstat(file.absolutePath)
    } catch (missing: ErrnoException) {
        if (missing.errno == OsConstants.ENOENT) null else throw missing
    }

    private fun requireExpectedRegularDestination(
        file: File,
        expected: StructStat?,
        authorityLabel: String,
    ) {
        val actual = pathIdentityNoFollow(file)
        require(
            if (expected == null) {
                actual == null
            } else {
                actual != null &&
                    OsConstants.S_ISREG(actual.st_mode) &&
                    actual.st_nlink == 1L &&
                    samePersistedFileVersion(expected, actual)
            },
        ) {
            "$authorityLabel destination identity changed"
        }
    }

    // Marker files are serialized by withNativeSpreadPublicationLock. Native
    // annotation (.mark) bytes deliberately do not use this helper; they use
    // the preserve-displaced/O_EXCL protocol below.
    private fun deleteRegularFileCas(
        file: File,
        expected: StructStat,
        authorityLabel: String,
    ) {
        val parent = file.parentFile
            ?: throw IllegalStateException("$authorityLabel destination has no parent")
        val parentDescriptor = openPinnedDirectory(
            parent,
            "$authorityLabel deletion parent",
        )
        try {
            val parentIdentity = Os.fstat(parentDescriptor)
            requireExpectedRegularDestination(file, expected, authorityLabel)
            require(
                sameFileObject(parentIdentity, Os.fstat(parentDescriptor)) &&
                    sameFileObject(parentIdentity, Os.lstat(parent.absolutePath)),
            ) {
                "$authorityLabel parent changed before deletion"
            }
            Files.delete(file.toPath())
            require(pathIdentityNoFollow(file) == null) {
                "$authorityLabel destination reappeared after deletion"
            }
            Os.fsync(parentDescriptor)
        } finally {
            Os.close(parentDescriptor)
        }
    }

    private fun sameRegularFileAuthority(
        expected: PersistedFileAuthority?,
        actual: PersistedFileAuthority?,
    ): Boolean = when {
        expected == null -> actual == null
        actual == null -> false
        else -> samePersistedFileVersion(expected.identity, actual.identity) &&
            expected.bytes.contentEquals(actual.bytes)
    }

    /**
     * Moves the admitted destination to a unique recovery name before its path
     * can be reused. Android's public Os API does not expose renameat2(2), so a
     * check followed by a replacing rename is never used for native .mark
     * publication. A racing path is moved aside rather than overwritten and is
     * then rejected by the descriptor/byte comparison. Thus every displaced
     * inode survives, including one introduced between admission and rename.
     */
    private fun preserveRegularDestinationNoClobber(
        file: File,
        expected: PersistedFileAuthority?,
        authorityLabel: String,
        beforePublish: () -> Unit,
    ): DisplacedRegularFile? {
        val parent = file.parentFile
            ?: throw IllegalStateException("$authorityLabel destination has no parent")
        val parentDescriptor = openPinnedDirectory(
            parent,
            "$authorityLabel preservation parent",
        )
        try {
            val parentIdentity = Os.fstat(parentDescriptor)
            require(
                OsConstants.S_ISDIR(parentIdentity.st_mode) &&
                    sameFileObject(parentIdentity, Os.lstat(parent.absolutePath))
            ) {
                "$authorityLabel parent authority is invalid"
            }

            beforePublish()
            val immediate = readRegularFileAuthorityIfFile(
                file,
                Int.MAX_VALUE.toLong(),
                requireNonEmpty = false,
                authorityLabel = "$authorityLabel destination",
            )
            require(sameRegularFileAuthority(expected, immediate)) {
                "$authorityLabel destination changed before preservation"
            }
            require(
                sameFileObject(parentIdentity, Os.fstat(parentDescriptor)) &&
                    sameFileObject(parentIdentity, Os.lstat(parent.absolutePath))
            ) {
                "$authorityLabel parent changed before preservation"
            }
            if (immediate == null) return null

            val transactionDirectory = File(
                parent,
                ".${file.name}.transaction-${android.os.Process.myPid()}-${UUID.randomUUID()}",
            )
            Files.createDirectory(transactionDirectory.toPath())
            val transactionDirectoryDescriptor = openPinnedDirectory(
                transactionDirectory,
                "$authorityLabel transaction directory",
            )
            try {
                val transactionDirectoryIdentity = Os.fstat(transactionDirectoryDescriptor)
                val displaced = File(transactionDirectory, "displaced")
                var renameCompleted = false
                var movedAuthority: PersistedFileAuthority? = null
                try {
                    require(
                        OsConstants.S_ISDIR(transactionDirectoryIdentity.st_mode) &&
                            samePersistedFileVersion(
                                transactionDirectoryIdentity,
                                Os.lstat(transactionDirectory.absolutePath),
                            ) &&
                            sameFileObject(parentIdentity, Os.fstat(parentDescriptor)) &&
                            sameFileObject(parentIdentity, Os.lstat(parent.absolutePath)) &&
                            pathIdentityNoFollow(displaced) == null
                    ) {
                        "$authorityLabel private displacement directory is invalid"
                    }
                    Os.rename(file.absolutePath, displaced.absolutePath)
                    renameCompleted = true
                    Os.fsync(transactionDirectoryDescriptor)
                    Os.fsync(parentDescriptor)
                    val moved = readRegularFileAuthorityIfFile(
                        displaced,
                        Int.MAX_VALUE.toLong(),
                        requireNonEmpty = false,
                        authorityLabel = "$authorityLabel displaced destination",
                    ) ?: throw IllegalStateException(
                        "$authorityLabel displaced destination disappeared",
                    )
                    movedAuthority = moved
                    require(
                        sameRegularFileAuthority(expected, moved) &&
                            sameFileObject(parentIdentity, Os.fstat(parentDescriptor)) &&
                            sameFileObject(parentIdentity, Os.lstat(parent.absolutePath)) &&
                            sameFileObject(
                                transactionDirectoryIdentity,
                                Os.fstat(transactionDirectoryDescriptor),
                            ) &&
                            sameFileObject(
                                transactionDirectoryIdentity,
                                Os.lstat(transactionDirectory.absolutePath),
                            )
                    ) {
                        "$authorityLabel raced with destination preservation; displaced inode retained"
                    }
                    require(pathIdentityNoFollow(file) == null) {
                        "$authorityLabel destination reappeared after preservation"
                    }
                    return DisplacedRegularFile(
                        displaced,
                        moved.identity,
                        moved.bytes,
                        transactionDirectory,
                        transactionDirectoryIdentity,
                    )
                } catch (failure: Throwable) {
                    if (!renameCompleted) throw failure

                    // A process can start immediately after the sampled
                    // process-absence fence and mutate or replace the .mark
                    // before rename(2). A rejected rename must never leave an
                    // absent live annotation path when its moved bytes can be
                    // restored without clobbering. The displaced inode remains
                    // retained recovery evidence until a later explicit
                    // retirement transaction.
                    val pathAuthoritiesStillOwned = runCatching {
                        sameFileObject(parentIdentity, Os.fstat(parentDescriptor)) &&
                            sameFileObject(parentIdentity, Os.lstat(parent.absolutePath)) &&
                            sameFileObject(
                                transactionDirectoryIdentity,
                                Os.fstat(transactionDirectoryDescriptor),
                            ) &&
                            sameFileObject(
                                transactionDirectoryIdentity,
                                Os.lstat(transactionDirectory.absolutePath),
                            )
                    }.getOrDefault(false)
                    val retained = movedAuthority ?: runCatching {
                        readRegularFileAuthorityIfFile(
                            displaced,
                            Int.MAX_VALUE.toLong(),
                            requireNonEmpty = false,
                            authorityLabel =
                                "$authorityLabel rejected displaced destination",
                        )
                    }.getOrNull()
                    val live = runCatching {
                        readRegularFileAuthorityIfFile(
                            file,
                            Int.MAX_VALUE.toLong(),
                            requireNonEmpty = false,
                            authorityLabel = "$authorityLabel recovery destination",
                        )
                    }.getOrElse { recoveryReadError ->
                        throw NativeMarkRecoveryRequiredException(
                            "$authorityLabel requires explicit recovery; " +
                                "the live annotation path is ambiguous and " +
                                "displaced evidence was retained",
                            failure,
                        ).apply { addSuppressed(recoveryReadError) }
                    }

                    if (!pathAuthoritiesStillOwned || retained == null || live != null) {
                        throw NativeMarkRecoveryRequiredException(
                            "$authorityLabel requires explicit recovery; no live " +
                                "annotation path was overwritten and displaced " +
                                "evidence was retained",
                            failure,
                        )
                    }

                    try {
                        val restoredIdentity = createRegularFileNoClobber(
                            file,
                            retained.bytes,
                            "$authorityLabel rejected-preservation recovery",
                        )
                        val restored = readRegularFileAuthorityIfFile(
                            file,
                            Int.MAX_VALUE.toLong(),
                            requireNonEmpty = false,
                            authorityLabel = "$authorityLabel recovered destination",
                        ) ?: throw IllegalStateException(
                            "$authorityLabel recovered destination disappeared",
                        )
                        val retainedAfterRestore = readRegularFileAuthorityIfFile(
                            displaced,
                            Int.MAX_VALUE.toLong(),
                            requireNonEmpty = false,
                            authorityLabel =
                                "$authorityLabel retained displaced destination",
                        ) ?: throw IllegalStateException(
                            "$authorityLabel retained displaced destination disappeared",
                        )
                        require(
                            samePersistedFileVersion(
                                restoredIdentity,
                                restored.identity,
                            ) &&
                                retained.bytes.contentEquals(restored.bytes) &&
                                sameRegularFileAuthority(retained, retainedAfterRestore) &&
                                sameFileObject(
                                    parentIdentity,
                                    Os.fstat(parentDescriptor),
                                ) &&
                                sameFileObject(
                                    parentIdentity,
                                    Os.lstat(parent.absolutePath),
                                ) &&
                                sameFileObject(
                                    transactionDirectoryIdentity,
                                    Os.fstat(transactionDirectoryDescriptor),
                                ) &&
                                sameFileObject(
                                    transactionDirectoryIdentity,
                                    Os.lstat(transactionDirectory.absolutePath),
                                )
                        ) {
                            "$authorityLabel recovered destination or displaced " +
                                "evidence changed"
                        }
                    } catch (recoveryError: Throwable) {
                        throw NativeMarkRecoveryRequiredException(
                            "$authorityLabel requires explicit recovery; exact " +
                                "displaced bytes could not be restored without " +
                                "clobbering and evidence was retained",
                            failure,
                        ).apply { addSuppressed(recoveryError) }
                    }

                    // The live path again contains the exact bytes moved aside,
                    // and the original displaced inode remains intact as
                    // evidence. Preserve the rejection but permit the ordinary
                    // failure relaunch path.
                    throw failure
                }
            } finally {
                closeDescriptorWithoutMaskingRecovery(
                    transactionDirectoryDescriptor,
                    "$authorityLabel displacement directory",
                )
            }
        } finally {
            closeDescriptorWithoutMaskingRecovery(
                parentDescriptor,
                "$authorityLabel parent directory",
            )
        }
    }

    private fun closeDescriptorWithoutMaskingRecovery(
        descriptor: FileDescriptor,
        authorityLabel: String,
    ) {
        runCatching { Os.close(descriptor) }.onFailure { closeError ->
            // A read-only directory descriptor has no unflushed payload. A
            // cleanup failure must not replace a recovery-required exception or
            // prevent a successfully returned displacement from being followed
            // by its O_EXCL publication.
            Log.w(
                LOG_TAG,
                "RTL_READER_NATIVE_MARK_DESCRIPTOR_CLOSE_DEFERRED authority=$authorityLabel",
                closeError,
            )
        }
    }

    /** Creates the final path with O_EXCL; it can never overwrite a racer. */
    private fun createRegularFileNoClobber(
        file: File,
        bytes: ByteArray,
        authorityLabel: String,
    ): StructStat {
        val descriptor = Os.open(
            file.absolutePath,
            OsConstants.O_WRONLY or OsConstants.O_CREAT or
                OsConstants.O_EXCL or OsConstants.O_CLOEXEC or
                OsConstants.O_NOFOLLOW,
            0x180, // 0600
        )
        try {
            FileOutputStream(Os.dup(descriptor)).use { output ->
                output.write(bytes)
                output.flush()
                output.fd.sync()
            }
            val identity = Os.fstat(descriptor)
            require(
                OsConstants.S_ISREG(identity.st_mode) &&
                    identity.st_nlink == 1L &&
                    identity.st_size == bytes.size.toLong() &&
                    samePersistedFileVersion(
                        identity,
                        checkNotNull(pathIdentityNoFollow(file)),
                    ),
            ) {
                "$authorityLabel no-clobber destination changed while writing"
            }
            syncParentDirectory(file)
            return identity
        } finally {
            Os.close(descriptor)
        }
    }

    private fun publishRegularFileNoClobber(
        file: File,
        bytes: ByteArray,
        expected: PersistedFileAuthority?,
        authorityLabel: String,
        beforePublish: () -> Unit,
    ): NativeMarkPublication {
        val displaced = preserveRegularDestinationNoClobber(
            file,
            expected,
            authorityLabel,
            beforePublish,
        )
        try {
            val publishedIdentity = createRegularFileNoClobber(
                file,
                bytes,
                authorityLabel,
            )
            return NativeMarkPublication(
                file,
                publishedIdentity,
                bytes.copyOf(),
                expected != null,
                expected?.bytes?.copyOf(),
                displaced?.file,
                displaced?.identity,
                displaced?.transactionDirectory,
                displaced?.transactionDirectoryIdentity,
                true,
            )
        } catch (error: Throwable) {
            // A failed direct O_EXCL write may have left a partial file at the
            // live path. Preserve that inode (or any racer that replaced it)
            // before attempting recovery; never unlink or overwrite it.
            val recoveryErrors = mutableListOf<Throwable>()
            val failedDestination = try {
                readRegularFileAuthorityIfFile(
                    file,
                    Int.MAX_VALUE.toLong(),
                    requireNonEmpty = false,
                    authorityLabel = "$authorityLabel failed publication",
                )
            } catch (inspectionError: Throwable) {
                recoveryErrors.add(inspectionError)
                null
            }
            if (failedDestination != null) {
                try {
                    preserveRegularDestinationNoClobber(
                        file,
                        failedDestination,
                        "$authorityLabel failed publication",
                    ) {}
                } catch (preservationError: Throwable) {
                    recoveryErrors.add(preservationError)
                }
            }
            // If the path is still absent, reconstruct the admitted bytes with
            // O_EXCL. The original displaced inode remains until recovery is
            // verified, even if a racer prevents reconstruction.
            var recoveredIdentity: StructStat? = null
            val livePathAbsentBeforeRecovery = try {
                pathIdentityNoFollow(file) == null
            } catch (pathError: Throwable) {
                recoveryErrors.add(pathError)
                false
            }
            if (expected != null && livePathAbsentBeforeRecovery) {
                try {
                    recoveredIdentity = createRegularFileNoClobber(
                        file,
                        expected.bytes,
                        "$authorityLabel failed-publication recovery",
                    )
                } catch (recoveryError: Throwable) {
                    recoveryErrors.add(recoveryError)
                }
            }
            val recovered = try {
                readRegularFileAuthorityIfFile(
                    file,
                    Int.MAX_VALUE.toLong(),
                    requireNonEmpty = false,
                    authorityLabel = "$authorityLabel failed-publication recovery",
                )
            } catch (verificationError: Throwable) {
                recoveryErrors.add(verificationError)
                null
            }
            val desiredStateRestored = if (expected == null) {
                val livePathAbsentAfterRecovery = try {
                    pathIdentityNoFollow(file) == null
                } catch (pathError: Throwable) {
                    recoveryErrors.add(pathError)
                    false
                }
                recovered == null && livePathAbsentAfterRecovery
            } else {
                recoveredIdentity != null &&
                    recovered != null &&
                    samePersistedFileVersion(recoveredIdentity, recovered.identity) &&
                    expected.bytes.contentEquals(recovered.bytes)
            }
            val displacedEvidenceIntact = try {
                requireDisplacedRegularFileIntact(
                    displaced,
                    "$authorityLabel pre-publication displacement",
                )
                true
            } catch (evidenceError: Throwable) {
                recoveryErrors.add(evidenceError)
                false
            }
            if (!desiredStateRestored || !displacedEvidenceIntact) {
                throw NativeMarkRecoveryRequiredException(
                    "$authorityLabel requires explicit recovery after failed " +
                        "publication; admitted bytes are not proven at the live path",
                    error,
                ).apply {
                    recoveryErrors.forEach { recoveryError ->
                        addSuppressed(recoveryError)
                    }
                }
            }
            recoveryErrors.forEach { recoveryError -> error.addSuppressed(recoveryError) }
            throw error
        }
    }

    private fun publishRegularFileAbsenceNoClobber(
        file: File,
        expected: PersistedFileAuthority?,
        authorityLabel: String,
        beforePublish: () -> Unit,
    ): NativeMarkPublication {
        val displaced = preserveRegularDestinationNoClobber(
            file,
            expected,
            authorityLabel,
            beforePublish,
        )
        return NativeMarkPublication(
            file,
            null,
            null,
            expected != null,
            expected?.bytes?.copyOf(),
            displaced?.file,
            displaced?.identity,
            displaced?.transactionDirectory,
            displaced?.transactionDirectoryIdentity,
            displaced != null,
        )
    }

    private fun writeBytesAtomically(
        file: File,
        bytes: ByteArray,
        onPublished: () -> Unit = {},
        beforePublish: () -> Unit = {},
    ) {
        val temporary = File(
            file.parentFile,
            "${file.name}.tmp-${android.os.Process.myPid()}-${UUID.randomUUID()}",
        )
        try {
            writeBytesSynced(temporary, bytes)
            beforePublish()
            Os.rename(temporary.absolutePath, file.absolutePath)
            onPublished()
            syncParentDirectory(file)
        } finally {
            // No cleanup failure after the atomic rename may be mistaken for a
            // publication failure. Callers record the boundary synchronously.
            runCatching {
                if (temporary.exists()) temporary.delete()
            }
        }
    }

    private fun copyFileAtomically(
        source: File,
        destination: File,
        beforePublish: () -> Unit = {},
        onPublished: () -> Unit = {},
    ) {
        val temporary = File(
            destination.parentFile,
            "${destination.name}.tmp-${android.os.Process.myPid()}-${UUID.randomUUID()}",
        )
        try {
            FileInputStream(source).use { input ->
                FileOutputStream(temporary, false).use { output ->
                    input.copyTo(output, 64 * 1024)
                    output.flush()
                    output.fd.sync()
                }
            }
            beforePublish()
            Os.rename(temporary.absolutePath, destination.absolutePath)
            onPublished()
            syncParentDirectory(destination)
        } finally {
            if (temporary.exists()) temporary.delete()
        }
    }

    private fun sha256(file: File): String {
        val digest = MessageDigest.getInstance("SHA-256")
        val buffer = ByteArray(64 * 1024)
        FileInputStream(file).use { input ->
            while (true) {
                val count = input.read(buffer)
                if (count < 0) break
                if (count > 0) digest.update(buffer, 0, count)
            }
        }
        return digest.digest().joinToString("") { byte ->
            "%02x".format(byte.toInt() and 0xff)
        }
    }

    private fun renameFileDurably(source: File, destination: File) {
        Os.rename(source.absolutePath, destination.absolutePath)
        syncParentDirectory(destination)
        val sourceParent = source.parentFile?.absolutePath
        val destinationParent = destination.parentFile?.absolutePath
        if (sourceParent != null && sourceParent != destinationParent) {
            syncParentDirectory(source)
        }
    }

    private fun deleteFileDurably(file: File): Boolean {
        val deleted = runCatching { Files.deleteIfExists(file.toPath()) }
            .getOrElse { return false }
        if (!deleted) return true
        return runCatching {
            syncParentDirectory(file)
        }.isSuccess
    }

    private fun sha256(bytes: ByteArray): String =
        MessageDigest.getInstance("SHA-256")
            .digest(bytes)
            .joinToString("") { byte ->
                "%02x".format(byte.toInt() and 0xff)
            }

    /**
     * Experimental native-reader handoff.
     *
     * Hardware testing established that Supernote stores the native PDF position
     * in a Java-serialized HashMap and that PluginHost and SupernoteDocument both
     * run as UID 1000. The config update therefore needs no su access. v0.0.9
     * also avoids invoking the `am` shell utility: after PluginHost closes, a
     * background worker signals only the com.supernote.document PID and then
     * starts its private DocumentActivity directly through Android APIs.
     */
    @ReactMethod
    fun handoffLastSavedPage(promise: Promise) {
        val durableRecovery = lastSavedFilePath?.let { filePath ->
            runCatching {
                val pdfFile = requirePdf(filePath)
                inspectNativeMarkRecoveryFence(pdfFile).blocking
            }.getOrDefault(true)
        } == true
        if (nativeMarkRecoveryRequiredPending() || durableRecovery ||
            annotationRecoveryPending.get() ||
            annotationRecoveryHandoffPending.compareAndSet(true, false)
        ) {
            val reason = if (nativeMarkRecoveryRequiredPending() || durableRecovery) {
                "native_mark_recovery_required"
            } else {
                "annotation_recovery"
            }
            Log.i(LOG_TAG, "RTL_READER_HANDOFF_SKIPPED reason=$reason")
            promise.resolve(Arguments.createMap().apply {
                putBoolean("annotationRecovery", true)
                putInt("uid", android.os.Process.myUid())
            })
            return
        }

        var configFile: File? = null
        var originalBytes: ByteArray? = null
        var wroteConfig = false

        try {
            val filePath = lastSavedFilePath
                ?: throw IllegalStateException("No PDF has been saved in this reader session")
            // Consume the session path immediately. A later activation must save
            // its own path before another handoff can occur.
            lastSavedFilePath = null

            val savedJson = preferences.getString(filePath, null)
                ?: throw IllegalStateException("No saved reader preferences for current PDF")
            val pageIndex = JSONObject(savedJson).optInt("lastPageIndex", -1)
            if (pageIndex < 0) {
                throw IllegalStateException("Saved reader state has no valid lastPageIndex")
            }

            val pdfFile = File(filePath)
            if (!pdfFile.isFile) {
                throw IllegalStateException("Current PDF is not accessible: $filePath")
            }

            val inode = Os.stat(pdfFile.absolutePath).st_ino.toString()
            configFile = findMatchingConfig(pdfFile, inode)
            originalBytes = configFile.readBytes()

            val configMap = readConfigMap(configFile)
            val oldPage = configMap["currentPage"] as? String
                ?: throw IllegalStateException("Native config currentPage is not a String")

            configMap["currentPage"] = pageIndex.toString()
            val updatedBytes = serializeConfigMap(configMap)
            writeBytesSynced(configFile, updatedBytes)
            wroteConfig = true

            val verifiedMap = readConfigMap(configFile)
            val verifiedPage = verifiedMap["currentPage"] as? String
            if (verifiedPage != pageIndex.toString()) {
                throw IllegalStateException(
                    "Native config verification failed: expected $pageIndex, found $verifiedPage",
                )
            }
            verifyConfigIdentity(verifiedMap, pdfFile, inode)

            Log.i(
                LOG_TAG,
                "RTL_READER_HANDOFF_CONFIG_WRITTEN page=${pageIndex + 1} uid=${android.os.Process.myUid()} config=${configFile.absolutePath}",
            )

            scheduleDocumentRestart(pdfFile)

            val result = Arguments.createMap().apply {
                putString("filePath", pdfFile.absolutePath)
                putString("configPath", configFile.absolutePath)
                putString("inode", inode)
                putInt("pageIndex", pageIndex)
                putString("oldPage", oldPage)
                putInt("uid", android.os.Process.myUid())
            }
            promise.resolve(result)
        } catch (error: Throwable) {
            if (wroteConfig && configFile != null && originalBytes != null) {
                try {
                    writeBytesSynced(configFile, originalBytes)
                    Log.w(LOG_TAG, "RTL_READER_HANDOFF_CONFIG_RESTORED_AFTER_FAILURE")
                } catch (restoreError: Throwable) {
                    Log.e(
                        LOG_TAG,
                        "RTL_READER_HANDOFF_RESTORE_FAILED: ${restoreError.message}",
                        restoreError,
                    )
                }
            }
            Log.e(LOG_TAG, "RTL_READER_HANDOFF_FAILED: ${error.message}", error)
            promise.reject("READER_HANDOFF_FAILED", error.message, error)
        }
    }

    private fun findMatchingConfig(pdfFile: File, inode: String): File {
        var sawReadableRoot = false
        var sawCandidate = false

        for (rootPath in DOCUMENT_CACHE_ROOTS) {
            val root = File(rootPath)
            val children = root.listFiles()
            if (children == null) {
                continue
            }
            sawReadableRoot = true

            for (directory in children) {
                if (!directory.isDirectory || !directory.name.startsWith("${inode}_")) {
                    continue
                }
                val candidate = File(directory, "CONFIG/config.data")
                if (!candidate.isFile) {
                    continue
                }
                sawCandidate = true

                try {
                    val map = readConfigMap(candidate)
                    verifyConfigIdentity(map, pdfFile, inode)
                    return candidate
                } catch (_: Throwable) {
                    // A matching inode prefix is not enough; keep looking until
                    // both the serialized inode and URI identify this exact PDF.
                }
            }
        }

        if (!sawReadableRoot) {
            throw IllegalStateException(
                "PluginHost cannot read Supernote document cache as UID ${android.os.Process.myUid()}",
            )
        }
        if (sawCandidate) {
            throw IllegalStateException("Found inode candidate, but its URI did not match current PDF")
        }
        throw IllegalStateException("No native config found for PDF inode $inode")
    }

    private fun verifyConfigIdentity(
        map: MutableMap<Any?, Any?>,
        pdfFile: File,
        inode: String,
    ) {
        val storedInode = map["file_inode"] as? String
            ?: throw IllegalStateException("Native config file_inode is missing")
        if (storedInode != inode) {
            throw IllegalStateException(
                "Native config inode mismatch: expected $inode, found $storedInode",
            )
        }

        val storedUri = map["uri"] as? String
            ?: throw IllegalStateException("Native config URI is missing")
        val storedPath = Uri.parse(storedUri).path
            ?: throw IllegalStateException("Native config URI has no file path")

        val expectedPath = pdfFile.canonicalPath
        val actualPath = File(storedPath).canonicalPath
        if (expectedPath != actualPath) {
            throw IllegalStateException(
                "Native config URI mismatch: expected $expectedPath, found $actualPath",
            )
        }
    }

    @Suppress("UNCHECKED_CAST")
    private fun readConfigMap(file: File): MutableMap<Any?, Any?> {
        FileInputStream(file).use { stream ->
            ObjectInputStream(stream).use { input ->
                val value = input.readObject()
                if (value !is MutableMap<*, *>) {
                    throw IllegalStateException(
                        "Native config is ${value.javaClass.name}, expected MutableMap",
                    )
                }
                return value as MutableMap<Any?, Any?>
            }
        }
    }

    private fun serializeConfigMap(map: MutableMap<Any?, Any?>): ByteArray {
        val buffer = ByteArrayOutputStream()
        ObjectOutputStream(buffer).use { output ->
            output.writeObject(map)
            output.flush()
        }
        return buffer.toByteArray()
    }

    private fun writeBytesSynced(file: File, bytes: ByteArray) {
        FileOutputStream(file, false).use { output ->
            output.write(bytes)
            output.flush()
            output.fd.sync()
        }
    }

    /**
     * Makes an already-published rename durable. The publication callback is
     * deliberately invoked before this method: if fsync fails, callers must
     * still know that the destination name may now refer to the new bytes and
     * execute the corresponding recovery path rather than treating the write
     * as an unpublished temporary-file failure.
     */
    private fun syncParentDirectory(file: File) {
        val parent = file.parentFile
            ?: throw IllegalStateException("Published file has no parent directory")
        val directory = openPinnedDirectory(
            parent,
            "Published-file sync parent",
        )
        try {
            Os.fsync(directory)
        } finally {
            Os.close(directory)
        }
    }

    // A null sample is indeterminate, not evidence that DocumentActivity has
    // stopped. Callers must fail closed instead of collapsing it into absence.
    private fun documentPids(activityManager: ActivityManager): List<Int>? {
        val processes = activityManager.runningAppProcesses ?: return null
        return processes
            .asSequence()
            .filter { process -> process.processName == DOCUMENT_PACKAGE }
            .map { process -> process.pid }
            .filter { pid -> pid != android.os.Process.myPid() }
            .toList()
    }

    private fun documentPidsOrThrow(
        activityManager: ActivityManager,
        phase: String,
    ): List<Int> = documentPids(activityManager) ?: run {
        Log.e(
            LOG_TAG,
            "RTL_READER_DOCUMENT_PROCESS_SAMPLE_UNAVAILABLE phase=$phase",
        )
        throw IllegalStateException(
            "Could not determine whether the native document process is active",
        )
    }

    private fun requireDocumentProcessAbsent(
        activityManager: ActivityManager,
        phase: String,
    ) {
        val running = documentPidsOrThrow(activityManager, phase)
        if (running.isNotEmpty()) {
            Log.e(
                LOG_TAG,
                "RTL_READER_NATIVE_BACKUP_RESTORE_FINAL_PROCESS_CHECK_FAILED phase=$phase pids=${running.joinToString(",")}",
            )
            val failure = IllegalStateException(
                "Native document process became active while publishing annotation recovery",
            )
            // A process observed after publication could otherwise persist its
            // stale in-memory model over the restored bytes before the retry.
            for (pid in running) {
                try {
                    Os.kill(pid, OsConstants.SIGKILL)
                    Log.w(
                        LOG_TAG,
                        "RTL_READER_NATIVE_BACKUP_RESTORE_RACE_KILL_SENT phase=$phase pid=$pid",
                    )
                } catch (killError: Throwable) {
                    failure.addSuppressed(killError)
                    Log.e(
                        LOG_TAG,
                        "RTL_READER_NATIVE_BACKUP_RESTORE_RACE_KILL_FAILED phase=$phase pid=$pid: ${killError.message}",
                        killError,
                    )
                }
            }
            throw failure
        }
        Log.i(
            LOG_TAG,
            "RTL_READER_NATIVE_BACKUP_RESTORE_FINAL_PROCESS_CHECK_PASSED phase=$phase",
        )
    }

    private fun scheduleDocumentRestart(pdfFile: File) {
        Thread {
            try {
                Log.i(
                    LOG_TAG,
                    "RTL_READER_HANDOFF_WORKER_START uid=${android.os.Process.myUid()} pluginPid=${android.os.Process.myPid()}",
                )

                // Give closePluginView() time to return the native reader to the
                // foreground before replacing its process.
                SystemClock.sleep(900)

                synchronized(nativeSpreadConfigurationLock) {
                    if (nativeMarkRecoveryRequiredPending() ||
                        inspectNativeMarkRecoveryFence(pdfFile).blocking
                    ) {
                        Log.e(
                            LOG_TAG,
                            "RTL_READER_HANDOFF_RESTART_BLOCKED reason=native_mark_recovery_required",
                        )
                        return@synchronized
                    }

                    val activityManager = reactApplicationContext.getSystemService(
                        Context.ACTIVITY_SERVICE,
                    ) as ActivityManager
                    val pids = documentPidsOrThrow(activityManager, "handoff-initial")
                    Log.i(
                        LOG_TAG,
                        "RTL_READER_HANDOFF_DOCUMENT_PIDS ${pids.joinToString(",")}",
                    )

                    for (pid in pids) {
                        try {
                            Os.kill(pid, OsConstants.SIGKILL)
                            Log.i(LOG_TAG, "RTL_READER_HANDOFF_KILL_SENT pid=$pid")
                        } catch (error: Throwable) {
                            Log.e(
                                LOG_TAG,
                                "RTL_READER_HANDOFF_KILL_FAILED pid=$pid: ${error.message}",
                                error,
                            )
                            throw error
                        }
                    }

                    if (pids.isNotEmpty()) {
                        val deadline =
                            SystemClock.elapsedRealtime() + DOCUMENT_PROCESS_STOP_TIMEOUT_MS
                        var remaining = pids
                        while (remaining.isNotEmpty() &&
                            SystemClock.elapsedRealtime() < deadline
                        ) {
                            SystemClock.sleep(DOCUMENT_PROCESS_SAMPLE_INTERVAL_MS)
                            val running = documentPidsOrThrow(
                                activityManager,
                                "handoff-confirmation",
                            ).toSet()
                            remaining = pids.filter { pid -> pid in running }
                        }
                        if (remaining.isEmpty()) {
                            Log.i(LOG_TAG, "RTL_READER_HANDOFF_KILL_CONFIRMED")
                        } else {
                            Log.w(
                                LOG_TAG,
                                "RTL_READER_HANDOFF_KILL_NOT_CONFIRMED pids=${remaining.joinToString(",")}",
                            )
                        }
                    } else {
                        Log.w(LOG_TAG, "RTL_READER_HANDOFF_NO_DOCUMENT_PID")
                    }

                    SystemClock.sleep(450)

                    if (nativeMarkRecoveryRequiredPending() ||
                        inspectNativeMarkRecoveryFence(pdfFile).blocking
                    ) {
                        Log.e(
                            LOG_TAG,
                            "RTL_READER_HANDOFF_RESTART_BLOCKED reason=native_mark_recovery_required",
                        )
                        return@synchronized
                    }
                    val intent = Intent().apply {
                        setClassName(DOCUMENT_PACKAGE, DOCUMENT_ACTIVITY)
                        addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TASK)
                    }
                    reactApplicationContext.startActivity(intent)
                    Log.i(LOG_TAG, "RTL_READER_HANDOFF_START_REQUESTED_DIRECT")
                }
            } catch (error: Throwable) {
                Log.e(
                    LOG_TAG,
                    "RTL_READER_HANDOFF_WORKER_FAILED: ${error.message}",
                    error,
                )
            }
        }.apply {
            name = "RtlReaderNativeHandoff"
            isDaemon = true
            start()
        }
    }

    private fun scheduleAnnotationRestore(
        pdfFile: File,
        backup: NativeAnnotationBackup,
        completion: (Throwable?) -> Unit,
    ) {
        Thread {
            var persistenceError: Throwable? = null
            synchronized(nativeSpreadConfigurationLock) {
                try {
                // The promise remains pending while this worker runs. Kill the
                // native reader before touching its working .mark so an
                // in-memory annotation model cannot overwrite the recovery
                // snapshot while DocumentActivity is resuming.
                SystemClock.sleep(350)
                val activityManager = reactApplicationContext.getSystemService(
                    Context.ACTIVITY_SERVICE,
                ) as ActivityManager
                val deadline =
                    SystemClock.elapsedRealtime() + DOCUMENT_PROCESS_STOP_TIMEOUT_MS
                val firstSample = documentPidsOrThrow(activityManager, "restore-initial")
                val initialPids = firstSample.toSet()
                val signaledPids = mutableSetOf<Int>()
                val signaledInCurrentGeneration = mutableSetOf<Int>()
                var previousRunning = emptySet<Int>()
                var running = firstSample
                var absentSince: Long? = null
                while (true) {
                    val now = SystemClock.elapsedRealtime()
                    val runningSet = running.toSet()
                    signaledInCurrentGeneration.retainAll(runningSet)
                    if (runningSet.isNotEmpty()) {
                        absentSince = null
                        for (pid in runningSet) {
                            if (signaledInCurrentGeneration.add(pid)) {
                                val replacement =
                                    pid !in initialPids ||
                                        pid in signaledPids && pid !in previousRunning
                                Os.kill(pid, OsConstants.SIGKILL)
                                signaledPids.add(pid)
                                Log.i(
                                    LOG_TAG,
                                    "RTL_READER_NATIVE_BACKUP_RESTORE_KILL_SENT pid=$pid replacement=$replacement",
                                )
                            }
                        }
                    } else {
                        val quietStart = absentSince
                        if (quietStart == null) {
                            absentSince = now
                        } else if (now - quietStart >= DOCUMENT_PROCESS_QUIET_WINDOW_MS) {
                            Log.i(
                                LOG_TAG,
                                "RTL_READER_NATIVE_BACKUP_RESTORE_STABLE_PROCESS_ABSENCE quietMs=${now - quietStart} signaled=${signaledPids.joinToString(",")}",
                            )
                            break
                        }
                    }

                    if (now >= deadline) {
                        val detail = if (runningSet.isEmpty()) {
                            "stable no-process window was not observed"
                        } else {
                            "active pids=${runningSet.joinToString(",")}"
                        }
                        Log.e(
                            LOG_TAG,
                            "RTL_READER_NATIVE_BACKUP_RESTORE_ABORTED_PROCESS_STATE $detail",
                        )
                        throw IllegalStateException(
                            "Native document process shutdown was not proven; annotation recovery was not written",
                        )
                    }

                    previousRunning = runningSet
                    SystemClock.sleep(DOCUMENT_PROCESS_SAMPLE_INTERVAL_MS)
                    running = documentPidsOrThrow(activityManager, "restore-quiescence")
                }

                val marker = nativeSpreadMarker(pdfFile)
                withNativeSpreadPublicationLock(marker) {
                    val revalidatedBackup = readNativeAnnotationBackup(pdfFile).backup
                        ?: throw IllegalStateException(
                            "Document or recovery snapshot changed while preparing restore",
                        )
                    if (!sameNativeAnnotationBackup(backup, revalidatedBackup)) {
                        throw IllegalStateException(
                            "Recovery snapshot identity changed while preparing restore",
                        )
                    }
                    val journalInspection = inspectNativeMarkRecoveryFence(pdfFile, marker)
                    val recoveryJournal = journalInspection.journal?.also { journal ->
                        if (!nativeMarkRecoveryJournalMatchesBackup(
                                journal,
                                revalidatedBackup,
                            )
                        ) {
                            throw NativeMarkRecoveryRequiredException(
                                "Durable native mark recovery journal disagrees with backup",
                                IllegalStateException("journal_backup_mismatch"),
                            )
                        }
                    } ?: run {
                        if (journalInspection.blocking) {
                            throw NativeMarkRecoveryRequiredException(
                                "Durable native mark recovery journal is ambiguous: " +
                                    journalInspection.reason,
                                IllegalStateException(journalInspection.reason),
                            )
                        }
                        if (readPersistedAuthorityIfFile(marker) != null) {
                            throw IllegalStateException(
                                "Native Spread marker reappeared while annotation recovery was pending",
                            )
                        }
                        // This fsynced marker is published before the first
                        // destructive `.mark` rename. Besides surviving a
                        // PluginHost/process restart, its marker-path presence
                        // keeps the injected companion's admission/input fence
                        // closed until exact recovery is verified.
                        publishNativeMarkRecoveryJournal(
                            pdfFile,
                            marker,
                            revalidatedBackup,
                        )
                    }

                    var publication: NativeMarkPublication? = null
                    var recoveryCommitProven = false
                    try {
                        publication = publishNativeAnnotationRestore(
                            revalidatedBackup,
                            beforePublish = {
                                requireDocumentProcessAbsent(
                                    activityManager,
                                    if (revalidatedBackup.originalMarkPresent) {
                                        "before-mark-publish"
                                    } else {
                                        "before-mark-delete"
                                    },
                                )
                                requireBackupDocumentIdentity(
                                    pdfFile,
                                    revalidatedBackup,
                                    if (revalidatedBackup.originalMarkPresent) {
                                        "before-mark-publish"
                                    } else {
                                        "before-mark-delete"
                                    },
                                )
                            },
                            afterPublish = {
                                requireDocumentProcessAbsent(
                                    activityManager,
                                    if (revalidatedBackup.originalMarkPresent) {
                                        "after-mark-publish"
                                    } else {
                                        "after-mark-delete"
                                    },
                                )
                                requireBackupDocumentIdentity(
                                    pdfFile,
                                    revalidatedBackup,
                                    if (revalidatedBackup.originalMarkPresent) {
                                        "after-mark-publish"
                                    } else {
                                        "after-mark-delete"
                                    },
                                )
                            },
                        )

                        val restoredMark = readRegularFileAuthorityIfFile(
                            revalidatedBackup.mark,
                            Int.MAX_VALUE.toLong(),
                            requireNonEmpty = false,
                            authorityLabel = "restored annotation",
                        )
                        val restoredBytesMatch = if (revalidatedBackup.originalMarkPresent) {
                            restoredMark != null &&
                                restoredMark.bytes.size.toLong() ==
                                    revalidatedBackup.markLength &&
                                sha256(restoredMark.bytes) == revalidatedBackup.markSha256
                        } else {
                            restoredMark == null
                        }
                        if (!restoredBytesMatch) {
                            throw IllegalStateException(
                                "Restored annotation file verification failed",
                            )
                        }
                        requireBackupDocumentIdentity(
                            pdfFile,
                            revalidatedBackup,
                            "after-mark-verification",
                        )

                        Log.i(
                            LOG_TAG,
                            "RTL_READER_NATIVE_BACKUP_RESTORED originalPresent=${revalidatedBackup.originalMarkPresent} mark=${revalidatedBackup.mark.absolutePath}",
                        )
                        requireDocumentProcessAbsent(
                            activityManager,
                            "before-backup-retirement",
                        )
                        requireBackupDocumentIdentity(
                            pdfFile,
                            revalidatedBackup,
                            "before-recovery-journal-retirement",
                        )
                        // The retirement helper freshly re-reads both the live
                        // journal and exact restored `.mark`, then publishes
                        // this irreversible commit boundary immediately before
                        // attempting journal displacement. A retirement race
                        // may retain cleanup evidence and keep recovery fenced,
                        // but it can never roll these exact bytes backward.
                        retireNativeMarkRecoveryJournal(
                            pdfFile,
                            recoveryJournal,
                        ) {
                            recoveryCommitProven = true
                        }
                    } catch (restoreError: Throwable) {
                        if (!recoveryCommitProven) {
                            publication?.takeIf { value -> value.changed }?.let { value ->
                                try {
                                    restorePrePublicationMark(value)
                                    Log.w(
                                        LOG_TAG,
                                        "RTL_READER_NATIVE_BACKUP_RESTORE_POST_PUBLICATION_ROLLED_BACK",
                                    )
                                } catch (rollbackError: Throwable) {
                                    restoreError.addSuppressed(rollbackError)
                                    Log.e(
                                        LOG_TAG,
                                        "RTL_READER_NATIVE_BACKUP_RESTORE_POST_PUBLICATION_ROLLBACK_FAILED",
                                        rollbackError,
                                    )
                                }
                            }
                        }
                        throw restoreError
                    }
                    // Fence retirement is the commit point: the live mark has
                    // already been re-read and proven exact. A crash or cleanup
                    // error from here can leave only an orphaned backup, which
                    // existing reconciliation safely retires; it must never
                    // roll the committed `.mark` back to the discarded working
                    // copy after the companion fence has opened.
                    runCatching {
                        removeNativeAnnotationBackupFiles(pdfFile, revalidatedBackup)
                    }.onFailure { cleanupError ->
                        Log.w(
                            LOG_TAG,
                            "RTL_READER_NATIVE_BACKUP_RETIREMENT_DEFERRED_AFTER_MARK_COMMIT",
                            cleanupError,
                        )
                    }
                    publication?.let { committedPublication ->
                        runCatching {
                            retireNativeMarkPublication(committedPublication)
                        }.onFailure { cleanupError ->
                            // The restored .mark and backup retirement are
                            // already committed. Keep a verified displaced file
                            // as rollback evidence rather than treating optional
                            // cleanup as a persistence failure.
                            Log.w(
                                LOG_TAG,
                                "RTL_READER_NATIVE_BACKUP_DISPLACED_CLEANUP_DEFERRED",
                                cleanupError,
                            )
                        }
                    }
                }
                } catch (error: Throwable) {
                    Log.e(
                        LOG_TAG,
                        "RTL_READER_NATIVE_BACKUP_RESTORE_WORKER_FAILED: ${error.message}",
                        error,
                    )
                    persistenceError = error
                    if (nativeMarkRecoveryRequired(error)) {
                        registerNativeMarkRecoveryRequired(nativeSpreadMarker(pdfFile))
                    }
                }
            }

            // Persistence is now either fully committed (including backup
            // retirement) or failed and rolled back. Relaunch is deliberately
            // outside both the rollback catch and the publication locks: an
            // ActivityManager failure must never restore the discarded working
            // .mark after its recovery backup has been retired.
            val committed = persistenceError == null
            val recoveryRequired = nativeMarkRecoveryRequiredPending() ||
                nativeMarkRecoveryRequired(persistenceError)
            if (recoveryRequired) {
                Log.e(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_RESTORE_RECOVERY_REQUIRED_NOT_REOPENED",
                    persistenceError,
                )
            } else {
                try {
                    if (committed) SystemClock.sleep(250)
                    reactApplicationContext.startActivity(Intent().apply {
                        setClassName(DOCUMENT_PACKAGE, DOCUMENT_ACTIVITY)
                        addFlags(
                            Intent.FLAG_ACTIVITY_NEW_TASK or
                                Intent.FLAG_ACTIVITY_CLEAR_TASK,
                        )
                    })
                    Log.i(
                        LOG_TAG,
                        if (committed) {
                            "RTL_READER_NATIVE_BACKUP_RESTORE_REOPENED"
                        } else {
                            "RTL_READER_NATIVE_BACKUP_RESTORE_FAILURE_REOPENED"
                        },
                    )
                } catch (restartError: Throwable) {
                    Log.e(
                        LOG_TAG,
                        if (committed) {
                            "RTL_READER_NATIVE_BACKUP_RESTORE_REOPEN_FAILED: ${restartError.message}"
                        } else {
                            "RTL_READER_NATIVE_BACKUP_RESTORE_FAILURE_REOPEN_FAILED: ${restartError.message}"
                        },
                        restartError,
                    )
                    if (committed) persistenceError = restartError
                }
            }
            completion(persistenceError)
        }.apply {
            name = "RtlReaderAnnotationRecovery"
            isDaemon = true
            start()
        }
    }

    private fun nativeMarkRecoveryRequired(error: Throwable?): Boolean {
        if (error == null) return false
        val pending = java.util.ArrayDeque<Throwable>()
        val visited = java.util.Collections.newSetFromMap(
            java.util.IdentityHashMap<Throwable, Boolean>(),
        )
        pending.addLast(error)
        while (!pending.isEmpty()) {
            val current = pending.removeFirst()
            if (!visited.add(current)) continue
            if (current is NativeMarkRecoveryRequiredException) return true
            current.cause?.let { cause -> pending.addLast(cause) }
            current.suppressed.forEach { suppressed -> pending.addLast(suppressed) }
        }
        return false
    }

    private fun requireBackupDocumentIdentity(
        pdfFile: File,
        backup: NativeAnnotationBackup,
        phase: String,
    ) {
        if (pdfFile.canonicalPath != backup.documentPath ||
            !pdfFile.isFile ||
            pdfFile.length() != backup.documentLength ||
            sha256(pdfFile) != backup.documentSha256
        ) {
            throw IllegalStateException(
                "PDF identity changed during annotation recovery: $phase",
            )
        }
    }

    private fun readPinnedRegularBytes(
        descriptor: FileDescriptor,
        identity: StructStat,
        authorityLabel: String,
    ): ByteArray {
        require(
            OsConstants.S_ISREG(identity.st_mode) &&
                identity.st_nlink == 1L &&
                identity.st_size in 0L..Int.MAX_VALUE.toLong(),
        ) {
            "$authorityLabel is not one readable single-link file"
        }
        val bytes = ByteArrayOutputStream(identity.st_size.toInt()).use { output ->
            FileInputStream(Os.dup(descriptor)).use { input ->
                val buffer = ByteArray(64 * 1024)
                while (true) {
                    val count = input.read(buffer)
                    if (count < 0) break
                    require(output.size().toLong() + count <= identity.st_size) {
                        "$authorityLabel grew while reading"
                    }
                    output.write(buffer, 0, count)
                }
            }
            output.toByteArray()
        }
        require(
            bytes.size.toLong() == identity.st_size &&
                samePersistedFileVersion(identity, Os.fstat(descriptor)),
        ) {
            "$authorityLabel changed while reading"
        }
        return bytes
    }

    private fun openPinnedRegularFile(
        file: File,
        expected: StructStat,
        authorityLabel: String,
    ): FileDescriptor {
        require(
            OsConstants.S_ISREG(expected.st_mode) && expected.st_nlink == 1L,
        ) {
            "$authorityLabel is not one regular single-link file"
        }
        val descriptor = Os.open(
            file.absolutePath,
            OsConstants.O_RDONLY or OsConstants.O_CLOEXEC or OsConstants.O_NOFOLLOW,
            0,
        )
        try {
            require(
                samePersistedFileVersion(expected, Os.fstat(descriptor)) &&
                    samePersistedFileVersion(expected, Os.lstat(file.absolutePath)),
            ) {
                "$authorityLabel descriptor disagrees with its path"
            }
            return descriptor
        } catch (error: Throwable) {
            Os.close(descriptor)
            throw error
        }
    }

    private fun publishNativeAnnotationRestore(
        backup: NativeAnnotationBackup,
        beforePublish: () -> Unit,
        afterPublish: () -> Unit,
    ): NativeMarkPublication {
        val mark = backup.mark
        val previousPathIdentity = pathIdentityNoFollow(mark)
        val previousDescriptor = previousPathIdentity?.let { identity ->
            openPinnedRegularFile(mark, identity, "pre-restore annotation")
        }
        val previousBytes = previousDescriptor?.let { descriptor ->
            readPinnedRegularBytes(
                descriptor,
                checkNotNull(previousPathIdentity),
                "pre-restore annotation",
            )
        }
        val previousAuthority = previousPathIdentity?.let { identity ->
            PersistedFileAuthority(checkNotNull(previousBytes), identity)
        }
        var publication: NativeMarkPublication? = null
        try {
            if (!backup.originalMarkPresent) {
                if (previousPathIdentity == null) {
                    beforePublish()
                    afterPublish()
                    return NativeMarkPublication(
                        mark,
                        null,
                        null,
                        false,
                        null,
                        null,
                        null,
                        null,
                        null,
                        false,
                    )
                }
                publication = publishRegularFileAbsenceNoClobber(
                    mark,
                    previousAuthority,
                    "native annotation restore",
                    beforePublish = {
                        require(
                            previousDescriptor != null &&
                                samePersistedFileVersion(
                                    previousPathIdentity,
                                    Os.fstat(previousDescriptor),
                                ),
                        ) {
                            "Pre-restore annotation identity changed"
                        }
                        beforePublish()
                    },
                )
                afterPublish()
                return checkNotNull(publication)
            }

            val snapshotPathIdentity = pathIdentityNoFollow(backup.snapshot)
                ?: throw IllegalStateException("Recovery snapshot disappeared")
            val snapshotDescriptor = openPinnedRegularFile(
                backup.snapshot,
                snapshotPathIdentity,
                "annotation recovery snapshot",
            )
            try {
                val snapshotBytes = readPinnedRegularBytes(
                    snapshotDescriptor,
                    snapshotPathIdentity,
                    "annotation recovery snapshot",
                )
                require(
                    snapshotBytes.size.toLong() == backup.markLength &&
                        sha256(snapshotBytes) == backup.markSha256,
                ) {
                    "Recovery snapshot bytes disagree with backup authority"
                }
                publication = publishRegularFileNoClobber(
                    mark,
                    snapshotBytes,
                    previousAuthority,
                    "native annotation restore",
                    beforePublish = {
                        require(
                            samePersistedFileVersion(
                                snapshotPathIdentity,
                                Os.fstat(snapshotDescriptor),
                            ) &&
                                samePersistedFileVersion(
                                    snapshotPathIdentity,
                                    Os.lstat(backup.snapshot.absolutePath),
                                ),
                        ) {
                            "Recovery snapshot changed before publication"
                        }
                        if (previousPathIdentity != null) {
                            require(
                                previousDescriptor != null &&
                                    samePersistedFileVersion(
                                        previousPathIdentity,
                                        Os.fstat(previousDescriptor),
                                    ),
                            ) {
                                "Pre-restore annotation identity changed"
                            }
                        }
                        beforePublish()
                    },
                )
                afterPublish()
                val publishedIdentity = checkNotNull(publication.publishedIdentity)
                require(
                    samePersistedFileVersion(
                        snapshotPathIdentity,
                        Os.fstat(snapshotDescriptor),
                    ) &&
                        samePersistedFileVersion(
                            snapshotPathIdentity,
                            Os.lstat(backup.snapshot.absolutePath),
                        ) &&
                        samePersistedFileVersion(
                            publishedIdentity,
                            checkNotNull(pathIdentityNoFollow(mark)),
                        ),
                ) {
                    "Restore authority changed during verified publication"
                }
                return checkNotNull(publication)
            } finally {
                closeDescriptorWithoutMaskingRecovery(
                    snapshotDescriptor,
                    "annotation recovery snapshot",
                )
            }
        } catch (error: Throwable) {
            publication?.takeIf { value -> value.changed }?.let { value ->
                try {
                    restorePrePublicationMark(value)
                } catch (rollbackError: Throwable) {
                    error.addSuppressed(rollbackError)
                }
            }
            throw error
        } finally {
            previousDescriptor?.let { descriptor ->
                closeDescriptorWithoutMaskingRecovery(
                    descriptor,
                    "pre-restore annotation",
                )
            }
        }
    }

    private fun restorePrePublicationMark(publication: NativeMarkPublication) {
        if (!publication.changed) return
        val publishedAuthority = publication.publishedIdentity?.let { identity ->
            PersistedFileAuthority(
                checkNotNull(publication.publishedBytes),
                identity,
            )
        }
        var rejected: DisplacedRegularFile? = null
        try {
            // The initial authority check/preservation is part of rollback, not
            // a precondition outside it. A racer already occupying the live
            // path is retained in place and forces recovery-required
            // containment; it must never fall through to the ordinary failure
            // relaunch path.
            rejected = preserveRegularDestinationNoClobber(
                publication.mark,
                publishedAuthority,
                "rejected annotation publication rollback",
            ) {}
            if (publication.previousPresent) {
                val bytes = publication.previousBytes ?: throw IllegalStateException(
                    "Missing pre-publication mark rollback bytes",
                )
                val restoredIdentity = createRegularFileNoClobber(
                    publication.mark,
                    bytes,
                    "pre-restore annotation rollback",
                )
                val restored = readRegularFileAuthorityIfFile(
                    publication.mark,
                    Int.MAX_VALUE.toLong(),
                    requireNonEmpty = false,
                    authorityLabel = "rolled-back annotation",
                ) ?: throw IllegalStateException(
                    "Pre-restore annotation rollback disappeared",
                )
                require(
                    samePersistedFileVersion(restoredIdentity, restored.identity) &&
                        restored.bytes.contentEquals(bytes)
                ) {
                    "Pre-restore annotation rollback bytes changed"
                }
            } else {
                require(pathIdentityNoFollow(publication.mark) == null) {
                    "Could not remove rejected annotation publication"
                }
            }
            requireDisplacedRegularFileIntact(
                rejected,
                "rejected annotation publication",
            )
            requireDisplacedRegularFileIntact(
                publication.displaced?.let { displaced ->
                    DisplacedRegularFile(
                        displaced,
                        checkNotNull(publication.displacedIdentity),
                        checkNotNull(publication.previousBytes),
                        checkNotNull(publication.displacementDirectory),
                        checkNotNull(publication.displacementDirectoryIdentity),
                    )
                },
                "pre-publication annotation",
            )
        } catch (rollbackError: Throwable) {
            throw NativeMarkRecoveryRequiredException(
                "Pre-publication annotation state is not proven restored; " +
                    "DocumentActivity must remain stopped for explicit recovery",
                rollbackError,
            )
        }
        retireDisplacedRegularFile(rejected, "rejected annotation publication")
        retireDisplacedRegularFile(
            publication.displaced?.let { displaced ->
                DisplacedRegularFile(
                    displaced,
                    checkNotNull(publication.displacedIdentity),
                    checkNotNull(publication.previousBytes),
                    checkNotNull(publication.displacementDirectory),
                    checkNotNull(publication.displacementDirectoryIdentity),
                )
            },
            "pre-publication annotation",
        )
    }

    private fun requireDisplacedRegularFileIntact(
        displaced: DisplacedRegularFile?,
        authorityLabel: String,
    ) {
        if (displaced == null) return
        val directoryDescriptor = openPinnedDirectory(
            displaced.transactionDirectory,
            "$authorityLabel retained-evidence directory",
        )
        try {
            val current = readRegularFileAuthorityIfFile(
                displaced.file,
                Int.MAX_VALUE.toLong(),
                requireNonEmpty = false,
                authorityLabel = authorityLabel,
            ) ?: throw IllegalStateException("$authorityLabel disappeared")
            require(
                samePersistedFileVersion(displaced.identity, current.identity) &&
                    displaced.bytes.contentEquals(current.bytes) &&
                    sameFileObject(
                        displaced.transactionDirectoryIdentity,
                        Os.fstat(directoryDescriptor),
                    ) &&
                    sameFileObject(
                        displaced.transactionDirectoryIdentity,
                        Os.lstat(displaced.transactionDirectory.absolutePath),
                    ),
            ) {
                "$authorityLabel retained evidence changed"
            }
        } finally {
            closeDescriptorWithoutMaskingRecovery(
                directoryDescriptor,
                "$authorityLabel retained evidence directory",
            )
        }
    }

    private fun retireNativeMarkPublication(publication: NativeMarkPublication) {
        retireDisplacedRegularFile(
            publication.displaced?.let { displaced ->
                DisplacedRegularFile(
                    displaced,
                    checkNotNull(publication.displacedIdentity),
                    checkNotNull(publication.previousBytes),
                    checkNotNull(publication.displacementDirectory),
                    checkNotNull(publication.displacementDirectoryIdentity),
                )
            },
            "committed pre-publication annotation",
        )
    }

    private fun retireDisplacedRegularFile(
        displaced: DisplacedRegularFile?,
        authorityLabel: String,
    ) {
        if (displaced == null) return
        val directoryDescriptor = openPinnedDirectory(
            displaced.transactionDirectory,
            "$authorityLabel retirement directory",
        )
        try {
            val current = readRegularFileAuthorityIfFile(
                displaced.file,
                Int.MAX_VALUE.toLong(),
                requireNonEmpty = false,
                authorityLabel = authorityLabel,
            ) ?: throw IllegalStateException("$authorityLabel disappeared before retirement")
            require(
                samePersistedFileVersion(displaced.identity, current.identity) &&
                    displaced.bytes.contentEquals(current.bytes) &&
                    sameFileObject(
                        displaced.transactionDirectoryIdentity,
                        Os.fstat(directoryDescriptor),
                    ) &&
                    sameFileObject(
                        displaced.transactionDirectoryIdentity,
                        Os.lstat(displaced.transactionDirectory.absolutePath),
                    ),
            ) {
                "$authorityLabel changed before retirement"
            }
            Files.delete(displaced.file.toPath())
            require(pathIdentityNoFollow(displaced.file) == null) {
                "$authorityLabel reappeared after retirement"
            }
            Os.fsync(directoryDescriptor)
            Files.delete(displaced.transactionDirectory.toPath())
            require(pathIdentityNoFollow(displaced.transactionDirectory) == null) {
                "$authorityLabel transaction directory reappeared after retirement"
            }
            syncParentDirectory(displaced.transactionDirectory)
        } finally {
            Os.close(directoryDescriptor)
        }
    }
}
