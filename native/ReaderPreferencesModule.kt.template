    private val preferences by lazy {
        reactApplicationContext.getSharedPreferences(STORE_NAME, Context.MODE_PRIVATE)
    }

    @Volatile
    private var lastSavedFilePath: String? = null

    private val nativeSpreadModuleInvalidated = AtomicBoolean(false)
    private val nativeSpreadHandshakeReceivers = Collections.newSetFromMap(
        ConcurrentHashMap<BroadcastReceiver, Boolean>(),
    )

    override fun getName(): String = "ReaderPreferencesModule"

    override fun invalidate() {
        val newlyInvalidated = synchronized(nativeSpreadConfigurationIntentLock) {
            if (nativeSpreadModuleInvalidated.compareAndSet(false, true)) {
                nativeSpreadConfigurationGeneration.incrementAndGet()
                true
            } else {
                false
            }
        }
        if (newlyInvalidated) {
            val cleanup = Runnable {
                nativeSpreadHandshakeReceivers.toList().forEach { receiver ->
                    try {
                        reactApplicationContext.unregisterReceiver(receiver)
                    } catch (_: Throwable) {
                        // Already removed by a response/timeout completion.
                    }
                }
                nativeSpreadHandshakeReceivers.clear()
            }
            if (Looper.myLooper() == Looper.getMainLooper()) {
                cleanup.run()
            } else {
                Handler(Looper.getMainLooper()).post(cleanup)
            }
        }
        super.invalidate()
    }

    @ReactMethod
    fun load(filePath: String, promise: Promise) {
        try {
            promise.resolve(preferences.getString(filePath, null))
        } catch (error: Throwable) {
            promise.reject("READER_PREFS_LOAD_FAILED", error.message, error)
        }
    }

    @ReactMethod
    fun save(filePath: String, json: String, promise: Promise) {
        try {
            val saved = preferences.edit().putString(filePath, json).commit()
            if (!saved) {
                throw IllegalStateException("SharedPreferences commit returned false")
            }
            lastSavedFilePath = filePath
            promise.resolve(true)
        } catch (error: Throwable) {
            promise.reject("READER_PREFS_SAVE_FAILED", error.message, error)
        }
    }

    @ReactMethod
    fun remove(filePath: String, promise: Promise) {
        try {
            val removed = preferences.edit().remove(filePath).commit()
            if (!removed) {
                throw IllegalStateException("SharedPreferences commit returned false")
            }
            if (lastSavedFilePath == filePath) {
                lastSavedFilePath = null
            }
            promise.resolve(true)
        } catch (error: Throwable) {
            promise.reject("READER_PREFS_REMOVE_FAILED", error.message, error)
        }
    }

    @ReactMethod
    fun loadNativeSpreadMode(filePath: String, promise: Promise) {
        try {
            val pdfFile = requirePdf(filePath)
            val marker = nativeSpreadMarker(pdfFile)
            val capability = nativeSpreadCapability()
            // Marker parsing, PDF hashing, and recovery-snapshot hashing are
            // forbidden on PluginHost's main thread. Publish only immutable
            // validated results back to the receiver/UI callback.
            startNativeBackupWorker("RTLReaderNativeModeLoad") {
                try {
                    val backupResult = readNativeAnnotationBackup(pdfFile)
                    // Read the marker once through its descriptor-backed
                    // authority and derive every returned setting and recovery
                    // assessment from those exact bytes. A second path read
                    // here could validate a newer marker while returning stale
                    // settings from an older one.
                    val markerAuthority = readPersistedAuthorityIfFile(marker)
                    val propertiesResult = runCatching {
                        markerAuthority?.let { authority ->
                            strictNativeSpreadMarkerProperties(authority.bytes)
                        } ?: Properties()
                    }
                    if (propertiesResult.isFailure) {
                        val authority = assessNativeSpreadAuthority(
                            pdfFile,
                            marker,
                            backupResult,
                            markerAuthority,
                        )
                        publishNativeSpreadModeAfterRevalidation(
                            promise,
                            pdfFile,
                            false,
                            false,
                            false,
                            true,
                            true,
                            "fit",
                            marker,
                            markerAuthority,
                            capability,
                            NativeSpreadHandshake(false, "marker_unreadable"),
                            backupResult,
                            authority,
                        )
                        return@startNativeBackupWorker
                    }
                    val properties = propertiesResult.getOrThrow()
                    val settings = nativeSpreadMarkerSettings(
                        pdfFile,
                        properties,
                        backupResult,
                    )
                    val authority = assessNativeSpreadAuthority(
                        pdfFile,
                        marker,
                        backupResult,
                        markerAuthority,
                    )

                    if (!capability.compatible) {
                        publishNativeSpreadModeAfterRevalidation(
                            promise,
                            pdfFile,
                            settings.reportedConfigured,
                            settings.configuredEditable,
                            settings.coverSeparate,
                            settings.showDivider,
                            settings.showHeader,
                            settings.spreadSizing,
                            marker,
                            markerAuthority,
                            capability,
                            NativeSpreadHandshake(false, "package_incompatible"),
                            backupResult,
                            authority,
                        )
                        return@startNativeBackupWorker
                    }
                    Handler(Looper.getMainLooper()).post {
                        val handshakeGeneration =
                            nativeSpreadConfigurationGeneration.get()
                        requestNativeSpreadHandshake(
                            pdfFile,
                            handshakeGeneration,
                        ) { handshake ->
                            if (handshake.active && settings.legacyConfiguredEditable) {
                                startNativeBackupWorker(
                                    "RTLReaderNativeEditableMigrate",
                                ) {
                                    try {
                                        val migratedBackup =
                                            migrateLegacyProtectedEditableSession(
                                                pdfFile,
                                                marker,
                                                handshake,
                                                handshakeGeneration,
                                            )
                                        val migratedResult =
                                            NativeAnnotationBackupResult(
                                                migratedBackup,
                                                "verified:migrated-legacy-session",
                                            )
                                        val migratedMarkerAuthority =
                                            readPersistedAuthorityIfFile(marker)
                                        val migratedProperties =
                                            migratedMarkerAuthority?.let { snapshot ->
                                                strictNativeSpreadMarkerProperties(
                                                    snapshot.bytes,
                                                )
                                            } ?: Properties()
                                        val migratedSettings =
                                            nativeSpreadMarkerSettings(
                                                pdfFile,
                                                migratedProperties,
                                                migratedResult,
                                            )
                                        val migratedAuthority =
                                            assessNativeSpreadAuthority(
                                                pdfFile,
                                                marker,
                                                migratedResult,
                                                migratedMarkerAuthority,
                                            )
                                        publishNativeSpreadModeAfterRevalidation(
                                            promise,
                                            pdfFile,
                                            migratedSettings.reportedConfigured,
                                            migratedSettings.configuredEditable,
                                            migratedSettings.coverSeparate,
                                            migratedSettings.showDivider,
                                            migratedSettings.showHeader,
                                            migratedSettings.spreadSizing,
                                            marker,
                                            migratedMarkerAuthority,
                                            capability,
                                            handshake,
                                            migratedResult,
                                            migratedAuthority,
                                        )
                                    } catch (error: Throwable) {
                                        Log.e(
                                            LOG_TAG,
                                            "RTL_READER_NATIVE_LEGACY_MIGRATION_FAILED: ${error.message}",
                                            error,
                                        )
                                        val failedResult =
                                            readNativeAnnotationBackup(pdfFile)
                                        val failedMarkerAuthority =
                                            readPersistedAuthorityIfFile(marker)
                                        val failedProperties =
                                            failedMarkerAuthority?.let { snapshot ->
                                                strictNativeSpreadMarkerProperties(
                                                    snapshot.bytes,
                                                )
                                            } ?: Properties()
                                        val failedSettings =
                                            nativeSpreadMarkerSettings(
                                                pdfFile,
                                                failedProperties,
                                                failedResult,
                                            )
                                        val failedAuthority =
                                            assessNativeSpreadAuthority(
                                                pdfFile,
                                                marker,
                                                failedResult,
                                                failedMarkerAuthority,
                                            )
                                        publishNativeSpreadModeAfterRevalidation(
                                            promise,
                                            pdfFile,
                                            failedSettings.reportedConfigured,
                                            failedSettings.configuredEditable,
                                            failedSettings.coverSeparate,
                                            failedSettings.showDivider,
                                            failedSettings.showHeader,
                                            failedSettings.spreadSizing,
                                            marker,
                                            failedMarkerAuthority,
                                            capability,
                                            handshake,
                                            failedResult,
                                            failedAuthority,
                                        )
                                    }
                                }
                                return@requestNativeSpreadHandshake
                            }
                            publishNativeSpreadModeAfterRevalidation(
                                promise,
                                pdfFile,
                                settings.reportedConfigured,
                                settings.configuredEditable,
                                settings.coverSeparate,
                                settings.showDivider,
                                settings.showHeader,
                                settings.spreadSizing,
                                marker,
                                markerAuthority,
                                capability,
                                handshake,
                                backupResult,
                                authority,
                            )
                        }
                    }
                } catch (error: Throwable) {
                    Handler(Looper.getMainLooper()).post {
                        promise.reject("NATIVE_SPREAD_LOAD_FAILED", error.message, error)
                    }
                }
            }
        } catch (error: Throwable) {
            promise.reject("NATIVE_SPREAD_LOAD_FAILED", error.message, error)
        }
    }

    @ReactMethod
    fun reconcileNativeSpreadRecovery(filePath: String, promise: Promise) {
        try {
            val pdfFile = requirePdf(filePath)
            val marker = nativeSpreadMarker(pdfFile)
            startNativeBackupWorker("RTLReaderNativeRecoveryReconcile") {
                try {
                    if (annotationRecoveryPending.get()) {
                        throw IllegalStateException(
                            "Annotation recovery is already in progress",
                        )
                    }
                    val before = assessNativeSpreadAuthority(
                        pdfFile,
                        marker,
                        readNativeAnnotationBackup(pdfFile),
                    )
                    if (before.recoveryNeeded) {
                        // This routine never guesses: every destructive branch is
                        // gated by the pending token, document/marker identity, and
                        // exact backup/archive hashes. Ambiguous evidence is kept.
                        reconcileFailedActivationBackupForExplicitActivation(
                            pdfFile,
                            marker,
                        )
                    }
                    val after = assessNativeSpreadAuthority(
                        pdfFile,
                        marker,
                        readNativeAnnotationBackup(pdfFile),
                    )
                    if (after.status != "ready" || after.recoveryNeeded) {
                        throw IllegalStateException(
                            "Native Spread recovery authority remains unresolved: ${after.reason}",
                        )
                    }
                    Log.i(
                        LOG_TAG,
                        "RTL_READER_NATIVE_RECOVERY_RECONCILED previous=${before.reason}",
                    )
                    promise.resolve(true)
                } catch (error: Throwable) {
                    Log.e(
                        LOG_TAG,
                        "RTL_READER_NATIVE_RECOVERY_RECONCILE_FAILED: ${error.message}",
                        error,
                    )
                    promise.reject(
                        "NATIVE_SPREAD_RECOVERY_RECONCILE_FAILED",
                        error.message,
                        error,
                    )
                }
            }
        } catch (error: Throwable) {
            promise.reject(
                "NATIVE_SPREAD_RECOVERY_RECONCILE_FAILED",
                error.message,
                error,
            )
        }
    }

    @ReactMethod
    fun configureNativeSpreadReadOnly(
        filePath: String,
        enabled: Boolean,
        coverSeparate: Boolean,
        showDivider: Boolean,
        showHeader: Boolean,
        spreadSizing: String,
        promise: Promise,
    ) {
        val configurationGeneration = beginNativeSpreadConfiguration()
        try {
            if (enabled) {
                throw IllegalStateException(
                    "RTL read-only belonged to the retired Native Spread engine. Native Reader v2 supports only Off or protected native editing.",
                )
            }
            val pdfFile = requirePdf(filePath)
            val marker = nativeSpreadMarker(pdfFile)
            val capability = nativeSpreadCapability()

            if (enabled && !capability.compatible) {
                throw IllegalStateException(
                    "Compatible Native Reader v2 module is not active for this firmware",
                )
            }

            fun applyReadOnlyConfiguration(handshake: NativeSpreadHandshake?) {
                startNativeBackupWorker("RTLReaderNativeBackupRetire") {
                    try {
                        requireNativeSpreadConfigurationGeneration(
                            configurationGeneration,
                        )
                        if (annotationRecoveryPending.get()) {
                            throw IllegalStateException(
                                "Annotation recovery is already in progress",
                            )
                        }
                        requireNoNativeMarkRecoveryFence(pdfFile)
                        withNativeSpreadConfigurationAuthority(
                            configurationGeneration,
                        ) {
                            reconcileFailedActivationBackupForExplicitActivation(
                                pdfFile,
                                marker,
                            )
                        }
                        val previousMarkerBytes = readPersistedBytesIfFile(marker)
                        val previousMarkerProperties = readPropertiesIfFile(marker)
                        val previousBackup = readNativeAnnotationBackup(pdfFile)
                        val protectedBackup = previousBackup.backup?.takeIf { backup ->
                            protectedEditableSessionMarkerValid(
                                pdfFile,
                                previousMarkerProperties,
                                backup,
                            )
                        }
                        if (previousBackup.backup != null && protectedBackup == null) {
                            throw IllegalStateException(
                                "Annotation recovery authority changed before Native Spread retirement",
                            )
                        }

                        var retirementToken: String? = null
                        if (protectedBackup != null) {
                            val token = UUID.randomUUID().toString()
                            retirementToken = token
                            writeNativeSpreadPendingMarker(
                                pdfFile,
                                marker,
                                token,
                                coverSeparate,
                                showDivider,
                                showHeader,
                                spreadSizing,
                                handshake,
                                protectedBackup,
                                if (enabled) {
                                    NATIVE_SPREAD_PENDING_READ_ONLY
                                } else {
                                    NATIVE_SPREAD_PENDING_DISABLE
                                },
                                previousMarkerBytes,
                                true,
                                configurationGeneration,
                            ) {}
                        }

                        withNativeSpreadConfigurationAuthority(configurationGeneration) {
                            if (protectedBackup != null) {
                                retireNativeAnnotationBackup(
                                    pdfFile,
                                    previousMarkerProperties,
                                    previousBackup,
                                )
                                if (nativeAnnotationBackupManifest(pdfFile).exists() ||
                                    nativeAnnotationBackupSnapshot(pdfFile).exists() ||
                                    nativeAnnotationRetiringSnapshot(pdfFile).exists()
                                ) {
                                    throw IllegalStateException(
                                        "Protected-session recovery retirement was not verified",
                                    )
                                }
                            }

                            retirementToken?.let { token ->
                                val pending = readPendingEditableActivation(
                                    pdfFile,
                                    readPropertiesIfFile(marker),
                                )
                                val expectedIntent = if (enabled) {
                                    NATIVE_SPREAD_PENDING_READ_ONLY
                                } else {
                                    NATIVE_SPREAD_PENDING_DISABLE
                                }
                                if (pending == null ||
                                    pending.activationToken != token ||
                                    pending.intent != expectedIntent ||
                                    !pendingPreviousMarkerMatchesIdentity(pdfFile, pending)
                                ) {
                                    throw IllegalStateException(
                                        "Protected-session retirement marker changed before final publication",
                                    )
                                }
                            }

                            if (!enabled) {
                                if (!deleteFileDurably(marker)) {
                                    throw IllegalStateException(
                                        "Could not remove native spread setting: ${marker.absolutePath}",
                                    )
                                }
                            } else {
                                writeNativeSpreadReadOnlyMarker(
                                    marker,
                                    coverSeparate,
                                    showDivider,
                                    showHeader,
                                    spreadSizing,
                                    checkNotNull(handshake),
                                )
                            }
                        }

                        runCatching {
                            Log.i(
                                LOG_TAG,
                                "RTL_READER_NATIVE_SPREAD_CONFIG enabled=$enabled marker=${marker.absolutePath}",
                            )
                        }
                        promise.resolve(enabled)
                    } catch (error: Throwable) {
                        Log.e(
                            LOG_TAG,
                            "RTL_READER_NATIVE_SPREAD_CONFIG_FAILED: ${error.message}",
                            error,
                        )
                        promise.reject(
                            "NATIVE_SPREAD_CONFIG_FAILED",
                            error.message,
                            error,
                        )
                    }
                }
            }

            if (!enabled) {
                applyReadOnlyConfiguration(null)
                return
            }

            requestNativeSpreadHandshake(
                pdfFile,
                configurationGeneration,
            ) { handshake ->
                if (!handshake.active) {
                    val error = IllegalStateException(
                        "Native Spread hooks did not answer the live safety check: ${handshake.reason}",
                    )
                    Log.e(
                        LOG_TAG,
                        "RTL_READER_NATIVE_SPREAD_CONFIG_FAILED: ${error.message}",
                        error,
                    )
                    promise.reject(
                        "NATIVE_SPREAD_HANDSHAKE_FAILED",
                        error.message,
                        error,
                    )
                    return@requestNativeSpreadHandshake
                }

                applyReadOnlyConfiguration(handshake)
            }
        } catch (error: Throwable) {
            Log.e(LOG_TAG, "RTL_READER_NATIVE_SPREAD_CONFIG_FAILED: ${error.message}", error)
            promise.reject("NATIVE_SPREAD_CONFIG_FAILED", error.message, error)
        }
    }

    @ReactMethod
    fun configureNativeSpreadEditable(
        filePath: String,
        coverSeparate: Boolean,
        showDivider: Boolean,
        showHeader: Boolean,
        spreadSizing: String,
        promise: Promise,
    ) {
        val configurationGeneration = beginNativeSpreadConfiguration()
        try {
            val pdfFile = requirePdf(filePath)
            val marker = nativeSpreadMarker(pdfFile)
            val capability = nativeSpreadCapability()
            if (!capability.compatible) {
                throw IllegalStateException(
                    "Compatible Native Reader v2 module is not active for this firmware",
                )
            }

            requestNativeSpreadHandshake(
                pdfFile,
                configurationGeneration,
            ) { handshake ->
                if (!handshake.active) {
                    val error = IllegalStateException(
                        "Native Spread hooks did not answer the live safety check: ${handshake.reason}",
                    )
                    promise.reject("NATIVE_SPREAD_HANDSHAKE_FAILED", error.message, error)
                    return@requestNativeSpreadHandshake
                }

                startNativeBackupWorker("RTLReaderNativeBackupCreate") {
                    try {
                        requireNativeSpreadConfigurationGeneration(
                            configurationGeneration,
                        )
                        if (annotationRecoveryPending.get()) {
                            throw IllegalStateException(
                                "Annotation recovery is already in progress",
                            )
                        }
                        requireNoNativeMarkRecoveryFence(pdfFile)
                        withNativeSpreadConfigurationAuthority(
                            configurationGeneration,
                        ) {
                            reconcileFailedActivationBackupForExplicitActivation(
                                pdfFile,
                                marker,
                            )
                        }
                        val backup = activateNativeSpreadEditableWithStableBackup(
                            pdfFile,
                            marker,
                            coverSeparate,
                            showDivider,
                            showHeader,
                            spreadSizing,
                            handshake,
                            configurationGeneration,
                        )
                        promise.resolve(nativeAnnotationBackupMap(backup, "verified"))
                    } catch (error: Throwable) {
                        Log.e(
                            LOG_TAG,
                            "RTL_READER_NATIVE_EDITABLE_CONFIG_FAILED: ${error.message}",
                            error,
                        )
                        promise.reject(
                            "NATIVE_SPREAD_EDITABLE_CONFIG_FAILED",
                            error.message,
                            error,
                        )
                    }
                }
            }
        } catch (error: Throwable) {
            Log.e(LOG_TAG, "RTL_READER_NATIVE_EDITABLE_CONFIG_FAILED: ${error.message}", error)
            promise.reject("NATIVE_SPREAD_EDITABLE_CONFIG_FAILED", error.message, error)
        }
    }

    @ReactMethod
    fun restoreNativeAnnotationBackup(filePath: String, promise: Promise) {
        var recoveryClaimed = false
        var restoreWorkerStarted = false
        try {
            val pdfFile = requirePdf(filePath)
            synchronized(nativeSpreadConfigurationLock) {
                if (!annotationRecoveryPending.compareAndSet(false, true)) {
                    throw IllegalStateException(
                        "Annotation recovery is already in progress",
                    )
                }
                recoveryClaimed = true
                annotationRecoveryHandoffPending.set(false)
                val result = readNativeAnnotationBackup(pdfFile)
                val backup = result.backup
                    ?: throw IllegalStateException(
                        "No verified annotation recovery snapshot is available: ${result.status}",
                    )
                val marker = nativeSpreadMarker(pdfFile)
                val recoveryInspection = inspectNativeMarkRecoveryFence(pdfFile, marker)
                val recoveryJournal = recoveryInspection.journal
                if (recoveryInspection.blocking && recoveryJournal == null) {
                    throw NativeMarkRecoveryRequiredException(
                        "Native mark recovery journal is not safely readable: " +
                            recoveryInspection.reason,
                        IllegalStateException(recoveryInspection.reason),
                    )
                }
                if (recoveryJournal != null &&
                    !nativeMarkRecoveryJournalMatchesBackup(recoveryJournal, backup)
                ) {
                    throw NativeMarkRecoveryRequiredException(
                        "Native mark recovery journal disagrees with the verified backup",
                        IllegalStateException("journal_backup_mismatch"),
                    )
                }
                // An explicit restore consumes a pending activation directly:
                // disabling its never-authorized marker preserves the canonical
                // recovery bytes for the restore worker instead of archiving them.
                if (recoveryJournal == null) {
                    withNativeSpreadPublicationLock(marker) {
                        val markerAuthority = readPersistedAuthorityIfFile(marker)
                        if (markerAuthority != null) {
                            deleteRegularFileCas(
                                marker,
                                markerAuthority.identity,
                                "Native Spread recovery disable",
                            )
                        }
                        if (readPersistedAuthorityIfFile(marker) != null) {
                            throw IllegalStateException(
                                "Could not disable Native Spread before recovery",
                            )
                        }
                    }
                }
                scheduleAnnotationRestore(pdfFile, backup) { error ->
                    Handler(Looper.getMainLooper()).post {
                        if (error == null) {
                            // Publish the one-shot handoff suppression before
                            // releasing worker ownership.  The opposite order
                            // leaves a cross-thread window in which a handoff
                            // can restart DocumentActivity between restore
                            // completion and suppression publication.
                            annotationRecoveryHandoffPending.set(true)
                            annotationRecoveryPending.set(false)
                            promise.resolve(nativeAnnotationBackupMap(backup, "restored"))
                            // App.js normally consumes this one-shot handoff skip
                            // immediately while closing. Avoid leaving it behind
                            // if DocumentActivity already dismissed PluginHost.
                            Handler(Looper.getMainLooper()).postDelayed(
                                {
                                    annotationRecoveryHandoffPending.compareAndSet(
                                        true,
                                        false,
                                    )
                                },
                                5000L,
                            )
                        } else {
                            annotationRecoveryPending.set(false)
                            annotationRecoveryHandoffPending.set(false)
                            val message =
                                "Annotation restore failed: ${error.message ?: "unknown error"}"
                            Toast.makeText(
                                reactApplicationContext,
                                message,
                                Toast.LENGTH_LONG,
                            ).show()
                            promise.reject(
                                "NATIVE_SPREAD_BACKUP_RESTORE_FAILED",
                                error.message,
                                error,
                            )
                        }
                    }
                }
                restoreWorkerStarted = true
                runCatching {
                    Log.i(
                        LOG_TAG,
                        "RTL_READER_NATIVE_BACKUP_RESTORE_PREPARED originalPresent=${backup.originalMarkPresent} backup=${backup.manifest.absolutePath}",
                    )
                }
            }
        } catch (error: Throwable) {
            if (recoveryClaimed && !restoreWorkerStarted) {
                annotationRecoveryPending.set(false)
                annotationRecoveryHandoffPending.set(false)
            }
            Log.e(LOG_TAG, "RTL_READER_NATIVE_BACKUP_RESTORE_FAILED: ${error.message}", error)
            promise.reject("NATIVE_SPREAD_BACKUP_RESTORE_FAILED", error.message, error)
        }
    }

    private fun writeNativeSpreadReadOnlyMarker(
        marker: File,
        coverSeparate: Boolean,
        showDivider: Boolean,
        showHeader: Boolean,
        spreadSizing: String,
        handshake: NativeSpreadHandshake,
        onPublished: () -> Unit = {},
    ) {
        check(handshake.active) { "Native Spread live safety check was not active" }

        val properties = Properties().apply {
            setProperty("enabled", "true")
            setProperty("direction", "rtl")
            setProperty("coverSeparate", coverSeparate.toString())
            setProperty("showDivider", showDivider.toString())
            setProperty("showHeader", showHeader.toString())
            setProperty(
                "spreadSizing",
                if (spreadSizing == "native_fill") "native_fill" else "fit",
            )
            setProperty("editable", "false")
            setProperty("disposable", "false")
            setProperty("managedBy", "supernote-rtl-reader")
            setProperty("mode", "read-only-pilot")
        }
        writePropertiesAtomically(
            marker,
            properties,
            "Supernote RTL native reader settings",
            onPublished,
        )
        runCatching {
            Log.i(
                LOG_TAG,
                "RTL_READER_NATIVE_SPREAD_CONFIG enabled=true editable=false cover=$coverSeparate hooksActive=true processId=${handshake.processId} marker=${marker.absolutePath}",
            )
        }
    }

    private fun nativeSpreadEditableMarkerProperties(
        pdfFile: File,
        activationToken: String,
        activationState: String,
        coverSeparate: Boolean,
        showDivider: Boolean,
        showHeader: Boolean,
        spreadSizing: String,
        backup: NativeAnnotationBackup,
        pendingIntent: String? = null,
        previousMarkerBytes: ByteArray? = null,
        previousMarkerProtected: Boolean = false,
    ): Properties {
        check(backup.documentPath == pdfFile.canonicalPath) {
            "Protected editable marker document identity changed"
        }
        check(activationState == NATIVE_SPREAD_ACTIVATION_PENDING ||
            activationState == NATIVE_SPREAD_ACTIVATION_COMMITTED
        ) {
            "Unsupported protected editable activation state"
        }
        check(
            if (activationState == NATIVE_SPREAD_ACTIVATION_PENDING) {
                pendingIntent == NATIVE_SPREAD_PENDING_ENABLE_EDITABLE ||
                    pendingIntent == NATIVE_SPREAD_PENDING_READ_ONLY ||
                    pendingIntent == NATIVE_SPREAD_PENDING_DISABLE
            } else {
                pendingIntent == null &&
                    previousMarkerBytes == null &&
                    !previousMarkerProtected
            },
        ) {
            "Committed protected editable markers cannot carry rollback authority"
        }
        check(!previousMarkerProtected || previousMarkerBytes != null) {
            "A protected previous marker must be present"
        }
        return Properties().apply {
            setProperty("nativeReaderEngine", "native-reader-v2")
            setProperty("enabled", "true")
            setProperty("direction", "rtl")
            setProperty("coverSeparate", coverSeparate.toString())
            setProperty("showDivider", showDivider.toString())
            setProperty("showHeader", showHeader.toString())
            setProperty(
                "spreadSizing",
                if (spreadSizing == "native_fill") "native_fill" else "fit",
            )
            setProperty("editable", "true")
            setProperty("disposable", "false")
            setProperty("managedBy", "supernote-rtl-reader")
            setProperty("mode", NATIVE_SPREAD_EDITABLE_MODE)
            setProperty(
                "transactionProtocol",
                NATIVE_SPREAD_EDITABLE_MARKER_PROTOCOL.toString(),
            )
            setProperty(
                "minimumModuleVersionCode",
                NATIVE_READER_V2_MIN_VERSION_CODE.toString(),
            )
            setProperty("activationToken", activationToken)
            setProperty("activationState", activationState)
            setProperty("documentPath", backup.documentPath)
            setProperty("documentLength", backup.documentLength.toString())
            setProperty("documentSha256", backup.documentSha256)
            setProperty("backupVerified", "true")
            setProperty("backupManifestPath", backup.manifest.canonicalPath)
            setProperty("backupManifestLength", backup.manifestLength.toString())
            setProperty("backupManifestSha256", backup.manifestSha256)
            setProperty("backupSnapshotPath", backup.snapshot.canonicalPath)
            setProperty("markPath", backup.mark.canonicalPath)
            setProperty("originalMarkPresent", backup.originalMarkPresent.toString())
            setProperty("markLength", backup.markLength.toString())
            setProperty("markSha256", backup.markSha256)
            setProperty("backupCreatedAt", backup.createdAt.toString())
            if (activationState == NATIVE_SPREAD_ACTIVATION_PENDING) {
                setProperty("pendingIntent", checkNotNull(pendingIntent))
                val previousPresent = previousMarkerBytes != null
                setProperty("previousMarkerPresent", previousPresent.toString())
                setProperty("previousMarkerProtected", previousMarkerProtected.toString())
                setProperty(
                    "previousMarkerLength",
                    (previousMarkerBytes?.size ?: 0).toString(),
                )
                setProperty("previousMarkerSha256",
                    previousMarkerBytes?.let { bytes -> sha256(bytes) } ?: "ABSENT",
                )
                setProperty("previousMarkerBase64",
                    previousMarkerBytes?.let { bytes ->
                        Base64.getEncoder().encodeToString(bytes)
                    } ?: "",
                )
            }
        }
    }

    private fun editableMarkerPresentationMatches(
        properties: Properties,
        coverSeparate: Boolean,
        showDivider: Boolean,
        showHeader: Boolean,
        spreadSizing: String,
    ): Boolean =
        properties.getProperty("coverSeparate", "") == coverSeparate.toString() &&
            properties.getProperty("showDivider", "") == showDivider.toString() &&
            properties.getProperty("showHeader", "") == showHeader.toString() &&
            properties.getProperty("spreadSizing", "") ==
                (if (spreadSizing == "native_fill") "native_fill" else "fit")

    private fun writeNativeSpreadPendingMarker(
        pdfFile: File,
        marker: File,
        activationToken: String,
        coverSeparate: Boolean,
        showDivider: Boolean,
        showHeader: Boolean,
        spreadSizing: String,
        handshake: NativeSpreadHandshake?,
        backup: NativeAnnotationBackup,
        pendingIntent: String,
        previousMarkerBytes: ByteArray?,
        previousMarkerProtected: Boolean,
        configurationGeneration: Long,
        onPublished: () -> Unit,
    ): NativeAnnotationBackup = withNativeSpreadPublicationLock(marker) {
        check(
            pendingIntent == NATIVE_SPREAD_PENDING_DISABLE ||
                handshake?.active == true,
        ) {
            "Native Spread live safety check was not active"
        }
        if (!nativeAnnotationBackupSourceFilesMatch(backup)) {
            throw IllegalStateException(
                "The annotation recovery files changed before marker publication",
            )
        }
        val currentMarkerAuthority = readPersistedAuthorityIfFile(marker)
        val currentMarkerBytes = currentMarkerAuthority?.bytes
        val previousMarkerStillCurrent = if (previousMarkerBytes == null) {
            currentMarkerBytes == null && !marker.exists()
        } else {
            currentMarkerBytes?.contentEquals(previousMarkerBytes) == true
        }
        if (!previousMarkerStillCurrent) {
            throw IllegalStateException(
                "Native Spread marker changed before pending publication",
            )
        }
        val properties = nativeSpreadEditableMarkerProperties(
            pdfFile,
            activationToken,
            NATIVE_SPREAD_ACTIVATION_PENDING,
            coverSeparate,
            showDivider,
            showHeader,
            spreadSizing,
            backup,
            pendingIntent,
            previousMarkerBytes,
            previousMarkerProtected,
        )
        if (readPendingEditableActivation(pdfFile, properties, backup) == null) {
            throw IllegalStateException(
                "Protected editable pending marker was invalid before publication",
            )
        }
        withNativeSpreadConfigurationAuthority(configurationGeneration) {
            writePropertiesAtomicallyCas(
                marker,
                properties,
                "Supernote RTL protected editable pending activation",
                expected = currentMarkerAuthority,
                onPublished = onPublished,
                beforePublish = {
                    requireNativeSpreadConfigurationGeneration(
                        configurationGeneration,
                    )
                    if (!nativeAnnotationBackupSourceFilesMatch(backup)) {
                        throw IllegalStateException(
                            "The annotation recovery files changed at pending publication",
                        )
                    }
                    val immediateMarker = readPersistedAuthorityIfFile(marker)
                    val immediateMarkerBytes = immediateMarker?.bytes
                    val stillOwned = if (previousMarkerBytes == null) {
                        immediateMarker == null
                    } else {
                        samePersistedAuthority(currentMarkerAuthority, immediateMarker) &&
                            immediateMarkerBytes?.contentEquals(previousMarkerBytes) == true
                    }
                    if (!stillOwned) {
                        throw IllegalStateException(
                            "Native Spread marker changed at pending publication",
                        )
                    }
                    val immediateBackup = readNativeAnnotationBackup(pdfFile).backup
                    if (immediateBackup == null ||
                        !sameNativeAnnotationBackup(backup, immediateBackup)
                    ) {
                        throw IllegalStateException(
                            "Annotation recovery identity changed at pending publication",
                        )
                    }
                },
            )
        }
        // The atomic rename above is the publication boundary. Report it before
        // any reread can fail so rollback never mistakes published recovery
        // authority for a pre-publication failure.
        val verified = readPropertiesIfFile(marker)
        val verifiedBackup = readNativeAnnotationBackup(pdfFile).backup
            ?: throw IllegalStateException(
                "The annotation recovery files changed after marker publication",
            )
        if (!sameNativeAnnotationBackup(backup, verifiedBackup) ||
            readPendingEditableActivation(pdfFile, verified, verifiedBackup)?.let {
                pending ->
                pending.activationToken == activationToken &&
                    pending.intent == pendingIntent &&
                    pending.previousMarkerProtected == previousMarkerProtected &&
                    (
                        if (previousMarkerBytes == null) {
                            pending.previousMarkerBytes == null
                        } else {
                            pending.previousMarkerBytes?.contentEquals(
                                previousMarkerBytes,
                            ) == true
                        }
                    )
            } != true ||
            !editableMarkerPresentationMatches(
                verified,
                coverSeparate,
                showDivider,
                showHeader,
                spreadSizing,
            )
        ) {
            throw IllegalStateException(
                "Protected editable pending marker verification failed",
            )
        }
        Log.i(
            LOG_TAG,
            "RTL_READER_NATIVE_SPREAD_TRANSITION_PENDING token=$activationToken intent=$pendingIntent marker=${marker.absolutePath}",
        )
        verifiedBackup
    }

    private fun commitNativeSpreadEditableMarker(
        pdfFile: File,
        marker: File,
        activationToken: String,
        coverSeparate: Boolean,
        showDivider: Boolean,
        showHeader: Boolean,
        spreadSizing: String,
        backup: NativeAnnotationBackup,
        requireLiveBaselineMatch: Boolean,
        configurationGeneration: Long,
        onCommitted: () -> Unit,
    ): NativeAnnotationBackup = withNativeSpreadPublicationLock(marker) {
        val pendingMarkerAuthority = readPersistedAuthorityIfFile(marker)
            ?: throw IllegalStateException(
                "Protected editable pending marker disappeared before commit",
            )
        val pendingMarkerBytes = pendingMarkerAuthority.bytes
        val pendingProperties = strictNativeSpreadMarkerProperties(
            pendingMarkerBytes,
        )
        val pending = readPendingEditableActivation(
            pdfFile,
            pendingProperties,
            backup,
        )
        if (pending?.activationToken != activationToken ||
            pending?.intent != NATIVE_SPREAD_PENDING_ENABLE_EDITABLE ||
            !editableMarkerPresentationMatches(
                pendingProperties,
                coverSeparate,
                showDivider,
                showHeader,
                spreadSizing,
            ) ||
            !nativeAnnotationBackupSourceFilesMatch(backup)
        ) {
            throw IllegalStateException(
                "Protected editable pending activation changed before commit",
            )
        }
        val committedProperties = nativeSpreadEditableMarkerProperties(
            pdfFile,
            activationToken,
            NATIVE_SPREAD_ACTIVATION_COMMITTED,
            coverSeparate,
            showDivider,
            showHeader,
            spreadSizing,
            backup,
        )
        if (!protectedEditableMarkerValid(pdfFile, committedProperties, backup)) {
            throw IllegalStateException(
                "Protected editable committed marker was invalid before publication",
            )
        }

        // This rename is the sole authorization/linearization point. There is
        // deliberately no fallible reread after it: pending is always rejected
        // by the companion, while a committed marker is final and must never be
        // rolled back merely because the publisher died after the rename.
        withNativeSpreadConfigurationAuthority(configurationGeneration) {
            writePropertiesAtomicallyCas(
                marker,
                committedProperties,
                "Supernote RTL protected editable committed activation",
                expected = pendingMarkerAuthority,
                onPublished = onCommitted,
                beforePublish = {
                    requireNativeSpreadConfigurationGeneration(
                        configurationGeneration,
                    )
                    val immediateMarker = readPersistedAuthorityIfFile(marker)
                    if (!samePersistedAuthority(
                            pendingMarkerAuthority,
                            immediateMarker,
                        ) || immediateMarker?.bytes?.contentEquals(pendingMarkerBytes) != true
                    ) {
                        throw IllegalStateException(
                            "Protected editable pending marker changed at commit publication",
                        )
                    }
                    val immediateBackup = readNativeAnnotationBackup(pdfFile).backup
                    if (immediateBackup == null ||
                        !sameNativeAnnotationBackup(backup, immediateBackup) ||
                        !nativeAnnotationBackupSourceFilesMatch(immediateBackup)
                    ) {
                        throw IllegalStateException(
                            "Annotation recovery identity changed at commit publication",
                        )
                    }
                    // First activation must still match the recovery snapshot after
                    // the temporary marker has been durably synced. This callback
                    // runs immediately before the authorization rename, closing the
                    // window in which a delayed native .mark flush could otherwise
                    // authorize a stale baseline. Existing protected sessions may
                    // legitimately differ from their original recovery snapshot.
                    if (requireLiveBaselineMatch &&
                        !liveNativeAnnotationMatchesBackup(backup)
                    ) {
                        throw IllegalStateException(
                            "Supernote annotations changed immediately before protected editing authorization",
                        )
                    }
                },
            )
        }
        backup
    }

    /**
     * The handshake is asynchronous and may outlive the marker snapshot that
     * supplied the UI settings. Revalidate that exact descriptor-backed
     * authority off the main thread immediately before publishing the result;
     * a concurrent replacement is a stale load, never permission to combine
     * old settings with newer marker authority.
     */
    private fun publishNativeSpreadModeAfterRevalidation(
        promise: Promise,
        pdfFile: File,
        configured: Boolean,
        configuredEditable: Boolean,
        coverSeparate: Boolean,
        showDivider: Boolean,
        showHeader: Boolean,
        spreadSizing: String,
        marker: File,
        expectedMarkerAuthority: PersistedFileAuthority?,
        capability: NativeSpreadCapability,
        handshake: NativeSpreadHandshake,
        backupResult: NativeAnnotationBackupResult,
        authority: NativeSpreadAuthorityAssessment,
    ) {
        startNativeBackupWorker("RTLReaderNativeModePublish") {
            try {
                val currentMarkerAuthority = readPersistedAuthorityIfFile(marker)
                require(
                    samePersistedAuthority(
                        expectedMarkerAuthority,
                        currentMarkerAuthority,
                    ),
                ) {
                    "Native Spread marker changed while its settings were loading"
                }
                Handler(Looper.getMainLooper()).post {
                    resolveNativeSpreadMode(
                        promise,
                        pdfFile,
                        configured,
                        configuredEditable,
                        coverSeparate,
                        showDivider,
                        showHeader,
                        spreadSizing,
                        marker,
                        capability,
                        handshake,
                        backupResult,
                        authority,
                    )
                }
            } catch (error: Throwable) {
                Handler(Looper.getMainLooper()).post {
                    promise.reject(
                        "NATIVE_SPREAD_LOAD_STALE",
                        error.message,
                        error,
                    )
                }
            }
        }
    }

    private fun resolveNativeSpreadMode(
        promise: Promise,
        pdfFile: File,
        configured: Boolean,
        configuredEditable: Boolean,
        coverSeparate: Boolean,
        showDivider: Boolean,
        showHeader: Boolean,
        spreadSizing: String,
        marker: File,
        capability: NativeSpreadCapability,
        handshake: NativeSpreadHandshake,
        backupResult: NativeAnnotationBackupResult,
        authority: NativeSpreadAuthorityAssessment,
    ) {
        val runtimeCompatible = capability.compatible && handshake.active
        val result = Arguments.createMap().apply {
            putBoolean("configured", configured)
            putBoolean("configuredEditable", configuredEditable)
            putBoolean("activationPending", authority.activationPending)
            putBoolean("recoveryNeeded", authority.recoveryNeeded)
            putBoolean("reconciliationAvailable", authority.reconciliationAvailable)
            putString("authorityStatus", authority.status)
            putString("authorityReason", authority.reason)
            putBoolean(
                "enabled",
                configuredEditable && runtimeCompatible,
            )
            putBoolean("editable", configuredEditable && runtimeCompatible)
            putBoolean("coverSeparate", coverSeparate)
            putBoolean("showDivider", showDivider)
            putBoolean("showHeader", showHeader)
            putString("spreadSizing", spreadSizing)
            putString("markerPath", marker.absolutePath)
            putBoolean("compatible", runtimeCompatible)
            putBoolean("hooksActive", handshake.active)
            putString("handshakeReason", handshake.reason)
            putDouble("handshakeProtocol", handshake.protocol.toDouble())
            putDouble("handshakeProcessId", handshake.processId.toDouble())
            putBoolean("moduleInstalled", capability.moduleVersionCode >= 0L)
            putDouble("moduleVersionCode", capability.moduleVersionCode.toDouble())
            putString("moduleVersionName", capability.moduleVersionName)
            putString("moduleSignerSha256", capability.moduleSignerSha256)
            putDouble(
                "documentVersionCode",
                capability.documentVersionCode.toDouble(),
            )
            putString("firmwareFingerprint", Build.FINGERPRINT)
            putBoolean("backupAvailable", backupResult.backup != null)
            putString("backupStatus", backupResult.status)
            putBoolean(
                "backupOriginalMarkPresent",
                backupResult.backup?.originalMarkPresent == true,
            )
            putDouble(
                "backupCreatedAt",
                (backupResult.backup?.createdAt ?: 0L).toDouble(),
            )
        }
        Log.i(
            LOG_TAG,
            "RTL_READER_NATIVE_SPREAD_HANDSHAKE active=${handshake.active} reason=${handshake.reason} protocol=${handshake.protocol} processId=${handshake.processId}",
        )
        promise.resolve(result)
    }

    private data class NativeSpreadCapability(
        val compatible: Boolean,
        val moduleVersionCode: Long,
        val moduleVersionName: String?,
        val documentVersionCode: Long,
        val moduleSignerSha256: String?,
    )

    private data class NativeSpreadHandshake(
        val active: Boolean,
        val reason: String,
        val protocol: Int = -1,
        val processId: Int = -1,
    )

    private data class NativeAnnotationBackup(
        val manifest: File,
        val snapshot: File,
        val mark: File,
        val manifestLength: Long,
        val manifestSha256: String,
        val documentPath: String,
        val documentLength: Long,
        val documentSha256: String,
        val originalMarkPresent: Boolean,
        val markLength: Long,
        val markSha256: String,
        val createdAt: Long,
    )

    private data class NativeAnnotationBackupResult(
        val backup: NativeAnnotationBackup?,
        val status: String,
    )

    /**
     * Durable, fail-closed authority for a native `.mark` restore.  The journal
     * deliberately occupies the ordinary `.snspread` marker path: the injected
     * companion treats any malformed/non-admitted marker there as an input
     * fence, so an Android relaunch after a PluginHost crash cannot write
     * through an unfinished restore.
     */
    private data class NativeMarkRecoveryJournal(
        val marker: File,
        val authority: PersistedFileAuthority,
        val operationId: String,
        val documentPath: String,
        val documentLength: Long,
        val documentSha256: String,
        val markPath: String,
        val desiredMarkPresent: Boolean,
        val desiredMarkLength: Long,
        val desiredMarkSha256: String,
        val backupManifestPath: String,
        val backupManifestLength: Long,
        val backupManifestSha256: String,
        val backupSnapshotPath: String,
        val createdAt: Long,
    )

    private data class NativeMarkRecoveryInspection(
        val journal: NativeMarkRecoveryJournal?,
        val blocking: Boolean,
        val reason: String,
    )

    private data class PersistedFileAuthority(
        val bytes: ByteArray,
        val identity: StructStat,
    )

    private data class NativeMarkPublication(
        val mark: File,
        val publishedIdentity: StructStat?,
        val publishedBytes: ByteArray?,
        val previousPresent: Boolean,
        val previousBytes: ByteArray?,
        val displaced: File?,
        val displacedIdentity: StructStat?,
        val displacementDirectory: File?,
        val displacementDirectoryIdentity: StructStat?,
        val changed: Boolean,
    )

    private data class DisplacedRegularFile(
        val file: File,
        val identity: StructStat,
        val bytes: ByteArray,
        val transactionDirectory: File,
        val transactionDirectoryIdentity: StructStat,
    )

    /**
     * The live native annotation path could not be proven usable after a
     * no-clobber transaction moved an inode aside.  Callers must keep
     * DocumentActivity stopped: reopening it could create a new empty .mark or
     * persist a stale in-memory model over the retained recovery evidence.
     */
    private class NativeMarkRecoveryRequiredException(
        message: String,
        cause: Throwable,
    ) : IllegalStateException(message, cause)

    private data class NativeSpreadAuthorityAssessment(
        val status: String,
        val reason: String,
        val activationPending: Boolean,
        val recoveryNeeded: Boolean,
        val reconciliationAvailable: Boolean,
    )

    private data class NativeSpreadMarkerSettings(
        val reportedConfigured: Boolean,
        val configuredEditable: Boolean,
        val legacyConfiguredEditable: Boolean,
        val coverSeparate: Boolean,
        val showDivider: Boolean,
        val showHeader: Boolean,
        val spreadSizing: String,
    )

    private fun nativeSpreadMarkerSettings(
        pdfFile: File,
        properties: Properties,
        backupResult: NativeAnnotationBackupResult,
    ): NativeSpreadMarkerSettings {
        val pendingActivation =
            properties.getProperty("mode", "") == NATIVE_SPREAD_EDITABLE_MODE &&
                properties.getProperty("activationState", "") ==
                NATIVE_SPREAD_ACTIVATION_PENDING
        val configured = !pendingActivation &&
            properties.getProperty("enabled", "false")
                .equals("true", ignoreCase = true) &&
            properties.getProperty("direction", "")
                .equals("rtl", ignoreCase = true)
        val configuredEditable = configured &&
            protectedEditableMarkerValid(
                pdfFile,
                properties,
                backupResult.backup,
            )
        val legacyConfiguredEditable = configured &&
            legacyProtectedEditableMarkerValid(
                pdfFile,
                properties,
                backupResult.backup,
            )
        val reportedConfigured = configured &&
            (
                !markerClaimsProtectedEditable(properties) ||
                    configuredEditable ||
                    legacyConfiguredEditable
                )
        val coverSeparate = properties
            .getProperty("coverSeparate", "false")
            .equals("true", ignoreCase = true)
        val showDivider = !properties
            .getProperty("showDivider", "true")
            .equals("false", ignoreCase = true)
        val showHeader = !properties
            .getProperty("showHeader", "true")
            .equals("false", ignoreCase = true)
        val spreadSizing = if (
            properties.getProperty("spreadSizing", "fit")
                .equals("native_fill", ignoreCase = true)
        ) "native_fill" else "fit"
        return NativeSpreadMarkerSettings(
            reportedConfigured,
            configuredEditable,
            legacyConfiguredEditable,
            coverSeparate,
            showDivider,
            showHeader,
            spreadSizing,
        )
    }

    private fun assessNativeSpreadAuthority(
        pdfFile: File,
        marker: File,
        backupResult: NativeAnnotationBackupResult,
    ): NativeSpreadAuthorityAssessment {
        val markerAuthority = try {
            readPersistedAuthorityIfFile(marker)
        } catch (error: Throwable) {
            return NativeSpreadAuthorityAssessment(
                "error",
                "marker_unreadable:${error.message}",
                false,
                true,
                true,
            )
        }
        return assessNativeSpreadAuthority(
            pdfFile,
            marker,
            backupResult,
            markerAuthority,
        )
    }

    private fun assessNativeSpreadAuthority(
        pdfFile: File,
        marker: File,
        backupResult: NativeAnnotationBackupResult,
        markerAuthority: PersistedFileAuthority?,
    ): NativeSpreadAuthorityAssessment {
        val recoveryInspection = inspectNativeMarkRecoveryFenceFromAuthority(
            pdfFile,
            marker,
            markerAuthority,
        )
        if (recoveryInspection.blocking) {
            return NativeSpreadAuthorityAssessment(
                "recovery",
                "native_mark_recovery:${recoveryInspection.reason}",
                false,
                true,
                recoveryInspection.journal != null && backupResult.backup != null,
            )
        }
        val markerProperties = try {
            markerAuthority?.let { authority ->
                strictNativeSpreadMarkerProperties(authority.bytes)
            } ?: Properties()
        } catch (error: Throwable) {
            return NativeSpreadAuthorityAssessment(
                "error",
                "marker_unreadable:${error.message}",
                false,
                true,
                true,
            )
        }
        val activationPending =
            markerProperties.getProperty("mode", "") ==
                NATIVE_SPREAD_EDITABLE_MODE &&
                markerProperties.getProperty("activationState", "") ==
                NATIVE_SPREAD_ACTIVATION_PENDING
        val managedEditableMarker =
            markerProperties.getProperty("managedBy", "") ==
                "supernote-rtl-reader" &&
                (
                    markerProperties.getProperty("mode", "") ==
                        NATIVE_SPREAD_EDITABLE_MODE ||
                        markerProperties.getProperty("mode", "") ==
                        NATIVE_SPREAD_LEGACY_EDITABLE_MODE
                    )
        val protectedMarkerValid = backupResult.backup?.let { backup ->
            protectedEditableSessionMarkerValid(pdfFile, markerProperties, backup)
        } == true
        val canonicalEvidencePresent = runCatching {
            nativeAnnotationBackupManifest(pdfFile).exists() ||
                nativeAnnotationBackupSnapshot(pdfFile).exists() ||
                nativeAnnotationRetiringSnapshot(pdfFile).exists()
        }.getOrDefault(true)
        val backupInvalid = backupResult.status.startsWith("invalid:")
        val unresolvedManagedMarker =
            managedEditableMarker && !activationPending && !protectedMarkerValid
        val orphanedVerifiedBackup =
            backupResult.backup != null && !activationPending && !protectedMarkerValid
        val incompleteCanonicalEvidence =
            canonicalEvidencePresent && backupResult.backup == null
        val recoveryReason = when {
            activationPending -> "pending_protected_transition"
            unresolvedManagedMarker -> "managed_editable_authority_invalid"
            backupInvalid -> "canonical_backup_invalid"
            orphanedVerifiedBackup -> "orphaned_verified_backup"
            incompleteCanonicalEvidence -> "orphaned_recovery_files"
            else -> null
        }
        return if (recoveryReason == null) {
            NativeSpreadAuthorityAssessment(
                "ready",
                "verified",
                false,
                false,
                false,
            )
        } else {
            NativeSpreadAuthorityAssessment(
                if (activationPending) "pending" else "recovery",
                recoveryReason,
                activationPending,
                true,
                true,
            )
        }
    }

