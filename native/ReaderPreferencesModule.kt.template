        return File(parent, ".${pdfFile.name}$NATIVE_SPREAD_BACKUP_SUFFIX")
    }

    private fun nativeAnnotationBackupSnapshot(pdfFile: File): File {
        val parent = pdfFile.parentFile
            ?: throw IllegalStateException("Current PDF has no parent directory")
        return File(parent, ".${pdfFile.name}$NATIVE_SPREAD_BACKUP_MARK_SUFFIX")
    }

    private fun nativeAnnotationRetiringSnapshot(pdfFile: File): File =
