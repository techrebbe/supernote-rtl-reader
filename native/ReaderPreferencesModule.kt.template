    private val preferences by lazy {
        reactApplicationContext.getSharedPreferences(STORE_NAME, Context.MODE_PRIVATE)
    }

    @Volatile
    private var lastSavedFilePath: String? = null

    private val annotationRecoveryPending = AtomicBoolean(false)

    override fun getName(): String = "ReaderPreferencesModule"

    @ReactMethod
    fun load(filePath: String, promise: Promise) {
        try {
            promise.resolve(preferences.getString(filePath, null))
        } catch (error: Throwable) {
            promise.reject("READER_PREFS_LOAD_FAILED", error.message, error)
        }
    }

    @ReactMethod
    fun save(filePath: String, json: String, promise: Promise) {
        try {
            val saved = preferences.edit().putString(filePath, json).commit()
            if (!saved) {
                throw IllegalStateException("SharedPreferences commit returned false")
            }
            lastSavedFilePath = filePath
            promise.resolve(true)
        } catch (error: Throwable) {
            promise.reject("READER_PREFS_SAVE_FAILED", error.message, error)
        }
    }

    @ReactMethod
    fun remove(filePath: String, promise: Promise) {
        try {
            val removed = preferences.edit().remove(filePath).commit()
            if (!removed) {
                throw IllegalStateException("SharedPreferences commit returned false")
            }
            if (lastSavedFilePath == filePath) {
                lastSavedFilePath = null
            }
            promise.resolve(true)
        } catch (error: Throwable) {
            promise.reject("READER_PREFS_REMOVE_FAILED", error.message, error)
        }
    }

    @ReactMethod
    fun loadNativeSpreadMode(filePath: String, promise: Promise) {
        try {
            val pdfFile = requirePdf(filePath)
            val marker = nativeSpreadMarker(pdfFile)
            val properties = Properties()
            if (marker.isFile) {
                FileInputStream(marker).use { input -> properties.load(input) }
            }

            val configured = properties.getProperty("enabled", "false")
                .equals("true", ignoreCase = true) &&
                properties.getProperty("direction", "")
                    .equals("rtl", ignoreCase = true)
            val backupResult = readNativeAnnotationBackup(pdfFile)
            val configuredEditable = configured &&
                protectedEditableMarkerValid(
                    pdfFile,
                    properties,
                    backupResult.backup,
                )
            val coverSeparate = properties.getProperty("coverSeparate", "false")
                .equals("true", ignoreCase = true)
            val showDivider = !properties.getProperty("showDivider", "true")
                .equals("false", ignoreCase = true)
            val spreadSizing = if (
                properties.getProperty("spreadSizing", "fit")
                    .equals("native_fill", ignoreCase = true)
            ) "native_fill" else "fit"
            val capability = nativeSpreadCapability()

            if (!capability.compatible) {
                resolveNativeSpreadMode(
                    promise,
                    configured,
                    configuredEditable,
                    coverSeparate,
                    showDivider,
                    spreadSizing,
                    marker,
                    capability,
                    NativeSpreadHandshake(false, "package_incompatible"),
                    backupResult,
                )
                return
            }

            requestNativeSpreadHandshake(pdfFile) { handshake ->
                resolveNativeSpreadMode(
                    promise,
                    configured,
                    configuredEditable,
                    coverSeparate,
                    showDivider,
                    spreadSizing,
                    marker,
                    capability,
                    handshake,
                    backupResult,
                )
            }
        } catch (error: Throwable) {
            promise.reject("NATIVE_SPREAD_LOAD_FAILED", error.message, error)
        }
    }

    @ReactMethod
    fun configureNativeSpreadReadOnly(
        filePath: String,
        enabled: Boolean,
        coverSeparate: Boolean,
        showDivider: Boolean,
        spreadSizing: String,
        promise: Promise,
    ) {
        try {
            val pdfFile = requirePdf(filePath)
            val marker = nativeSpreadMarker(pdfFile)
            val capability = nativeSpreadCapability()

            if (enabled && !capability.compatible) {
                throw IllegalStateException(
                    "Compatible Native Spread module is not active for this firmware",
                )
            }

            fun applyReadOnlyConfiguration(handshake: NativeSpreadHandshake?) {
                startNativeBackupWorker("RTLReaderNativeBackupRetire") {
                    try {
                        val previousMarkerBytes = if (marker.isFile) marker.readBytes() else null
                        val previousMarkerProperties = readPropertiesIfFile(marker)
                        val previousBackup = readNativeAnnotationBackup(pdfFile)
                        var markerChanged = false
                        try {
                            if (!enabled) {
                                if (marker.exists() && !marker.delete()) {
                                    throw IllegalStateException(
                                        "Could not remove native spread setting: ${marker.absolutePath}",
                                    )
                                }
                                markerChanged = true
                            } else {
                                writeNativeSpreadReadOnlyMarker(
                                    marker,
                                    coverSeparate,
                                    showDivider,
                                    spreadSizing,
                                    checkNotNull(handshake),
                                )
                                markerChanged = true
                            }
                            retireNativeAnnotationBackup(
                                pdfFile,
                                previousMarkerProperties,
                                previousBackup,
                            )
                        } catch (error: Throwable) {
                            if (markerChanged) {
                                try {
                                    if (previousMarkerBytes == null) {
                                        if (marker.exists() && !marker.delete()) {
                                            throw IllegalStateException(
                                                "Could not remove the replacement native spread marker",
                                            )
                                        }
                                    } else {
                                        writeBytesAtomically(marker, previousMarkerBytes)
                                    }
                                    Log.w(
                                        LOG_TAG,
                                        "RTL_READER_NATIVE_MARKER_ROLLED_BACK marker=${marker.absolutePath}",
                                    )
                                } catch (rollbackError: Throwable) {
                                    error.addSuppressed(rollbackError)
                                    Log.e(
                                        LOG_TAG,
                                        "RTL_READER_NATIVE_MARKER_ROLLBACK_FAILED marker=${marker.absolutePath}",
                                        rollbackError,
                                    )
                                }
                            }
                            throw error
                        }

                        Log.i(
                            LOG_TAG,
                            "RTL_READER_NATIVE_SPREAD_CONFIG enabled=$enabled marker=${marker.absolutePath}",
                        )
                        promise.resolve(enabled)
                    } catch (error: Throwable) {
                        Log.e(
                            LOG_TAG,
                            "RTL_READER_NATIVE_SPREAD_CONFIG_FAILED: ${error.message}",
                            error,
                        )
                        promise.reject(
                            "NATIVE_SPREAD_CONFIG_FAILED",
                            error.message,
                            error,
                        )
                    }
                }
            }

            if (!enabled) {
                applyReadOnlyConfiguration(null)
                return
            }

            requestNativeSpreadHandshake(pdfFile) { handshake ->
                if (!handshake.active) {
                    val error = IllegalStateException(
                        "Native Spread hooks did not answer the live safety check: ${handshake.reason}",
                    )
                    Log.e(
                        LOG_TAG,
                        "RTL_READER_NATIVE_SPREAD_CONFIG_FAILED: ${error.message}",
                        error,
                    )
                    promise.reject(
                        "NATIVE_SPREAD_HANDSHAKE_FAILED",
                        error.message,
                        error,
                    )
                    return@requestNativeSpreadHandshake
                }

                applyReadOnlyConfiguration(handshake)
            }
        } catch (error: Throwable) {
            Log.e(LOG_TAG, "RTL_READER_NATIVE_SPREAD_CONFIG_FAILED: ${error.message}", error)
            promise.reject("NATIVE_SPREAD_CONFIG_FAILED", error.message, error)
        }
    }

    @ReactMethod
    fun configureNativeSpreadEditable(
        filePath: String,
        coverSeparate: Boolean,
        showDivider: Boolean,
        spreadSizing: String,
        promise: Promise,
    ) {
        try {
            val pdfFile = requirePdf(filePath)
            val marker = nativeSpreadMarker(pdfFile)
            val capability = nativeSpreadCapability()
            if (!capability.compatible) {
                throw IllegalStateException(
                    "Compatible Native Spread module is not active for this firmware",
                )
            }

            requestNativeSpreadHandshake(pdfFile) { handshake ->
                if (!handshake.active) {
                    val error = IllegalStateException(
                        "Native Spread hooks did not answer the live safety check: ${handshake.reason}",
                    )
                    promise.reject("NATIVE_SPREAD_HANDSHAKE_FAILED", error.message, error)
                    return@requestNativeSpreadHandshake
                }

                startNativeBackupWorker("RTLReaderNativeBackupCreate") {
                    try {
                        val previousMarkerBytes = if (marker.isFile) marker.readBytes() else null
                        val backupManifestExisted = nativeAnnotationBackupManifest(pdfFile).isFile
                        val backup = ensureStableNativeAnnotationBackupForActivation(
                            pdfFile,
                            backupManifestExisted,
                        )
                        try {
                            writeNativeSpreadEditableMarker(
                                pdfFile,
                                marker,
                                coverSeparate,
                                showDivider,
                                spreadSizing,
                                handshake,
                                backup,
                            )
                        } catch (activationError: Throwable) {
                            try {
                                if (previousMarkerBytes == null) {
                                    if (marker.exists() && !marker.delete()) {
                                        throw IllegalStateException(
                                            "Could not remove the failed protected editable marker",
                                        )
                                    }
                                } else {
                                    writeBytesAtomically(marker, previousMarkerBytes)
                                }
                                if (!backupManifestExisted) {
                                    removeNativeAnnotationBackupFiles(pdfFile, backup)
                                }
                                Log.w(
                                    LOG_TAG,
                                    "RTL_READER_NATIVE_EDITABLE_ACTIVATION_ROLLED_BACK marker=${marker.absolutePath} backupCreated=${!backupManifestExisted}",
                                )
                            } catch (rollbackError: Throwable) {
                                activationError.addSuppressed(rollbackError)
                                Log.e(
                                    LOG_TAG,
                                    "RTL_READER_NATIVE_EDITABLE_ACTIVATION_ROLLBACK_FAILED marker=${marker.absolutePath}",
                                    rollbackError,
                                )
                            }
                            throw activationError
                        }
                        promise.resolve(nativeAnnotationBackupMap(backup, "verified"))
                    } catch (error: Throwable) {
                        Log.e(
                            LOG_TAG,
                            "RTL_READER_NATIVE_EDITABLE_CONFIG_FAILED: ${error.message}",
                            error,
                        )
                        promise.reject(
                            "NATIVE_SPREAD_EDITABLE_CONFIG_FAILED",
                            error.message,
                            error,
                        )
                    }
                }
            }
        } catch (error: Throwable) {
            Log.e(LOG_TAG, "RTL_READER_NATIVE_EDITABLE_CONFIG_FAILED: ${error.message}", error)
            promise.reject("NATIVE_SPREAD_EDITABLE_CONFIG_FAILED", error.message, error)
        }
    }

    @ReactMethod
    fun restoreNativeAnnotationBackup(filePath: String, promise: Promise) {
        try {
            val pdfFile = requirePdf(filePath)
            val result = readNativeAnnotationBackup(pdfFile)
            val backup = result.backup
                ?: throw IllegalStateException(
                    "No verified annotation recovery snapshot is available: ${result.status}",
                )
            val marker = nativeSpreadMarker(pdfFile)
            if (marker.exists() && !marker.delete()) {
                throw IllegalStateException("Could not disable Native Spread before recovery")
            }
            annotationRecoveryPending.set(true)
            scheduleAnnotationRestore(pdfFile, backup) { error ->
                Handler(Looper.getMainLooper()).post {
                    if (error == null) {
                        promise.resolve(nativeAnnotationBackupMap(backup, "restored"))
                        // App.js normally consumes this flag immediately while
                        // closing. Avoid leaving a stale skip behind if the
                        // document restart has already dismissed PluginHost.
                        Handler(Looper.getMainLooper()).postDelayed(
                            { annotationRecoveryPending.compareAndSet(true, false) },
                            5000L,
                        )
                    } else {
                        annotationRecoveryPending.set(false)
                        val message = "Annotation restore failed: ${error.message ?: "unknown error"}"
                        Toast.makeText(
                            reactApplicationContext,
                            message,
                            Toast.LENGTH_LONG,
                        ).show()
                        promise.reject(
                            "NATIVE_SPREAD_BACKUP_RESTORE_FAILED",
                            error.message,
                            error,
                        )
                    }
                }
            }
            Log.i(
                LOG_TAG,
                "RTL_READER_NATIVE_BACKUP_RESTORE_PREPARED originalPresent=${backup.originalMarkPresent} backup=${backup.manifest.absolutePath}",
            )
        } catch (error: Throwable) {
            annotationRecoveryPending.set(false)
            Log.e(LOG_TAG, "RTL_READER_NATIVE_BACKUP_RESTORE_FAILED: ${error.message}", error)
            promise.reject("NATIVE_SPREAD_BACKUP_RESTORE_FAILED", error.message, error)
        }
    }

    private fun writeNativeSpreadReadOnlyMarker(
        marker: File,
        coverSeparate: Boolean,
        showDivider: Boolean,
        spreadSizing: String,
        handshake: NativeSpreadHandshake,
    ) {
        check(handshake.active) { "Native Spread live safety check was not active" }

        val properties = Properties().apply {
            setProperty("enabled", "true")
            setProperty("direction", "rtl")
            setProperty("coverSeparate", coverSeparate.toString())
            setProperty("showDivider", showDivider.toString())
            setProperty(
                "spreadSizing",
                if (spreadSizing == "native_fill") "native_fill" else "fit",
            )
            setProperty("editable", "false")
            setProperty("disposable", "false")
            setProperty("managedBy", "supernote-rtl-reader")
            setProperty("mode", "read-only-pilot")
        }
        val temporary = File(
            marker.parentFile,
            "${marker.name}.tmp-${android.os.Process.myPid()}",
        )
        try {
            FileOutputStream(temporary, false).use { output ->
                properties.store(output, "Supernote RTL native reader settings")
                output.flush()
                output.fd.sync()
            }
            Os.rename(temporary.absolutePath, marker.absolutePath)
        } finally {
            if (temporary.exists()) temporary.delete()
        }

        val verified = Properties()
        FileInputStream(marker).use { input -> verified.load(input) }
        if (!verified.getProperty("enabled", "false")
                .equals("true", ignoreCase = true) ||
            !verified.getProperty("direction", "")
                .equals("rtl", ignoreCase = true) ||
            !verified.getProperty("editable", "true")
                .equals("false", ignoreCase = true) ||
            verified.getProperty("showDivider", "true") !=
                showDivider.toString() ||
            verified.getProperty("spreadSizing", "fit") !=
                (if (spreadSizing == "native_fill") "native_fill" else "fit")
        ) {
            throw IllegalStateException("Native spread setting verification failed")
        }

        Log.i(
            LOG_TAG,
            "RTL_READER_NATIVE_SPREAD_CONFIG enabled=true editable=false cover=$coverSeparate hooksActive=true processId=${handshake.processId} marker=${marker.absolutePath}",
        )
    }

    private fun writeNativeSpreadEditableMarker(
        pdfFile: File,
        marker: File,
        coverSeparate: Boolean,
        showDivider: Boolean,
        spreadSizing: String,
        handshake: NativeSpreadHandshake,
        backup: NativeAnnotationBackup,
    ) {
        check(handshake.active) { "Native Spread live safety check was not active" }
        val manifestHash = sha256(backup.manifest)
        val properties = Properties().apply {
            setProperty("enabled", "true")
            setProperty("direction", "rtl")
            setProperty("coverSeparate", coverSeparate.toString())
            setProperty("showDivider", showDivider.toString())
            setProperty(
                "spreadSizing",
                if (spreadSizing == "native_fill") "native_fill" else "fit",
            )
            setProperty("editable", "true")
            setProperty("disposable", "false")
            setProperty("managedBy", "supernote-rtl-reader")
            setProperty("mode", "protected-editable-pilot")
            setProperty("documentPath", pdfFile.canonicalPath)
            setProperty("backupVerified", "true")
            setProperty("backupManifestPath", backup.manifest.canonicalPath)
            setProperty("backupManifestSha256", manifestHash)
        }
        writePropertiesAtomically(marker, properties, "Supernote RTL protected editable settings")

        val verified = Properties().apply {
            FileInputStream(marker).use { input -> load(input) }
        }
        if (!verified.getProperty("editable", "false").equals("true", true) ||
            verified.getProperty("mode", "") != "protected-editable-pilot" ||
            verified.getProperty("backupManifestSha256", "") != manifestHash ||
            verified.getProperty("showDivider", "true") !=
                showDivider.toString() ||
            verified.getProperty("spreadSizing", "fit") !=
                (if (spreadSizing == "native_fill") "native_fill" else "fit")
        ) {
            throw IllegalStateException("Protected editable marker verification failed")
        }
        Log.i(
            LOG_TAG,
            "RTL_READER_NATIVE_SPREAD_CONFIG enabled=true editable=true cover=$coverSeparate backupVerified=true marker=${marker.absolutePath}",
        )
    }

    private fun resolveNativeSpreadMode(
        promise: Promise,
        configured: Boolean,
        configuredEditable: Boolean,
        coverSeparate: Boolean,
        showDivider: Boolean,
        spreadSizing: String,
        marker: File,
        capability: NativeSpreadCapability,
        handshake: NativeSpreadHandshake,
        backupResult: NativeAnnotationBackupResult,
    ) {
        val runtimeCompatible = capability.compatible && handshake.active
        val result = Arguments.createMap().apply {
            putBoolean("configured", configured)
            putBoolean("configuredEditable", configuredEditable)
            putBoolean("enabled", configured && runtimeCompatible)
            putBoolean("editable", configuredEditable && runtimeCompatible)
            putBoolean("coverSeparate", coverSeparate)
            putBoolean("showDivider", showDivider)
            putString("spreadSizing", spreadSizing)
            putString("markerPath", marker.absolutePath)
            putBoolean("compatible", runtimeCompatible)
            putBoolean("hooksActive", handshake.active)
            putString("handshakeReason", handshake.reason)
            putDouble("handshakeProtocol", handshake.protocol.toDouble())
            putDouble("handshakeProcessId", handshake.processId.toDouble())
            putBoolean("moduleInstalled", capability.moduleVersionCode >= 0L)
            putDouble("moduleVersionCode", capability.moduleVersionCode.toDouble())
            putString("moduleVersionName", capability.moduleVersionName)
            putDouble(
                "documentVersionCode",
                capability.documentVersionCode.toDouble(),
            )
            putString("firmwareFingerprint", Build.FINGERPRINT)
            putBoolean("backupAvailable", backupResult.backup != null)
            putString("backupStatus", backupResult.status)
            putBoolean(
                "backupOriginalMarkPresent",
                backupResult.backup?.originalMarkPresent == true,
            )
            putDouble(
                "backupCreatedAt",
                (backupResult.backup?.createdAt ?: 0L).toDouble(),
            )
        }
        Log.i(
            LOG_TAG,
            "RTL_READER_NATIVE_SPREAD_HANDSHAKE active=${handshake.active} reason=${handshake.reason} protocol=${handshake.protocol} processId=${handshake.processId}",
        )
        promise.resolve(result)
    }

    private data class NativeSpreadCapability(
        val compatible: Boolean,
        val moduleVersionCode: Long,
        val moduleVersionName: String?,
        val documentVersionCode: Long,
    )

    private data class NativeSpreadHandshake(
        val active: Boolean,
        val reason: String,
        val protocol: Int = -1,
        val processId: Int = -1,
    )

    private data class NativeAnnotationBackup(
        val manifest: File,
        val snapshot: File,
        val mark: File,
        val originalMarkPresent: Boolean,
        val markLength: Long,
        val markSha256: String,
        val createdAt: Long,
    )

    private data class NativeAnnotationBackupResult(
        val backup: NativeAnnotationBackup?,
        val status: String,
    )

    @Suppress("DEPRECATION")
    private fun packageVersionCode(packageName: String): Pair<Long, String?> {
        val info = reactApplicationContext.packageManager.getPackageInfo(packageName, 0)
        val code = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
            info.longVersionCode
        } else {
            info.versionCode.toLong()
        }
        return code to info.versionName
    }

    private fun requestNativeSpreadHandshake(
        pdfFile: File,
        callback: (NativeSpreadHandshake) -> Unit,
    ) {
        if (reactApplicationContext.packageName != PLUGIN_HOST_PACKAGE) {
            callback(NativeSpreadHandshake(false, "unexpected_plugin_host"))
            return
        }

        val expectedPath = try {
            pdfFile.canonicalPath
        } catch (error: Throwable) {
            callback(NativeSpreadHandshake(false, "document_path_unavailable"))
            return
        }
        val nonce = UUID.randomUUID().toString()
        val completed = AtomicBoolean(false)
        val handler = Handler(Looper.getMainLooper())
        var receiver: BroadcastReceiver? = null
        var timeout: Runnable? = null

        val finish: (NativeSpreadHandshake) -> Unit = { result ->
            if (completed.compareAndSet(false, true)) {
                timeout?.let(handler::removeCallbacks)
                receiver?.let { registered ->
                    try {
                        reactApplicationContext.unregisterReceiver(registered)
                    } catch (_: Throwable) {
                        // The receiver may already have been removed during teardown.
                    }
                }
                callback(result)
            }
        }

        receiver = object : BroadcastReceiver() {
            override fun onReceive(context: Context?, intent: Intent?) {
                if (intent?.action != NATIVE_SPREAD_HANDSHAKE_RESPONSE ||
                    intent.getStringExtra(HANDSHAKE_EXTRA_NONCE) != nonce
                ) {
                    return
                }

                val protocol = intent.getIntExtra(HANDSHAKE_EXTRA_PROTOCOL, -1)
                val hooksReady = intent.getBooleanExtra(
                    HANDSHAKE_EXTRA_HOOKS_READY,
                    false,
                )
                val moduleVersionCode = intent.getLongExtra(
                    HANDSHAKE_EXTRA_MODULE_VERSION_CODE,
                    -1L,
                )
                val documentApkLength = intent.getLongExtra(
                    HANDSHAKE_EXTRA_DOCUMENT_APK_LENGTH,
                    -1L,
                )
                val processId = intent.getIntExtra(
                    HANDSHAKE_EXTRA_PROCESS_ID,
                    -1,
                )
                val reportedPath = intent.getStringExtra(
                    HANDSHAKE_EXTRA_DOCUMENT_PATH,
                )
                val canonicalReportedPath = try {
                    reportedPath?.let { File(it).canonicalPath }
                } catch (_: Throwable) {
                    null
                }

                val valid = hooksReady &&
                    protocol == NATIVE_SPREAD_HANDSHAKE_PROTOCOL &&
                    moduleVersionCode >= NATIVE_SPREAD_MIN_VERSION_CODE &&
                    documentApkLength == SUPPORTED_DOCUMENT_APK_LENGTH &&
                    processId > 0 &&
                    canonicalReportedPath == expectedPath
                finish(
                    NativeSpreadHandshake(
                        valid,
                        if (valid) "ok" else "invalid_response",
                        protocol,
                        processId,
                    ),
                )
            }
        }

        timeout = Runnable {
            finish(NativeSpreadHandshake(false, "timeout"))
        }

        try {
            reactApplicationContext.registerReceiver(
                receiver,
                IntentFilter(NATIVE_SPREAD_HANDSHAKE_RESPONSE),
            )
            handler.postDelayed(
                timeout,
                NATIVE_SPREAD_HANDSHAKE_TIMEOUT_MS,
            )
            reactApplicationContext.sendBroadcast(
                Intent(NATIVE_SPREAD_HANDSHAKE_REQUEST).apply {
                    setPackage(DOCUMENT_PACKAGE)
                    putExtra(HANDSHAKE_EXTRA_NONCE, nonce)
                    putExtra(HANDSHAKE_EXTRA_DOCUMENT_PATH, expectedPath)
                    putExtra(
                        HANDSHAKE_EXTRA_PROTOCOL,
                        NATIVE_SPREAD_HANDSHAKE_PROTOCOL,
                    )
                },
            )
            Log.i(
                LOG_TAG,
                "RTL_READER_NATIVE_SPREAD_HANDSHAKE_REQUEST path=$expectedPath",
            )
        } catch (error: Throwable) {
            Log.e(
                LOG_TAG,
                "RTL_READER_NATIVE_SPREAD_HANDSHAKE_REQUEST_FAILED: ${error.message}",
                error,
            )
            finish(NativeSpreadHandshake(false, "request_failed"))
        }
    }

    private fun nativeSpreadCapability(): NativeSpreadCapability {
        val module = try {
            packageVersionCode(NATIVE_SPREAD_PACKAGE)
        } catch (_: Throwable) {
            -1L to null
        }
        val document = try {
            packageVersionCode(DOCUMENT_PACKAGE).first
        } catch (_: Throwable) {
            -1L
        }
        val compatible = Build.FINGERPRINT == SUPPORTED_FINGERPRINT &&
            document == SUPPORTED_DOCUMENT_VERSION_CODE &&
            module.first >= NATIVE_SPREAD_MIN_VERSION_CODE
        return NativeSpreadCapability(
            compatible,
            module.first,
            module.second,
            document,
        )
    }

    private fun requirePdf(filePath: String): File {
        val file = File(filePath)
        if (!file.isFile || !file.name.endsWith(".pdf", ignoreCase = true)) {
            throw IllegalStateException("Current PDF is not accessible: $filePath")
        }
        return file
    }

    private fun nativeSpreadMarker(pdfFile: File): File {
        val parent = pdfFile.parentFile
            ?: throw IllegalStateException("Current PDF has no parent directory")
        return File(parent, ".${pdfFile.name}$NATIVE_SPREAD_MARKER_SUFFIX")
    }

    private fun nativeAnnotationMark(pdfFile: File): File =
        File("${pdfFile.absolutePath}.mark")

    private fun nativeAnnotationBackupManifest(pdfFile: File): File {
        val parent = pdfFile.parentFile
            ?: throw IllegalStateException("Current PDF has no parent directory")
        return File(parent, ".${pdfFile.name}$NATIVE_SPREAD_BACKUP_SUFFIX")
    }

    private fun nativeAnnotationBackupSnapshot(pdfFile: File): File {
        val parent = pdfFile.parentFile
            ?: throw IllegalStateException("Current PDF has no parent directory")
        return File(parent, ".${pdfFile.name}$NATIVE_SPREAD_BACKUP_MARK_SUFFIX")
    }

    private fun nativeAnnotationRetiringSnapshot(pdfFile: File): File =
        File("${nativeAnnotationBackupSnapshot(pdfFile).absolutePath}.retiring")

    private fun readPropertiesIfFile(file: File): Properties = Properties().apply {
        if (file.isFile) {
            FileInputStream(file).use { input -> load(input) }
        }
    }

    private fun startNativeBackupWorker(name: String, action: () -> Unit) {
        Thread(action, name).apply {
            isDaemon = true
            start()
        }
    }

    private fun retireNativeAnnotationBackup(
        pdfFile: File,
        markerProperties: Properties,
        backupResult: NativeAnnotationBackupResult,
    ) {
        val backup = backupResult.backup ?: return
        if (!protectedEditableMarkerValid(pdfFile, markerProperties, backup)) return

        // Removing or downgrading the editable marker ends that protected
        // session. Retire its recovery baseline so a later "Back up & enable"
        // starts from the current .mark instead of silently reusing stale bytes
        // from before an ordinary, unprotected annotation interval.
        removeNativeAnnotationBackupFiles(pdfFile, backup)
        Log.i(
            LOG_TAG,
            "RTL_READER_NATIVE_BACKUP_RETIRED createdAt=${backup.createdAt}",
        )
    }

    private fun removeNativeAnnotationBackupFiles(
        pdfFile: File,
        backup: NativeAnnotationBackup,
    ) {
        val retiring = nativeAnnotationRetiringSnapshot(pdfFile)
        if (retiring.exists()) {
            throw IllegalStateException("A prior annotation backup retirement is incomplete")
        }
        if (backup.originalMarkPresent) {
            Os.rename(backup.snapshot.absolutePath, retiring.absolutePath)
        }
        if (backup.manifest.exists() && !backup.manifest.delete()) {
            if (backup.originalMarkPresent && retiring.exists()) {
                Os.rename(retiring.absolutePath, backup.snapshot.absolutePath)
            }
            throw IllegalStateException("Could not retire the completed annotation backup manifest")
        }
        if (retiring.exists() && !retiring.delete()) {
            Log.w(
                LOG_TAG,
                "RTL_READER_NATIVE_BACKUP_RETIRE_CLEANUP_DEFERRED file=${retiring.absolutePath}",
            )
        }
    }

    private fun ensureNativeAnnotationBackup(pdfFile: File): NativeAnnotationBackup {
        val existing = readNativeAnnotationBackup(pdfFile)
        if (existing.backup != null) {
            val markerProperties = readPropertiesIfFile(nativeSpreadMarker(pdfFile))
            if (!protectedEditableMarkerValid(pdfFile, markerProperties, existing.backup)) {
                throw IllegalStateException(
                    "A verified annotation backup belongs to an inactive protected session; restore it before starting a new editable session",
                )
            }
            Log.i(
                LOG_TAG,
                "RTL_READER_NATIVE_BACKUP_REUSED manifest=${existing.backup.manifest.absolutePath}",
            )
            return existing.backup
        }

        val manifest = nativeAnnotationBackupManifest(pdfFile)
        val snapshot = nativeAnnotationBackupSnapshot(pdfFile)
        val retiring = nativeAnnotationRetiringSnapshot(pdfFile)
        if (manifest.exists() || snapshot.exists() || retiring.exists()) {
            throw IllegalStateException(
                "An unverified annotation backup already exists (${existing.status}); recovery files were not overwritten",
            )
        }

        val mark = nativeAnnotationMark(pdfFile)
        if (mark.exists() && !mark.isFile) {
            throw IllegalStateException("Supernote annotation path is not a regular file")
        }
        val originalPresent = mark.isFile
        try {
            val markLength: Long
            val markHash: String
            if (originalPresent) {
                markLength = mark.length()
                markHash = sha256(mark)
                copyFileAtomically(mark, snapshot)
                if (snapshot.length() != markLength || sha256(snapshot) != markHash) {
                    throw IllegalStateException("Annotation snapshot byte verification failed")
                }
            } else {
                markLength = 0L
                markHash = "ABSENT"
            }

            val createdAt = System.currentTimeMillis()
            val properties = Properties().apply {
                setProperty("version", NATIVE_SPREAD_BACKUP_VERSION.toString())
                setProperty("managedBy", "supernote-rtl-reader")
                setProperty("documentPath", pdfFile.canonicalPath)
                setProperty("documentLength", pdfFile.length().toString())
                setProperty("documentSha256", sha256(pdfFile))
                // Supernote updates the PDF mtime when DocumentActivity reopens.
                // Retain it for diagnostics, but bind recovery to the PDF bytes.
                setProperty("documentModified", pdfFile.lastModified().toString())
                setProperty("markPath", mark.canonicalPath)
                setProperty("originalMarkPresent", originalPresent.toString())
                setProperty("markLength", markLength.toString())
                setProperty("markSha256", markHash)
                setProperty("snapshotPath", snapshot.canonicalPath)
                setProperty("createdAt", createdAt.toString())
            }
            writePropertiesAtomically(
                manifest,
                properties,
                "Supernote RTL annotation recovery snapshot",
            )

            val verified = readNativeAnnotationBackup(pdfFile)
            return verified.backup
                ?: throw IllegalStateException(
                    "Annotation backup verification failed after creation: ${verified.status}",
                )
        } catch (error: Throwable) {
            var rollbackFailed = false
            if (manifest.exists() && !manifest.delete()) {
                rollbackFailed = true
                val cleanupError = IllegalStateException(
                    "Could not remove the failed annotation backup manifest",
                )
                error.addSuppressed(cleanupError)
                Log.e(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_CREATION_ROLLBACK_FAILED file=${manifest.absolutePath}",
                    cleanupError,
                )
            }
            if (!manifest.exists() && snapshot.exists() && !snapshot.delete()) {
                rollbackFailed = true
                val cleanupError = IllegalStateException(
                    "Could not remove the failed annotation backup snapshot",
                )
                error.addSuppressed(cleanupError)
                Log.e(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_CREATION_ROLLBACK_FAILED file=${snapshot.absolutePath}",
                    cleanupError,
                )
            }
            if (!rollbackFailed) {
                Log.w(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_CREATION_ROLLED_BACK manifest=${manifest.absolutePath} snapshot=${snapshot.absolutePath}",
                )
            }
            if (retiring.exists() && !retiring.delete()) {
                val cleanupError = IllegalStateException(
                    "Could not remove the failed annotation backup retirement file",
                )
                error.addSuppressed(cleanupError)
                Log.e(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_CREATION_ROLLBACK_FAILED file=${retiring.absolutePath}",
                    cleanupError,
                )
            }
            throw error
        }
    }

    private fun ensureStableNativeAnnotationBackupForActivation(
        pdfFile: File,
        backupManifestExisted: Boolean,
    ): NativeAnnotationBackup {
        if (backupManifestExisted) {
            // An already-active protected session intentionally diverges from
            // its recovery baseline as the user edits. Reuse is authorized by
            // ensureNativeAnnotationBackup's marker/manifest validation.
            return ensureNativeAnnotationBackup(pdfFile)
        }

        val maximumAttempts = 3
        repeat(maximumAttempts) { attempt ->
            val backup = ensureNativeAnnotationBackup(pdfFile)
            if (liveNativeAnnotationMatchesBackup(backup)) {
                Log.i(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_LIVE_MARK_VERIFIED attempt=${attempt + 1}",
                )
                return backup
            }

            Log.w(
                LOG_TAG,
                "RTL_READER_NATIVE_BACKUP_LIVE_MARK_CHANGED attempt=${attempt + 1}; retrying snapshot",
            )
            removeNativeAnnotationBackupFiles(pdfFile, backup)
            if (attempt + 1 < maximumAttempts) {
                Thread.sleep(100L)
            }
        }
        throw IllegalStateException(
            "Supernote annotations kept changing while protected editing was being enabled; no editable marker was written",
        )
    }

    private fun liveNativeAnnotationMatchesBackup(
        backup: NativeAnnotationBackup,
    ): Boolean {
        val mark = backup.mark
        return if (backup.originalMarkPresent) {
            mark.isFile &&
                mark.length() == backup.markLength &&
                sha256(mark) == backup.markSha256
        } else {
            !mark.exists()
        }
    }

    private fun readNativeAnnotationBackup(pdfFile: File): NativeAnnotationBackupResult {
        return try {
            val manifest = nativeAnnotationBackupManifest(pdfFile)
            val snapshot = nativeAnnotationBackupSnapshot(pdfFile)
            val retiring = nativeAnnotationRetiringSnapshot(pdfFile)
            if (manifest.isFile && !snapshot.exists() && retiring.isFile) {
                Os.rename(retiring.absolutePath, snapshot.absolutePath)
                Log.w(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_RETIREMENT_ROLLED_BACK file=${snapshot.absolutePath}",
                )
            } else if (!manifest.exists() && retiring.exists() && !retiring.delete()) {
                Log.w(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_RETIRE_CLEANUP_DEFERRED file=${retiring.absolutePath}",
                )
            }
            if (!manifest.isFile) {
                return NativeAnnotationBackupResult(null, "missing")
            }
            val properties = Properties()
            FileInputStream(manifest).use { input -> properties.load(input) }
            if (properties.getProperty("version") != NATIVE_SPREAD_BACKUP_VERSION.toString() ||
                properties.getProperty("managedBy") != "supernote-rtl-reader"
            ) {
                throw IllegalStateException("unsupported_manifest")
            }
            if (File(properties.getProperty("documentPath", "")).canonicalPath !=
                pdfFile.canonicalPath ||
                properties.getProperty("documentLength")?.toLongOrNull() != pdfFile.length() ||
                properties.getProperty("documentSha256", "") != sha256(pdfFile)
            ) {
                throw IllegalStateException("document_identity_changed")
            }

            val mark = nativeAnnotationMark(pdfFile)
            if (File(properties.getProperty("markPath", "")).canonicalPath != mark.canonicalPath) {
                throw IllegalStateException("mark_path_mismatch")
            }
            if (File(properties.getProperty("snapshotPath", "")).canonicalPath !=
                snapshot.canonicalPath
            ) {
                throw IllegalStateException("snapshot_path_mismatch")
            }
            val originalPresent = properties.getProperty("originalMarkPresent", "false")
                .equals("true", ignoreCase = true)
            val markLength = properties.getProperty("markLength")?.toLongOrNull()
                ?: throw IllegalStateException("mark_length_invalid")
            val markHash = properties.getProperty("markSha256", "")
            if (originalPresent) {
                if (!snapshot.isFile || snapshot.length() != markLength ||
                    sha256(snapshot) != markHash
                ) {
                    throw IllegalStateException("snapshot_bytes_invalid")
                }
            } else if (markLength != 0L || markHash != "ABSENT" || snapshot.exists()) {
                throw IllegalStateException("absent_snapshot_invalid")
            }
            val createdAt = properties.getProperty("createdAt")?.toLongOrNull()
                ?: throw IllegalStateException("created_at_invalid")
            NativeAnnotationBackupResult(
                NativeAnnotationBackup(
                    manifest,
                    snapshot,
                    mark,
                    originalPresent,
                    markLength,
                    markHash,
                    createdAt,
                ),
                "verified",
            )
        } catch (error: Throwable) {
            NativeAnnotationBackupResult(null, "invalid:${error.message}")
        }
    }

    private fun nativeAnnotationBackupMap(
        backup: NativeAnnotationBackup,
        status: String,
    ) = Arguments.createMap().apply {
        putBoolean("backupAvailable", true)
        putString("backupStatus", status)
        putString("backupManifestPath", backup.manifest.absolutePath)
        putBoolean("backupOriginalMarkPresent", backup.originalMarkPresent)
        putDouble("backupCreatedAt", backup.createdAt.toDouble())
    }

    private fun sameNativeAnnotationBackup(
        expected: NativeAnnotationBackup,
        actual: NativeAnnotationBackup,
    ): Boolean =
        expected.manifest.canonicalPath == actual.manifest.canonicalPath &&
            expected.snapshot.canonicalPath == actual.snapshot.canonicalPath &&
            expected.mark.canonicalPath == actual.mark.canonicalPath &&
            expected.originalMarkPresent == actual.originalMarkPresent &&
            expected.markLength == actual.markLength &&
            expected.markSha256 == actual.markSha256 &&
            expected.createdAt == actual.createdAt

    private fun protectedEditableMarkerValid(
        pdfFile: File,
        properties: Properties,
        backup: NativeAnnotationBackup?,
    ): Boolean {
        if (backup == null ||
            !properties.getProperty("editable", "false").equals("true", true) ||
            properties.getProperty("mode", "") != "protected-editable-pilot" ||
            properties.getProperty("managedBy", "") != "supernote-rtl-reader" ||
            !properties.getProperty("backupVerified", "false").equals("true", true) ||
            File(properties.getProperty("documentPath", "")).canonicalPath !=
                pdfFile.canonicalPath ||
            File(properties.getProperty("backupManifestPath", "")).canonicalPath !=
                backup.manifest.canonicalPath
        ) {
            return false
        }
        return properties.getProperty("backupManifestSha256", "") ==
            sha256(backup.manifest)
    }

    private fun writePropertiesAtomically(
        file: File,
        properties: Properties,
        comment: String,
    ) {
        val bytes = ByteArrayOutputStream().use { buffer ->
            properties.store(buffer, comment)
            buffer.toByteArray()
        }
        writeBytesAtomically(file, bytes)
    }

    private fun writeBytesAtomically(file: File, bytes: ByteArray) {
        val temporary = File(
            file.parentFile,
            "${file.name}.tmp-${android.os.Process.myPid()}-${UUID.randomUUID()}",
        )
        try {
            writeBytesSynced(temporary, bytes)
            Os.rename(temporary.absolutePath, file.absolutePath)
        } finally {
            if (temporary.exists()) temporary.delete()
        }
    }

    private fun copyFileAtomically(source: File, destination: File) {
        val temporary = File(
            destination.parentFile,
            "${destination.name}.tmp-${android.os.Process.myPid()}-${UUID.randomUUID()}",
        )
        try {
            FileInputStream(source).use { input ->
                FileOutputStream(temporary, false).use { output ->
                    input.copyTo(output, 64 * 1024)
                    output.flush()
                    output.fd.sync()
                }
            }
            Os.rename(temporary.absolutePath, destination.absolutePath)
        } finally {
            if (temporary.exists()) temporary.delete()
        }
    }

    private fun sha256(file: File): String {
        val digest = MessageDigest.getInstance("SHA-256")
        val buffer = ByteArray(64 * 1024)
        FileInputStream(file).use { input ->
            while (true) {
                val count = input.read(buffer)
                if (count < 0) break
                if (count > 0) digest.update(buffer, 0, count)
            }
        }
        return digest.digest().joinToString("") { byte ->
            "%02x".format(byte.toInt() and 0xff)
        }
    }

    /**
     * Experimental native-reader handoff.
     *
     * Hardware testing established that Supernote stores the native PDF position
     * in a Java-serialized HashMap and that PluginHost and SupernoteDocument both
     * run as UID 1000. The config update therefore needs no su access. v0.0.9
     * also avoids invoking the `am` shell utility: after PluginHost closes, a
     * background worker signals only the com.supernote.document PID and then
     * starts its private DocumentActivity directly through Android APIs.
     */
    @ReactMethod
    fun handoffLastSavedPage(promise: Promise) {
        if (annotationRecoveryPending.compareAndSet(true, false)) {
            Log.i(LOG_TAG, "RTL_READER_HANDOFF_SKIPPED reason=annotation_recovery")
            promise.resolve(Arguments.createMap().apply {
                putBoolean("annotationRecovery", true)
                putInt("uid", android.os.Process.myUid())
            })
            return
        }

        var configFile: File? = null
        var originalBytes: ByteArray? = null
        var wroteConfig = false

        try {
            val filePath = lastSavedFilePath
                ?: throw IllegalStateException("No PDF has been saved in this reader session")
            // Consume the session path immediately. A later activation must save
            // its own path before another handoff can occur.
            lastSavedFilePath = null

            val savedJson = preferences.getString(filePath, null)
                ?: throw IllegalStateException("No saved reader preferences for current PDF")
            val pageIndex = JSONObject(savedJson).optInt("lastPageIndex", -1)
            if (pageIndex < 0) {
                throw IllegalStateException("Saved reader state has no valid lastPageIndex")
            }

            val pdfFile = File(filePath)
            if (!pdfFile.isFile) {
                throw IllegalStateException("Current PDF is not accessible: $filePath")
            }

            val inode = Os.stat(pdfFile.absolutePath).st_ino.toString()
            configFile = findMatchingConfig(pdfFile, inode)
            originalBytes = configFile.readBytes()

            val configMap = readConfigMap(configFile)
            val oldPage = configMap["currentPage"] as? String
                ?: throw IllegalStateException("Native config currentPage is not a String")

            configMap["currentPage"] = pageIndex.toString()
            val updatedBytes = serializeConfigMap(configMap)
            writeBytesSynced(configFile, updatedBytes)
            wroteConfig = true

            val verifiedMap = readConfigMap(configFile)
            val verifiedPage = verifiedMap["currentPage"] as? String
            if (verifiedPage != pageIndex.toString()) {
                throw IllegalStateException(
                    "Native config verification failed: expected $pageIndex, found $verifiedPage",
                )
            }
            verifyConfigIdentity(verifiedMap, pdfFile, inode)

            Log.i(
                LOG_TAG,
                "RTL_READER_HANDOFF_CONFIG_WRITTEN page=${pageIndex + 1} uid=${android.os.Process.myUid()} config=${configFile.absolutePath}",
            )

            scheduleDocumentRestart()

            val result = Arguments.createMap().apply {
                putString("filePath", pdfFile.absolutePath)
                putString("configPath", configFile.absolutePath)
                putString("inode", inode)
                putInt("pageIndex", pageIndex)
                putString("oldPage", oldPage)
                putInt("uid", android.os.Process.myUid())
            }
            promise.resolve(result)
        } catch (error: Throwable) {
            if (wroteConfig && configFile != null && originalBytes != null) {
                try {
                    writeBytesSynced(configFile, originalBytes)
                    Log.w(LOG_TAG, "RTL_READER_HANDOFF_CONFIG_RESTORED_AFTER_FAILURE")
                } catch (restoreError: Throwable) {
                    Log.e(
                        LOG_TAG,
                        "RTL_READER_HANDOFF_RESTORE_FAILED: ${restoreError.message}",
                        restoreError,
                    )
                }
            }
            Log.e(LOG_TAG, "RTL_READER_HANDOFF_FAILED: ${error.message}", error)
            promise.reject("READER_HANDOFF_FAILED", error.message, error)
        }
    }

    private fun findMatchingConfig(pdfFile: File, inode: String): File {
        var sawReadableRoot = false
        var sawCandidate = false

        for (rootPath in DOCUMENT_CACHE_ROOTS) {
            val root = File(rootPath)
            val children = root.listFiles()
            if (children == null) {
                continue
            }
            sawReadableRoot = true

            for (directory in children) {
                if (!directory.isDirectory || !directory.name.startsWith("${inode}_")) {
                    continue
                }
                val candidate = File(directory, "CONFIG/config.data")
                if (!candidate.isFile) {
                    continue
                }
                sawCandidate = true

                try {
                    val map = readConfigMap(candidate)
                    verifyConfigIdentity(map, pdfFile, inode)
                    return candidate
                } catch (_: Throwable) {
                    // A matching inode prefix is not enough; keep looking until
                    // both the serialized inode and URI identify this exact PDF.
                }
            }
        }

        if (!sawReadableRoot) {
            throw IllegalStateException(
                "PluginHost cannot read Supernote document cache as UID ${android.os.Process.myUid()}",
            )
        }
        if (sawCandidate) {
            throw IllegalStateException("Found inode candidate, but its URI did not match current PDF")
        }
        throw IllegalStateException("No native config found for PDF inode $inode")
    }

    private fun verifyConfigIdentity(
        map: MutableMap<Any?, Any?>,
        pdfFile: File,
        inode: String,
    ) {
        val storedInode = map["file_inode"] as? String
            ?: throw IllegalStateException("Native config file_inode is missing")
        if (storedInode != inode) {
            throw IllegalStateException(
                "Native config inode mismatch: expected $inode, found $storedInode",
            )
        }

        val storedUri = map["uri"] as? String
            ?: throw IllegalStateException("Native config URI is missing")
        val storedPath = Uri.parse(storedUri).path
            ?: throw IllegalStateException("Native config URI has no file path")

        val expectedPath = pdfFile.canonicalPath
        val actualPath = File(storedPath).canonicalPath
        if (expectedPath != actualPath) {
            throw IllegalStateException(
                "Native config URI mismatch: expected $expectedPath, found $actualPath",
            )
        }
    }

    @Suppress("UNCHECKED_CAST")
    private fun readConfigMap(file: File): MutableMap<Any?, Any?> {
        FileInputStream(file).use { stream ->
            ObjectInputStream(stream).use { input ->
                val value = input.readObject()
                if (value !is MutableMap<*, *>) {
                    throw IllegalStateException(
                        "Native config is ${value.javaClass.name}, expected MutableMap",
                    )
                }
                return value as MutableMap<Any?, Any?>
            }
        }
    }

    private fun serializeConfigMap(map: MutableMap<Any?, Any?>): ByteArray {
        val buffer = ByteArrayOutputStream()
        ObjectOutputStream(buffer).use { output ->
            output.writeObject(map)
            output.flush()
        }
        return buffer.toByteArray()
    }

    private fun writeBytesSynced(file: File, bytes: ByteArray) {
        FileOutputStream(file, false).use { output ->
            output.write(bytes)
            output.flush()
            output.fd.sync()
        }
    }

    private fun documentPids(activityManager: ActivityManager): List<Int> =
        activityManager.runningAppProcesses
            ?.asSequence()
            ?.filter { process -> process.processName == DOCUMENT_PACKAGE }
            ?.map { process -> process.pid }
            ?.filter { pid -> pid != android.os.Process.myPid() }
            ?.toList()
            ?: emptyList()

    private fun scheduleDocumentRestart() {
        Thread {
            try {
                Log.i(
                    LOG_TAG,
                    "RTL_READER_HANDOFF_WORKER_START uid=${android.os.Process.myUid()} pluginPid=${android.os.Process.myPid()}",
                )

                // Give closePluginView() time to return the native reader to the
                // foreground before replacing its process.
                SystemClock.sleep(900)

                val activityManager = reactApplicationContext.getSystemService(
                    Context.ACTIVITY_SERVICE,
                ) as ActivityManager
                val pids = documentPids(activityManager)
                Log.i(LOG_TAG, "RTL_READER_HANDOFF_DOCUMENT_PIDS ${pids.joinToString(",")}")

                for (pid in pids) {
                    try {
                        Os.kill(pid, OsConstants.SIGKILL)
                        Log.i(LOG_TAG, "RTL_READER_HANDOFF_KILL_SENT pid=$pid")
                    } catch (error: Throwable) {
                        Log.e(
                            LOG_TAG,
                            "RTL_READER_HANDOFF_KILL_FAILED pid=$pid: ${error.message}",
                            error,
                        )
                        throw error
                    }
                }

                if (pids.isNotEmpty()) {
                    val deadline = SystemClock.elapsedRealtime() + 2500L
                    var remaining = pids
                    while (remaining.isNotEmpty() && SystemClock.elapsedRealtime() < deadline) {
                        SystemClock.sleep(100)
                        val running = documentPids(activityManager).toSet()
                        remaining = pids.filter { pid -> pid in running }
                    }
                    if (remaining.isEmpty()) {
                        Log.i(LOG_TAG, "RTL_READER_HANDOFF_KILL_CONFIRMED")
                    } else {
                        Log.w(
                            LOG_TAG,
                            "RTL_READER_HANDOFF_KILL_NOT_CONFIRMED pids=${remaining.joinToString(",")}",
                        )
                    }
                } else {
                    Log.w(LOG_TAG, "RTL_READER_HANDOFF_NO_DOCUMENT_PID")
                }

                SystemClock.sleep(450)

                val intent = Intent().apply {
                    setClassName(DOCUMENT_PACKAGE, DOCUMENT_ACTIVITY)
                    addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TASK)
                }
                reactApplicationContext.startActivity(intent)
                Log.i(LOG_TAG, "RTL_READER_HANDOFF_START_REQUESTED_DIRECT")
            } catch (error: Throwable) {
                Log.e(
                    LOG_TAG,
                    "RTL_READER_HANDOFF_WORKER_FAILED: ${error.message}",
                    error,
                )
            }
        }.apply {
            name = "RtlReaderNativeHandoff"
            isDaemon = true
            start()
        }
    }

    private fun scheduleAnnotationRestore(
        pdfFile: File,
        backup: NativeAnnotationBackup,
        completion: (Throwable?) -> Unit,
    ) {
        Thread {
            try {
                // The promise remains pending while this worker runs. Kill the
                // native reader before touching its working .mark so an
                // in-memory annotation model cannot overwrite the recovery
                // snapshot while DocumentActivity is resuming.
                SystemClock.sleep(350)
                val activityManager = reactApplicationContext.getSystemService(
                    Context.ACTIVITY_SERVICE,
                ) as ActivityManager
                val deadline = SystemClock.elapsedRealtime() + 2500L
                val signaled = mutableSetOf<Int>()
                var running = documentPids(activityManager)
                val initialPids = running.toSet()
                while (running.isNotEmpty() && SystemClock.elapsedRealtime() < deadline) {
                    for (pid in running) {
                        if (signaled.add(pid)) {
                            Os.kill(pid, OsConstants.SIGKILL)
                            Log.i(
                                LOG_TAG,
                                "RTL_READER_NATIVE_BACKUP_RESTORE_KILL_SENT pid=$pid replacement=${pid !in initialPids}",
                            )
                        }
                    }
                    SystemClock.sleep(100)
                    running = documentPids(activityManager)
                }
                val remaining = documentPids(activityManager)
                if (remaining.isNotEmpty()) {
                    Log.e(
                        LOG_TAG,
                        "RTL_READER_NATIVE_BACKUP_RESTORE_ABORTED_ACTIVE_PROCESS pids=${remaining.joinToString(",")}",
                    )
                    throw IllegalStateException(
                        "Native document process remained active; annotation recovery was not written",
                    )
                }

                val revalidatedBackup = readNativeAnnotationBackup(pdfFile).backup
                    ?: throw IllegalStateException(
                        "Document or recovery snapshot changed while preparing restore",
                    )
                if (!sameNativeAnnotationBackup(backup, revalidatedBackup)) {
                    throw IllegalStateException(
                        "Recovery snapshot identity changed while preparing restore",
                    )
                }

                val currentMark = nativeAnnotationMark(pdfFile)
                if (revalidatedBackup.originalMarkPresent) {
                    if (revalidatedBackup.snapshot.length() != revalidatedBackup.markLength ||
                        sha256(revalidatedBackup.snapshot) != revalidatedBackup.markSha256) {
                        throw IllegalStateException("Recovery snapshot changed before restore")
                    }
                    copyFileAtomically(revalidatedBackup.snapshot, currentMark)
                    if (currentMark.length() != revalidatedBackup.markLength ||
                        sha256(currentMark) != revalidatedBackup.markSha256
                    ) {
                        throw IllegalStateException("Restored annotation file verification failed")
                    }
                } else if (currentMark.exists() && !currentMark.delete()) {
                    throw IllegalStateException("Could not restore the original no-annotation state")
                }

                Log.i(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_RESTORED originalPresent=${revalidatedBackup.originalMarkPresent} mark=${currentMark.absolutePath}",
                )
                removeNativeAnnotationBackupFiles(pdfFile, revalidatedBackup)
                SystemClock.sleep(250)
                reactApplicationContext.startActivity(Intent().apply {
                    setClassName(DOCUMENT_PACKAGE, DOCUMENT_ACTIVITY)
                    addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TASK)
                })
                Log.i(LOG_TAG, "RTL_READER_NATIVE_BACKUP_RESTORE_REOPENED")
                completion(null)
            } catch (error: Throwable) {
                Log.e(
                    LOG_TAG,
                    "RTL_READER_NATIVE_BACKUP_RESTORE_WORKER_FAILED: ${error.message}",
                    error,
                )
                try {
                    reactApplicationContext.startActivity(Intent().apply {
                        setClassName(DOCUMENT_PACKAGE, DOCUMENT_ACTIVITY)
                        addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TASK)
                    })
                    Log.i(LOG_TAG, "RTL_READER_NATIVE_BACKUP_RESTORE_FAILURE_REOPENED")
                } catch (restartError: Throwable) {
                    Log.e(
                        LOG_TAG,
                        "RTL_READER_NATIVE_BACKUP_RESTORE_FAILURE_REOPEN_FAILED: ${restartError.message}",
                        restartError,
                    )
                }
                completion(error)
            }
        }.apply {
            name = "RtlReaderAnnotationRecovery"
            isDaemon = true
            start()
        }
    }
}
