package __PACKAGE__

import android.graphics.Bitmap
import android.os.Handler
import android.os.Looper
import android.system.Os
import android.system.OsConstants
import java.io.File
import java.util.UUID
import kotlin.math.abs

/**
 * Process-local opaque image ownership, not a file/image loader or save witness.
 * Only the explicit T004 PAGE3 / T008 PAGE1 and PAGE2 profiles can publish full-canvas ink.
 * Native text highlights were absent from that API output and are not claimed.
 */
internal object SavedInkRegistry {
    internal data class SourceStamp(
        val canonicalPath: String, val length: Long, val modified: Long,
        val device: Long, val inode: Long, val mtime: Long, val ctime: Long,
    )

    private class Entry(
        val token: String, val bitmap: Bitmap, val source: SourceStamp,
        val annotation: SourceStamp?, val pageIndex: Int, val geometryId: String,
    ) {
        var owner = true
        val leases = HashSet<Lease>()
    }

    private val lock = Any()
    private val mainHandler = Handler(Looper.getMainLooper())
    private val entries = HashMap<String, Entry>() // At most two T008 pages, including revoked view leases.

    internal class Lease internal constructor(private val token: String, val bitmap: Bitmap) {
        private var released = false

        fun matchesPage(path: String?, pageIndex: Int): Boolean = synchronized(lock) {
            val entry = entries[token] ?: return@synchronized false
            if (released || !entry.owner || path.isNullOrBlank() || entry.pageIndex != pageIndex) return@synchronized false
            try { File(path).canonicalPath == entry.source.canonicalPath } catch (_: Exception) { false }
        }

        fun matches(path: String, length: Long, modified: Long, pageIndex: Int, bitmapWidth: Int, bitmapHeight: Int,
            geometryId: String? = null): Boolean =
            synchronized(lock) {
                if (released) return@synchronized false
                val entry = entries[token] ?: return@synchronized false
                val source = entry.source
                if (!entry.owner || bitmap.isRecycled || entry.pageIndex != pageIndex ||
                    path != source.canonicalPath || length != source.length || modified != source.modified ||
                    bitmapWidth <= 0 || bitmapHeight <= 0) {
                    return@synchronized false
                }
                val geometryMatches = when (entry.geometryId) {
                    // Preserve the established T004 bare-PDF rounding tolerance
                    // only for that profile, never as T008 background authority.
                    SavedInkProfiles.T004_ID -> (geometryId == null || geometryId == SavedInkProfiles.T004_ID) &&
                        abs(bitmapWidth.toLong() * 1872L - bitmapHeight.toLong() * 1404L) <= 1404L
                    SavedInkProfiles.T008_ID, SavedInkProfiles.T008_PAGE2_ID -> geometryId == entry.geometryId &&
                        bitmapWidth == 1404 && bitmapHeight == 1872
                    else -> false
                }
                if (!geometryMatches) return@synchronized false
                try {
                    liveMatches(source) && entry.annotation?.let(::liveMatches) == true
                } catch (_: Exception) { false }
            }

        fun release() = synchronized(lock) {
            check(Looper.myLooper() == Looper.getMainLooper()) { "Ink view lease release requires Android main thread" }
            if (!released) {
                released = true
                entries[token]?.let { entry ->
                    entry.leases.remove(this)
                    reap(entry)
                }
            }
        }
    }

    fun isEmpty(): Boolean = synchronized(lock) { entries.isEmpty() }

    fun ownsExactly(tokens: Set<String>): Boolean = synchronized(lock) {
        entries.keys == tokens && entries.values.all { it.owner && !it.bitmap.isRecycled }
    }

    /** Ownership of bitmap transfers only after success; caller recycles on rejection. */
    fun publish(token: String, bitmap: Bitmap, source: SourceStamp, annotation: SourceStamp?, pageIndex: Int,
        geometryId: String): String = synchronized(lock) {
        require(UUID.fromString(token).toString() == token) { "Expected native-issued UUID ink token" }
        val profile = SavedInkProfiles.profileById(geometryId) ?: error("Unknown native ink geometry")
        require(source.canonicalPath == File(profile.filePath).canonicalPath && pageIndex == profile.pageIndex &&
            !bitmap.isRecycled && !bitmap.isMutable && bitmap.width == profile.width && bitmap.height == profile.height) {
            "Invalid immutable native-profile ink bitmap"
        }
        require(annotation != null && annotation.canonicalPath == "${source.canonicalPath}.mark") {
            "A decoded ink bitmap requires its unchanged native mark sidecar"
        }
        require(!entries.containsKey(token)) { "Duplicate ink token" }
        if (entries.isNotEmpty()) {
            require(entries.size == 1 && profile.filePath == SavedInkProfiles.T008_PATH &&
                entries.values.all { entry -> entry.owner && !entry.bitmap.isRecycled &&
                    entry.source == source && entry.annotation == annotation && entry.pageIndex != pageIndex &&
                    entry.geometryId in setOf(SavedInkProfiles.T008_ID, SavedInkProfiles.T008_PAGE2_ID) }) {
                "Only distinct same-snapshot T008 siblings may coexist"
            }
        }
        entries[token] = Entry(token, bitmap, source, annotation, pageIndex, profile.id)
        token
    }

    fun acquire(token: String?): Lease? = synchronized(lock) {
        check(Looper.myLooper() == Looper.getMainLooper()) { "Ink view lease acquisition requires Android main thread" }
        val entry = entries[token] ?: return@synchronized null
        if (!entry.owner || entry.bitmap.isRecycled) return@synchronized null
        Lease(entry.token, entry.bitmap).also { entry.leases.add(it) }
    }

    fun revoke(token: String?) = synchronized(lock) {
        entries[token]?.let { entry ->
            entry.owner = false
            reap(entry)
        }
    }

    /**
     * Completion means this revoked token has no remaining owner or view leases.
     * Android draws and view-lease release run on the same main Looper: enqueueing
     * the drain after revocation cannot recycle a bitmap during an in-flight
     * onDraw. Released leases retained by a view fail matchesPage/matches and
     * therefore cannot draw a recycled bitmap. No timing delay/poll/retry.
     */
    fun drainRevoked(token: String?, complete: (Boolean) -> Unit) {
        val accepted = mainHandler.post {
            val revokedLeases = synchronized(lock) {
                val entry = entries[token]
                if (entry?.owner == true) null else entry?.leases?.toList() ?: emptyList()
            }
            if (revokedLeases == null) {
                complete(false) // Never force-release a still-owned entry.
                return@post
            }
            revokedLeases.forEach { it.release() }
            complete(synchronized(lock) { !entries.containsKey(token) })
        }
        if (!accepted) complete(false) // Reject rather than claim an unobserved UI drain.
    }

    private fun reap(entry: Entry) {
        if (!entry.owner && entry.leases.isEmpty()) {
            entries.remove(entry.token)
            if (!entry.bitmap.isRecycled) entry.bitmap.recycle()
        }
    }

    // Cheap per-draw invalidation complements (does not replace) the worker's
    // before/after SHA checks. This is not an atomic or durable-save witness.
    private fun liveMatches(source: SourceStamp): Boolean {
        val file = File(source.canonicalPath)
        val live = Os.lstat(source.canonicalPath)
        return OsConstants.S_ISREG(live.st_mode) && file.canonicalPath == source.canonicalPath &&
            live.st_dev == source.device && live.st_ino == source.inode && live.st_size == source.length &&
            live.st_mtime == source.mtime && live.st_ctime == source.ctime && file.lastModified() == source.modified
    }
}
